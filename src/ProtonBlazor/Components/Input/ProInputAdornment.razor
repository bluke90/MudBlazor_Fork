@namespace ProtonBlazor.Internal
@using ProtonBlazor.Extensions

<div class="@Classname">
    @if (!string.IsNullOrWhiteSpace(Text))
    {
        <ProText Class="pro-input-adornment-text"
                 Color="@Color"
                 tabindex="-1">
            @Text
        </ProText>
    }
    else if (!string.IsNullOrWhiteSpace(Icon))
    {
        @if (AdornmentClick.HasDelegate)
        {
            <ProIconButton Class="pro-input-adornment-icon-button pro-no-activator"
                           Icon="@Icon"
                           OnClick="@AdornmentClick"
                           Edge="@(Placement.ToEdge())"
                           Size="@Size"
                           Color="@Color"
                           aria-label="@AriaLabel"
                           tabindex="-1"
                           @onmousedown:stopPropagation />
        }
        else
        {
            <ProIcon Class="pro-input-adornment-icon"
                     Icon="@Icon"
                     Size="@Size"
                     Color="@Color"
                     aria-label="@AriaLabel"
                     tabindex="-1" />
        }
    }
</div>
