@namespace ProtonBlazor
@inherits ProBooleanInput<T>
@typeparam T

<ProInputControl Class="@Classname" Style="@Style" Error="@HasErrors" ErrorId="@ErrorIdState.Value" ErrorText="@GetErrorText()" Required="@Required">
    <InputContent>
        <label class="@LabelClassname" style="@Style" @onkeydown="HandleKeyDownAsync" id="@ElementId">
            <span class="@SpanClassname">
                <span class="@SwitchClassname">
                    <span class="pro-switch-button">
                        <input aria-labelledby="@(string.IsNullOrWhiteSpace(AriaLabel) ? null : _ariaId)" @attributes="GetInputAttributes()" aria-readonly="@(GetReadOnlyState().ToString().ToLower())" role="switch" aria-checked="@AriaCheckedState" type="checkbox" class="pro-switch-input" checked="@BoolValue" @onchange="@OnChange" disabled="@GetDisabledState()" @onclick:preventDefault="@GetReadOnlyState()" required="@Required" />
                        <span class="@ThumbClassname">
                            @if (!string.IsNullOrEmpty(ThumbIcon))
                            {
                                <ProIcon Color="@ThumbIconColor" Icon="@ThumbIcon" Style="padding: 2px; height:inherit; width: inherit;" />
                            }
                        </span>
                    </span>
                </span>
                <span class="@TrackClassname"></span>
            </span>
            @if (!string.IsNullOrEmpty(Label))
            {
                <ProText HtmlTag="span" Class="@LabelClassname" aria-hidden="@(AriaLabel is not null)" Color="HasErrors ? Color.Error : Color.Inherit">
                    @Label
                </ProText>
            }
            @if (ChildContent != null)
            {
                <ProText HtmlTag="span" Class="@LabelClassname" aria-hidden="@(AriaLabel is not null)" Color="HasErrors ? Color.Error : Color.Inherit">
                    @ChildContent
                </ProText>
            }
            @if (AriaLabel is not null)
            {
                <span id="@_ariaId" class="pro-sr-only">
                    @AriaLabel
                </span>
            }
        </label>
    </InputContent>
</ProInputControl>
