@namespace ProtonBlazor
@using Microsoft.AspNetCore.Components.Routing
@using ProtonBlazor.Resources
@inherits ProComponentBase
@inject InternalMudLocalizer Localizer

<div class="@GetPanelClass()" @attributes="UserAttributes">
    @if (_sections.Count > 1)
    {
        <ProNavMenu Class="pl-4" aria-label="@Localizer[LanguageResource.ProPageContentNavigation_NavMenu]">
            <ProText Typo="Typo.subtitle1" Class="title" GutterBottom="true">
                @Headline
            </ProText>

            @foreach (var docSection in _sections.OrderBy(x => x.LevelSortingValue))
            {
                <ProNavLink @key="docSection.Id" Match="NavLinkMatch.All" Class="@GetNavLinkClass(docSection)" @onclick="@(e => OnNavLinkClick(docSection.Id))">
                    @docSection.Title
                </ProNavLink>
            }
        </ProNavMenu>
    }
</div>