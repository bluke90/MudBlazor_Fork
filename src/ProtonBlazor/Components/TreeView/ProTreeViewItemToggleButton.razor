@using ProtonBlazor.Resources
@namespace ProtonBlazor
@inherits ProComponentBase
@inject InternalMudLocalizer Localizer

<div @attributes="UserAttributes" class="pro-treeview-item-arrow" @ondblclick="OnDoubleClick" @ondblclick:stopPropagation="true">
    @if (Visible)
    {
        <ProIconButton Disabled="@Disabled"
                       OnClick="@ToggleAsync"
                       Icon="@(Loading ? LoadingIcon : ExpandedIcon)"
                       Color="@(Loading ? LoadingIconColor : ExpandedIconColor)"
                       Class="@Classname"
                       Style="@Style"
                       aria-label="@(Expanded ? @Localizer[LanguageResource.ProTreeView_CollapseItem] : @Localizer[LanguageResource.ProTreeView_ExpandItem])" />
    }
</div>

