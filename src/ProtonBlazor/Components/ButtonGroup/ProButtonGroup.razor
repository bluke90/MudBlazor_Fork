@namespace ProtonBlazor
@inherits ProComponentBase

<ProElement HtmlTag="div" Class="@Classname" Style="@Style" Tag="@Tag" UserAttributes="@UserAttributes">
    <CascadingValue IsFixed="true" Value="this">
        @ChildContent
    </CascadingValue>
</ProElement>

@{
    UserAttributes.TryAdd("role", "group");
}
