@namespace ProtonBlazor
@inherits ProPicker<TimeSpan?>
@inject InternalMudLocalizer Localizer

@Render

@code {
    protected override RenderFragment PickerContent => 
    @<CascadingValue Value="@this" IsFixed="true">
        <ProPickerToolbar Class="@ToolbarClassname" Style="@Style" ShowToolbar="@ShowToolbar" Orientation="@Orientation" PickerVariant="@PickerVariant" Color="@Color">
            <div class="pro-timepicker-hourminute pro-ltr">
                @if (TimeEditMode == TimeEditMode.Normal)
                {
                    <ProButton Variant="@Variant.Text" Color="@Color.Inherit" Class="@HoursButtonClassname" OnClick="@OnHourClickAsync">@GetHourString()</ProButton>
                    <ProText Typo="@Typo.h2" Class="pro-timepicker-separator">:</ProText>
                    <ProButton Variant="@Variant.Text" Color="@Color.Inherit" Class="@MinuteButtonClassname" OnClick="@OnMinutesClick">@GetMinuteString()</ProButton>
                }
                else
                {
                    <ProText Typo="Typo.h2" Class="pro-timepicker-separator">@GetHourString():@GetMinuteString()</ProText>
                }
            </div>
            @if (AmPm)
            {
                <div class="pro-timepicker-ampm">
                    <ProButton Variant="@Variant.Text" Color="@Color.Inherit" Class="@AmButtonClassname" OnClick="OnAmClickedAsync">AM</ProButton>
                    <ProButton Variant="@Variant.Text" Color="@Color.Inherit" Class="@PmButtonClassname" OnClick="OnPmClickedAsync">PM</ProButton>
                </div>
            }
        </ProPickerToolbar>
        <ProPickerContent>
            <div class="pro-picker-time-container">
                <div class="pro-picker-time-clock">
                    <div tabindex="-1" class="pro-picker-time-clock-mask" @ref="ClockElementReference" @oncontextmenu:preventDefault>
                        <div class="@GetClockPinColor()"></div>
                        <div class="@GetClockPointerColor()" style="height: @GetPointerHeight(); transform: @GetPointerRotation()">
                            <div class="@GetClockPointerThumbColor()"></div>
                        </div>
                        <div class="@HourDialClassname">
                            @if (AmPm)
                            {
                                @*Hours from 1 to 12*@
                                for (int i = 1; i <= 12; ++i)
                                {
                                    var _i = i;
                                    var angle = (6 - _i) * 30;
                                    <ProText Class="@GetNumberColor(_i)" Style="@GetTransform(angle, 109, 0, 5)">@_i</ProText>
                                }
                                for (int i = 1; i <= 12; ++i)
                                {
                                    var _i = i;
                                    <div class="pro-picker-stick pro-hour" style="@($"transform: rotateZ({_i * 30}deg);")" data-stick-value="@_i"></div>
                                }
                            }
                            else
                            {
                                @*Hours from 13 to 24 (00)*@
                                for (int i = 1; i <= 12; ++i)
                                {
                                    var _i = i;
                                    var angle = (6 - _i) * 30;
                                    <ProText Class="@GetNumberColor((_i + 12) % 24)" Style="@GetTransform(angle, 109, 0, 5)">@(((_i + 12) % 24).ToString("D2"))</ProText>
                                }
                                @*Hours from 1 to 12*@
                                for (int i = 1; i <= 12; ++i)
                                {
                                    var _i = i;
                                    var angle = (6 - _i) * 30;
                                    <ProText Class="@GetNumberColor(_i)" Typo="Typo.body2" Style="@GetTransform(angle, 74, 0, 40)">@(_i.ToString("D2"))</ProText>
                                }
                                for (int i = 1; i <= 12; ++i)
                                {
                                    var _i = i;
                                    <div class="pro-picker-stick" style="@($"transform: rotateZ({_i * 30}deg);")">
                                        <div class="pro-picker-stick-inner pro-hour" data-stick-value="@_i"></div>
                                        <div class="pro-picker-stick-outer pro-hour" data-stick-value="@((_i + 12) % 24)"></div>
                                    </div>
                                }
                            }
                        </div>
                        <div class="@MinuteDialClassname">   
                            @*Minutes from 05 to 60 (00) - step 5*@                     
                            @for (int i = 0; i < 12; ++i)
                            {
                                var _i = i;
                                var angle = (6 - _i) * 30;
                                <ProText Class="@GetNumberColor(_i * 5)" Style="@GetTransform(angle, 109, 0, 5)">@((_i * 5).ToString("D2"))</ProText>
                            }
                            @for (int i = 0; i < 60; ++i)
                            {
                                var _i = i;
                                <div class="pro-picker-stick pro-minute" style="@($"transform: rotateZ({_i * 6}deg);")" data-stick-value="@_i"></div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </ProPickerContent>
    </CascadingValue>;
}
