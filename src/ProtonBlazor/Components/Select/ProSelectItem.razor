@namespace ProtonBlazor
@typeparam T
@inherits ProComponentBase

@if (!HideContent)
{
    <ProListItem @attributes="GetUserAttributes()" Value="@ItemId" id="@ItemId" OnClick="this.AsNonRenderingEventHandler(OnClickHandleAsync)" OnClickPreventDefault="true" Icon="@CheckBoxIcon" Disabled="@Disabled" Class="@GetCssClasses()" Style="@Style">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else
        {
            @DisplayString
        }
    </ProListItem>
}
