@namespace ProtonBlazor
@using Microsoft.AspNetCore.Components.Rendering
@using Microsoft.AspNetCore.Components.CompilerServices
@using ProtonBlazor.Resources
@inject InternalMudLocalizer Localizer
@inherits ProTabs

@Render

@{
#pragma warning disable CS0618 // Type or member is obsolete
}

@code {
    /// <inheritdoc />
    protected override void OnInitialized()
    {
        Header = ProTabsHeader;
        TabPanelHeader = ProTabPanelPanelHeader;
    }

    /// <summary>
    /// Renders the component to the supplied <see cref="BuildRenderTree"/>.
    /// </summary>
    public RenderFragment Render => base.BuildRenderTree;

    private RenderFragment<ProTabPanel> ProTabPanelPanelHeader => context =>
        @<ProRender>
            @if (context.ShowCloseIcon)
            {
                if (!string.IsNullOrEmpty(CloseIconToolTip))
                {
                    <ProTooltip Text="@CloseIconToolTip">
                        <ProIconButton Icon="@CloseTabIcon"
                                       Class="@CloseIconClass"
                                       Style="@CloseIconStyle"
                                       OnClick="() => CloseTab.InvokeAsync(context)"
                                       @onkeydown="@(e => HandleTabKeyDownAsync(e, context))"
                                       aria-label="@Localizer[LanguageResource.ProTabs_CloseTab]"/>
                    </ProTooltip>
                }
                else
                {
                    <ProIconButton Icon="@CloseTabIcon"
                                   Class="@CloseIconClass"
                                   Style="@CloseIconStyle"
                                   OnClick="() => CloseTab.InvokeAsync(context)"
                                   @onkeydown="@(e => HandleTabKeyDownAsync(e, context))"
                                   aria-label="@Localizer[LanguageResource.ProTabs_CloseTab]" />
                }
            }
        </ProRender>;

    private RenderFragment<ProTabs> ProTabsHeader => _ =>
        @<ProRender>
            @if (!string.IsNullOrEmpty(AddIconToolTip))
            {
                <ProTooltip Text="@AddIconToolTip">
                    <ProIconButton Icon="@AddTabIcon" 
                        Class="@AddIconClass" 
                        Style="@AddIconStyle" 
                        OnClick="@AddTab" 
                        aria-label="@Localizer[LanguageResource.ProTabs_AddTab]" />
                </ProTooltip>
            }
            else
            {
                <ProIconButton 
                    Icon="@AddTabIcon" 
                    Class="@AddIconClass" 
                    Style="@AddIconStyle" 
                    OnClick="@AddTab" 
                    aria-label="@Localizer[LanguageResource.ProTabs_AddTab]" />
            }
        </ProRender>;
}
