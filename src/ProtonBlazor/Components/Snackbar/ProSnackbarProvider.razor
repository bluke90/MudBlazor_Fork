@namespace ProtonBlazor
@inherits ProComponentBase

@{
}

<div @attributes="UserAttributes" id="pro-snackbar-container" class="@Classname" style="@Style">
    @foreach (var snackbar in Snackbar)
    {
        <ProSnackbarElement @key="snackbar" Snackbar="@snackbar"></ProSnackbarElement>
    }
</div>
