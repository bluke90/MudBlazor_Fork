@namespace ProtonBlazor
@inherits ProComponentBase
@typeparam T
@using ProtonBlazor.Utilities
@using ProtonBlazor.Extensions
@using ProtonBlazor.Resources
@inject InternalMudLocalizer Localizer

@{
    _currentRenderFilteredItemsCache = null;
}

<CascadingValue IsFixed="true" Value="this">@Columns</CascadingValue>

<CascadingValue IsFixed="true" Value="this">
    <div @attributes="UserAttributes" class="@Classname" style="@Stylename">
        @if (Items != null || HasServerData)
        {
            @if (ToolBarContent != null)
            {
                <ProToolBar Class="pro-table-toolbar" Style="@HeaderFooterStyle">
                    @ToolBarContent
                    @if (ShowMenuIcon)
                    {
                        @ToolbarMenu(this)
                    }
                </ProToolBar>
            }
            else
            {
                @if (ShowMenuIcon)
                {
                    @*Add the default toolbar.*@
                    <ProToolBar Class="pro-table-toolbar" Style="@HeaderFooterStyle">
                        <ProSpacer />
                        @ToolbarMenu(this)
                    </ProToolBar>
                }
            }
            <div @ref=_gridElement class="@TableClass" style="@TableStyle">
                <ProDropContainer @ref="_dropContainer" T="Column<T>" Items="@RenderedColumns" ItemsSelector="(item, dropzone) => RenderedColumnsItemsSelector(item, dropzone)" ItemDropped="ItemUpdatedAsync" CanDropClass="@DropAllowedClass" NoDropClass="@DropNotAllowedClass" ApplyDropClassesOnDragStarted="@ApplyDropClassesOnDragStarted">
                    <ChildContent>
                        <table class="pro-table-root">
                            @if (ColGroup != null)
                            {
                                <colgroup>
                                    @ColGroup
                                </colgroup>
                            }
                            <thead class="@HeadClassname">
                                <CascadingValue Name="IsOnlyHeader" IsFixed="true" Value="true">
                                    @Header
                                </CascadingValue>
                                <tr class="pro-table-row">
                                    @foreach (var column in RenderedColumns)
                                    {
                                        <HeaderCell SortDirection="@(GetColumnSortDirection(column.PropertyName))" T="T" Column="@column"></HeaderCell>
                                    }
                                </tr>
                                @if (_filtersMenuVisible && FilterMode == DataGridFilterMode.Simple)
                                {
                                    <ProOverlay @bind-Visible="@_filtersMenuVisible" AutoClose OnClosed="@OnFiltersPanelClosed"></ProOverlay>
                                    <tr class="pro-table-row" style="visibility: collapse; opacity: 0;overflow: hidden;">
                                        <th colspan="@RenderedColumns.Count" class="pro-table-cell pro-filter-panel-cell">
                                            <ProPopover UserAttributes="@FiltersPositionAttributes" Open="@_filtersMenuVisible" Paper="true" Class="filters-panel pa-2 pro-popover-position-override" OverflowBehavior="OverflowBehavior.FlipOnOpen" AnchorOrigin="Origin.TopLeft"
                                                        TransformOrigin="Origin.TopLeft" Elevation="4" Style="width:700px;max-width:700px;" MaxHeight="400">
                                                @if (FilterTemplate == null)
                                                {
                                                    <ProStack>
                                                        @foreach (var f in FilterDefinitions)
                                                        {
                                                            @Filter(f, null)
                                                        }
                                                    </ProStack>
                                                    <ProButton Class="mt-2" StartIcon="@Icons.Material.Filled.Add" OnClick="@AddFilter" Color="@Color.Primary">@Localizer[LanguageResource.ProDataGrid_AddFilter]</ProButton>
                                                    @if (HasServerData)
                                                    {
                                                        <ProButton Class="mt-2" StartIcon="@Icons.Material.Filled.Add" OnClick="@ApplyFiltersAsync" Color="@Color.Primary">@Localizer[LanguageResource.ProDataGrid_Apply]</ProButton>
                                                    }
                                                    <ProButton Class="mt-2" StartIcon="@Icons.Material.Filled.Remove" OnClick="@ClearFiltersAsync" Color="@Color.Primary">@Localizer[LanguageResource.ProDataGrid_Clear]</ProButton>
                                                }
                                                else
                                                {
                                                    @FilterTemplate(this)
                                                }
                                            </ProPopover>
                                        </th>
                                    </tr>
                                }
                                @if (_columnsPanelVisible)
                                {
                                    <ProOverlay @bind-Visible="_columnsPanelVisible" AutoClose></ProOverlay>
                                    <tr class="pro-table-row" style="visibility: collapse; opacity: 0; overflow: hidden;">
                                        <th colspan="@RenderedColumns.Count" class="pro-table-cell pro-filter-panel-cell">
                                            <ProPopover UserAttributes="@ColumnsPanelPositionAttributes" Open="@_columnsPanelVisible" Paper="true" Class="pro-data-grid-columns-panel px-2 pro-popover-position-override" OverflowBehavior="OverflowBehavior.FlipOnOpen"
                                                        AnchorOrigin="Origin.TopLeft"
                                                        TransformOrigin="Origin.TopLeft" Elevation="4"
                                                        Style="max-width:700px;" MaxHeight="400">
                                                <ProStack Row="true" Justify="Justify.FlexEnd">
                                                    <div style="min-width:250px">
                                                        <ProTextField DebounceInterval="500" @bind-Value="@_columnsPanelSearch" OnDebounceIntervalElapsed="@(() => _columnsPanelDropContainer?.Refresh())"
                                                        Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" Margin="Margin.Dense" FullWidth="true" />
                                                    </div>
                                                </ProStack>

                                                <ProDropContainer @ref="_columnsPanelDropContainer" T="Column<T>" Items="@RenderedColumns" ItemsSelector="(item, dropzone) => true"
                                                ItemDisabled="@((item) => !this.ColumnsPanelReordering)" ItemDropped="ColumnOrderUpdated">
                                                    <ChildContent>
                                                        <ProDropZone T="Column<T>" Class="flex-grow-1" AllowReorder=this.ColumnsPanelReordering />
                                                    </ChildContent>
                                                    <ItemRenderer>
                                                        @if (string.IsNullOrEmpty(_columnsPanelSearch) || context.Title?.Contains(_columnsPanelSearch, StringComparison.InvariantCultureIgnoreCase) == true)
                                                        {
                                                            <ProStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Style="border-bottom: 1px solid var(--pro-palette-table-lines);">
                                                                @if (ColumnsPanelReordering)
                                                                {
                                                                    <ProStack Spacing="0">
                                                                        @if (RenderedColumns.IndexOf(context) != 0)
                                                                        {
                                                                            <ProIconButton Ripple="false" Icon="@Icons.Material.Filled.ArrowDropUp" Size="@Size.Small" title=@Localizer[LanguageResource.ProDataGrid_MoveUp] Disabled="@(RenderedColumns.IndexOf(context) == 0)" OnClick="@(e => ColumnUp(context))"></ProIconButton>
                                                                        }
                                                                        @if (RenderedColumns.IndexOf(context) != RenderedColumns.Count - 1)
                                                                        {
                                                                            <ProIconButton Ripple="false" Icon="@Icons.Material.Filled.ArrowDropDown" Size="@Size.Small" title=@Localizer[LanguageResource.ProDataGrid_MoveDown] Disabled="@(RenderedColumns.IndexOf(context) == RenderedColumns.Count - 1)" OnClick="@(e => ColumnDown(context))"></ProIconButton>
                                                                        }
                                                                    </ProStack>
                                                                }

                                                                @if (context.GroupingState.Value)
                                                                {
                                                                    <ProIconButton Ripple="false" Icon="@Icons.Material.Filled.AccountTree" Size="@Size.Small" title=@Localizer[LanguageResource.ProDataGrid_Ungroup] Disabled="!context.groupable" OnClick="@(e => context.HeaderCell.UngroupColumnAsync())"></ProIconButton>
                                                                }
                                                                else
                                                                {
                                                                    <ProIconButton Ripple="false" Icon="@Icons.Material.Filled.TableRows" Size="@Size.Small" title=@Localizer[LanguageResource.ProDataGrid_Group] Disabled="!context.groupable" OnClick="@(e => context.HeaderCell.GroupColumnAsync())"></ProIconButton>
                                                                }
                                                                <ProSwitch T="bool" Ripple="false" Class="flex-grow-1" Color="Color.Primary" Disabled="@(!context.hideable)" Value="@context.HiddenState.Value" ValueChanged="@context.ToggleAsync" Converter="_oppositeBoolConverter" Label="@context.Title" />
                                                                <ProSpacer />

                                                                <div>
                                                                    <ProIconButton Ripple="false" Icon="@context.DataGrid.SortIcon" Class="@context.HeaderCell.sortIconClass" Size="@Size.Small" title=@Localizer[LanguageResource.ProDataGrid_Sort] Disabled="!context.sortable" OnClick="@(e => context.HeaderCell.SortChangedAsync(e))"></ProIconButton>
                                                                    @if (context.DataGrid.SortMode == SortMode.Multiple)
                                                                    {
                                                                        if (context.SortIndex < 0)
                                                                        {
                                                                            <span class="pro-sort-index pro-text-disabled invisible">@(context.SortIndex + 1)</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="pro-sort-index pro-text-disabled">@(context.SortIndex + 1)</span>
                                                                        }
                                                                    }
                                                                </div>

                                                                @if (context.HeaderCell.hasFilter)
                                                                {
                                                                    <ProIconButton Ripple="false" Class="filter-button filtered" Icon="@context.DataGrid.FilterIconFilled" Size="@Size.Small" title=@Localizer[LanguageResource.ProDataGrid_Filter] Disabled="!context.filterable" OnClick="@context.HeaderCell.OpenFilters"></ProIconButton>
                                                                }
                                                                else
                                                                {
                                                                    <ProIconButton Ripple="false" Class="filter-button" Icon="@context.DataGrid.FilterIconEmpty" Size="@Size.Small" title=@Localizer[LanguageResource.ProDataGrid_Filter] Disabled="!context.filterable" OnClick="@context.HeaderCell.AddFilter"></ProIconButton>
                                                                }

                                                                @if (ColumnsPanelReordering)
                                                                {
                                                                    <ProIconButton Ripple="false" Icon="@context.DataGrid.DragIndicatorIcon" Size="@Size.Small" Class="drag-icon-options"></ProIconButton>
                                                                }
                                                            </ProStack>
                                                        }
                                                    </ItemRenderer>
                                                </ProDropContainer>
                                                <ProStack Row="true">
                                                    @if (Groupable)
                                                    {
                                                        <ProButton OnClick="@CollapseAllGroupsAsync" Color="@Color.Primary">@Localizer[LanguageResource.ProDataGrid_CollapseAllGroups]</ProButton>
                                                        <ProButton OnClick="@ExpandAllGroupsAsync" Color="@Color.Primary">@Localizer[LanguageResource.ProDataGrid_ExpandAllGroups]</ProButton>
                                                    }
                                                    <ProSpacer />

                                                    <ProButton OnClick="@HideAllColumnsAsync" Color="@Color.Primary">@Localizer[LanguageResource.ProDataGrid_HideAll]</ProButton>
                                                    <ProButton OnClick="@ShowAllColumnsAsync" Color="@Color.Primary">@Localizer[LanguageResource.ProDataGrid_ShowAll]</ProButton>
                                                </ProStack>
                                            </ProPopover>
                                        </th>
                                    </tr>
                                }
                                @if (Filterable && FilterMode == DataGridFilterMode.ColumnFilterRow)
                                {
                                    <tr class="pro-table-row">
                                        @foreach (var column in RenderedColumns)
                                        {
                                            <FilterHeaderCell T="T" Column="@column" />
                                        }
                                    </tr>
                                }
                                @if (Loading)
                                {
                                    <tr>
                                        <th colspan="1000" class="pro-table-loading">
                                            <ProProgressLinear Color="@LoadingProgressColor" Class="pro-table-loading-progress" Indeterminate="true" />
                                        </th>
                                    </tr>
                                }
                            </thead>
                            <tbody class="@BodyClassname">
                                @if (Virtualize || CurrentPageItems.Count() > 0)
                                {
                                    if (IsGrouped)
                                    {
                                        var groupItemsPage = GroupItemsPage;
                                        var groupDefinitions = GetGroupDefinitions(_groupDefinition!, groupItemsPage);
                                        if (!groupItemsPage.Any())
                                        {
                                            <tr>
                                                <th colspan="1000" class="pro-table-empty-row">
                                                    <div Class="my-3">
                                                        @NoRecordsContent
                                                    </div>
                                                </th>
                                            </tr>
                                        }
                                        foreach (var g in groupDefinitions)
                                        {
                                            <DataGridGroupRow T="T" Items="@g.Grouping" 
                                            GroupDefinition="@g"                                                             
                                            GroupClass="@GroupClass"
                                            GroupStyle="@GroupStyle"
                                            GroupClassFunc="@GroupClassFunc"
                                            GroupStyleFunc="@GroupStyleFunc"
                                            DataGrid="this"
                                            RowClick="@(args => OnRowClickedAsync(args.args, args.item, args.index))"
                                            ContextRowClick="@(args => OnContextMenuClickedAsync(args.args, args.item, args.index))" />
                                        }
                                    }
                                    else
                                    {
                                        <DataGridVirtualizeRow T="T" DataGrid="this" 
                                        RowClick="@(args => OnRowClickedAsync(args.args, args.item, args.index))" 
                                        ContextRowClick="@(args => OnContextMenuClickedAsync(args.args, args.item, args.index))" />
                                    }
                                }
                                else if (Loading ? LoadingContent != null : NoRecordsContent != null)
                                {
                                    <tr>
                                        <th colspan="1000" class="pro-table-empty-row">
                                            <div Class="my-3">
                                                @if (Loading)
                                                {
                                                    @LoadingContent
                                                }
                                                else
                                                {
                                                    @NoRecordsContent
                                                }
                                            </div>
                                        </th>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="@FootClassname">
                                <tr class="pro-table-row">
                                    @FooterCells(CurrentPageItems)
                                </tr>
                            </tfoot>
                        </table>
                    </ChildContent>
                    <ItemRenderer>
                        @context.HeaderCell.TableHeader()
                    </ItemRenderer>
                </ProDropContainer>
            </div>
            @if (PagerContent != null)
            {
                <div class="pro-table-pagination" style="@HeaderFooterStyle">
                    @PagerContent
                </div>
            }
        }
    </div>
    <CascadingValue Value="true" IsFixed Name="IsNested">
        <ProDialog Options="EditDialogOptions" @bind-Visible="_isEditFormOpen" DefaultFocus="DefaultFocus.FirstChild">
            <DialogContent>
                <ProForm @ref="_editForm" FieldChanged="FormFieldChanged">
                    @foreach (var column in RenderedColumns)
                    {
                        var cell = new Cell<T>(this, column, _editingItem!);

                        if (column.EditTemplate != null)
                        {
                            @column.EditTemplate(cell._cellContext)
                        }
                        else
                        {
                            var propertyType = column.PropertyType;

                            if (propertyType == typeof(string))
                            {
                                <ProTextField T="string" Label="@column.Title" Value="@cell._valueString" ValueChanged="@cell.StringValueChangedAsync" Margin="@Margin.Dense"
                                Required="@column.Required" Variant="@Variant.Outlined" Disabled="@(!column.Editable || ReadOnly)" Class="mt-4" Culture="@column.Culture" />
                            }
                            else if (TypeIdentifier.IsNumber(propertyType))
                            {
                                <ProNumericField T="double?" Label="@column.Title" Value="@cell._valueNumber" ValueChanged="@cell.NumberValueChangedAsync" Margin="@Margin.Dense"
                                Required="@column.Required" Variant="@Variant.Outlined" Disabled="@(!column.Editable || ReadOnly)" Class="mt-4" Culture="@column.Culture" Format="@column.ContentFormat" />
                            }
                        }
                    }
                </ProForm>
            </DialogContent>
            <DialogActions>
                <ProButton Variant="Variant.Filled" Color="Color.Default" OnClick="@CancelEditingItemAsync" Class="px-10">@Localizer[LanguageResource.ProDataGrid_Cancel]</ProButton>
                <ProButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@CommitItemChangesAsync" Class="px-10">@Localizer[LanguageResource.ProDataGrid_Save]</ProButton>
            </DialogActions>
        </ProDialog>
    </CascadingValue>
</CascadingValue>

@code {

    internal RenderFragment ToolbarMenu(ProDataGrid<T> dataGrid) =>
    @<text>
        <ProMenu Icon="@Icons.Material.Outlined.Settings" Size="Size.Small" Dense="true">
            <ProMenuItem OnClick="@dataGrid.ShowColumnsPanel">@Localizer[LanguageResource.ProDataGrid_Columns]</ProMenuItem>
                @if (dataGrid.IsGrouped)
                {
                    <ProMenuItem OnClick="@dataGrid.ExpandAllGroupsAsync">@Localizer[LanguageResource.ProDataGrid_ExpandAllGroups]</ProMenuItem>
                    <ProMenuItem OnClick="@dataGrid.CollapseAllGroupsAsync">@Localizer[LanguageResource.ProDataGrid_CollapseAllGroups]</ProMenuItem>
                }
                @if (dataGrid.HasHierarchyColumn)
                {
                    <ProMenuItem OnClick="@dataGrid.ExpandAllHierarchy">@Localizer[LanguageResource.ProDataGrid_ExpandAllGroups]</ProMenuItem>
                    <ProMenuItem OnClick="@dataGrid.CollapseAllHierarchy">@Localizer[LanguageResource.ProDataGrid_CollapseAllGroups]</ProMenuItem>
                }
                @if (dataGrid.HasServerData)
                {
                    <ProMenuItem OnClick="@dataGrid.InvokeServerLoadFunc">@Localizer[LanguageResource.ProDataGrid_RefreshData]</ProMenuItem>
                }
            </ProMenu>
         </text>
    ;



    internal RenderFragment FooterCells(IEnumerable<T> currentItems) =>
        @<text>
             @if (currentItems is not null)
             {
                 foreach (var column in RenderedColumns)
                 {
                     if (!column.HiddenState.Value)
                     {
                         if (column.AggregateDefinition is not null || column.GetFooterTemplate() is not null || HasFooter)
                         {
                             <FooterCell T="T" Column="@column" CurrentItems="@currentItems"></FooterCell>
                         }
                     }
                 }
             }
         </text>;


    internal RenderFragment Cell(Column<T> column, T item) =>
        @<text>
             @{
                 var cell = new Cell<T>(this, column, item);
             }
             <td data-label="@column.Title" class="@cell.ComputedClass" style="@cell.ComputedStyle">
                 @if (column.Editable && !ReadOnly && EditMode == DataGridEditMode.Cell)
                 {
                     if (column.EditTemplate is not null)
                     {
                         @column.EditTemplate(cell._cellContext)
                     }
                     else
                     {
                         if (column.PropertyType == typeof(string))
                         {
                             <ProTextField T="string"
                                           Value="@cell._valueString"
                                           ValueChanged="@cell.StringValueChangedAsync"
                                           Margin="@Margin.Dense" Style="margin-top:0"
                                           Required="@column.Required"
                                           Variant="@Variant.Text" Culture="@column.Culture" />
                         }
                         else if (column.isNumber)
                         {
                             <ProNumericField T="double?"
                                              Value="@cell._valueNumber"
                                              ValueChanged="@cell.NumberValueChangedAsync"
                                              Margin="@Margin.Dense" Style="margin-top:0"
                                              Required="@column.Required"
                                              Variant="@Variant.Text" Culture="@column.Culture"
                                              Format="@column.ContentFormat" />
                         }
                     }
                 }
                 else
                 {
                     var cellTemplate = column.GetCellTemplate();
                     if (cellTemplate is not null)
                     {
                         @cellTemplate(cell._cellContext)
                     }
                     else if (column.Culture is not null && column.isNumber)
                     {
                         if (column.ContentFormat is not null)
                         {
                             @(((IFormattable?)cell._valueNumber)?.ToString(column.ContentFormat, column.Culture))
                         }
                         else
                         {
                             @cell._valueNumber?.ToString(column.Culture)
                         }
                     }
                     else
                     {
                         if (column.ContentFormat is not null)
                         {
                             @(((IFormattable?)cell.ComputedValue)?.ToString(column.ContentFormat, column.Culture))
                         }
                         else
                         {
                             @cell.ComputedValue
                         }
                     }
                 }
             </td>
         </text>;

    internal RenderFragment Filter(IFilterDefinition<T> filterDefinition, Column<T>? column) =>
        @<text>
            @{
                var filter = new Filter<T>(this, filterDefinition, column);
                var fieldType = filterDefinition.FieldType;
            }
            @if (column is null)
            {
                <ProGrid Spacing="0">
                    <ProItem xs="1" Class="d-flex">
                        <ProIconButton Class="remove-filter-button" Icon="@Icons.Material.Filled.Close" OnClick="@filter.RemoveFilterAsync" Size="@Size.Small" Style="align-self: flex-end" aria-label="@Localizer[LanguageResource.ProDataGrid_RemoveFilter]"></ProIconButton>
                    </ProItem>
                    <ProItem xs="4">
                        <ProSelect T="Column<T>" Value="@filterDefinition.Column" ValueChanged="@filter.FieldChanged" FullWidth="true" Label="@Localizer[LanguageResource.ProDataGrid_Column]" Dense="true" Margin="@Margin.Dense"
                                   Class="filter-field">
                            @foreach (var renderColumn in RenderedColumns.Where(x => x.Filterable != false))
                            {
                                <ProSelectItem T="Column<T>" Value="@renderColumn">@renderColumn.Title</ProSelectItem>
                            }
                        </ProSelect>
                    </ProItem>
                    @if (filterDefinition.Column?.FilterTemplate != null)
                    {
                        var filterContext = CreateFilterContext(filterDefinition.Column, filterDefinition);
                        <ProItem xs="7">
                            @filterDefinition.Column.FilterTemplate(filterContext)
                        </ProItem>
                    }
                    else
                    {
                        <ProItem xs="3">
                            <ProSelect @bind-Value="filterDefinition.Operator" FullWidth="true" Label="@Localizer[LanguageResource.ProDataGrid_Operator]" Dense="true" Margin="@Margin.Dense"
                                       Class="filter-operator">
                                @foreach (var fieldOperator in filterDefinition.Column!.GetFilterOperators(fieldType))
                                {
                                    <ProSelectItem Value="@fieldOperator">@Localizer[FilterOperator.GetTranslationKeyByOperatorName(fieldOperator)]</ProSelectItem>
                                }
                            </ProSelect>
                        </ProItem>
                        <ProItem xs="4">
                            @if (fieldType.IsString && !(filterDefinition.Operator ?? "").EndsWith("empty"))
                            {
                                <ProTextField T="string" Value="@filter._valueString" ValueChanged="@filter.StringValueChanged" FullWidth="true" Label="@Localizer[LanguageResource.ProDataGrid_Value]" Placeholder="@Localizer[LanguageResource.ProDataGrid_FilterValue]" Margin="@Margin.Dense"
                                              Immediate="true" Class="filter-input" />
                            }
                            else if (fieldType.IsNumber && !(filterDefinition.Operator ?? "").EndsWith("empty"))
                            {
                                <ProNumericField T="double?" Value="@filter._valueNumber" ValueChanged="@filter.NumberValueChanged" FullWidth="true" Label="@Localizer[LanguageResource.ProDataGrid_Value]" Placeholder="@Localizer[LanguageResource.ProDataGrid_FilterValue]" Margin="@Margin.Dense"
                                                 Immediate="true" Class="filter-input" Culture="@filter.FilterColumn?.Culture"/>
                            }
                            else if (fieldType.IsEnum)
                            {
                                <ProSelect T="Enum" Value="@filter._valueEnum" ValueChanged="@filter.EnumValueChanged" FullWidth="true" Label="@Localizer[LanguageResource.ProDataGrid_Value]" Placeholder="@Localizer[LanguageResource.ProDataGrid_FilterValue]" Dense="true" Margin="@Margin.Dense"
                                           Class="filter-input">
                                    <ProSelectItem T="Enum" Value="@(null)"></ProSelectItem>
                                    @foreach (var item in EnumExtensions.GetSafeEnumValues(fieldType.InnerType))
                                    {
                                        <ProSelectItem T="Enum" Value="@item">@Localizer[item]</ProSelectItem>
                                    }
                                </ProSelect>
                            }
                            else if (fieldType.IsBoolean)
                            {
                                <ProSelect T="bool?" Value="@filter._valueBool" ValueChanged="@filter.BoolValueChanged" FullWidth="true" Label="@Localizer[LanguageResource.ProDataGrid_Value]" Placeholder="@Localizer[LanguageResource.ProDataGrid_FilterValue]" Dense="true" Margin="@Margin.Dense"
                                           Class="filter-input">
                                    <ProSelectItem T="bool?" Value="@(null)"></ProSelectItem>
                                    <ProSelectItem T="bool?" Value="@(true)">@Localizer[LanguageResource.ProDataGrid_True]</ProSelectItem>
                                    <ProSelectItem T="bool?" Value="@(false)">@Localizer[LanguageResource.ProDataGrid_False]</ProSelectItem>
                                </ProSelect>
                            }
                            else if (fieldType.IsDateOnly && !(filterDefinition.Operator ?? "").EndsWith("empty"))
                            {
                                <ProDatePicker Date="@filter._valueDateOnlyForPicker" DateChanged="@filter.DateOnlyValueChanged" Label="@Localizer[LanguageResource.ProDataGrid_Value]" Placeholder="@Localizer[LanguageResource.ProDataGrid_FilterValue]" Margin="@Margin.Dense" Class="filter-input-date"/>
                            }
                            else if (fieldType.IsDateTime && !(filterDefinition.Operator ?? "").EndsWith("empty"))
                            {
                                <ProGrid Spacing="0">
                                    <ProItem xs="7">
                                        <ProDatePicker Date="@filter._valueDateTimeForPicker" DateChanged="@filter.DateValueChanged" Label="@Localizer[LanguageResource.ProDataGrid_Value]" Placeholder="@Localizer[LanguageResource.ProDataGrid_FilterValue]" Margin="@Margin.Dense" Class="filter-input-date"/>
                                    </ProItem>
                                    <ProItem xs="5">
                                        <ProTimePicker Time="@filter._valueTime" TimeChanged="@filter.TimeValueChanged" Label="@Localizer[LanguageResource.ProDataGrid_Value]" Placeholder="@Localizer[LanguageResource.ProDataGrid_FilterValue]" Margin="@Margin.Dense" Class="filter-input-time" />
                                    </ProItem>
                                </ProGrid>
                            }
                            else if (fieldType.IsGuid)
                            {
                                <ProTextField T="Guid?" Value="@filter._valueGuid" ValueChanged="@filter.GuidValueChanged" FullWidth="true" Label="@Localizer[LanguageResource.ProDataGrid_Value]" Placeholder="@Localizer[LanguageResource.ProDataGrid_FilterValue]" Margin="@Margin.Dense"
                                              Immediate="true" Class="filter-input"/>
                            }
                        </ProItem>
                    }
                </ProGrid>
            }
            else
            {
                <ProGrid Spacing="0">
                    <ProItem xs="12">
                        <ProSelect @bind-Value="filterDefinition.Operator" FullWidth="true" Dense="true" Margin="@Margin.Dense"
                                   Class="filter-operator">
                            @foreach (var o in column.GetFilterOperators(fieldType))
                            {
                                <ProSelectItem Value="@o">@Localizer[FilterOperator.GetTranslationKeyByOperatorName(o)]</ProSelectItem>
                            }
                        </ProSelect>
                    </ProItem>
                    <ProItem xs="12">
                        @if (fieldType.IsString && !(filterDefinition.Operator ?? "").EndsWith("empty"))
                        {
                            <ProTextField T="string" Value="@filter._valueString" ValueChanged="@filter.StringValueChanged" FullWidth="true" Placeholder="@Localizer[LanguageResource.ProDataGrid_FilterValue]" Margin="@Margin.Dense"
                                          Immediate="true" Class="filter-input" AutoFocus="true" OnKeyDown="@(args => OnColumnFilterInputKeyDownAsync(args, column))"/>
                        }
                        else if (fieldType.IsNumber && !(filterDefinition.Operator ?? "").EndsWith("empty"))
                        {
                            <ProNumericField T="double?" Value="@filter._valueNumber" ValueChanged="@filter.NumberValueChanged" FullWidth="true" Placeholder="@Localizer[LanguageResource.ProDataGrid_FilterValue]" Margin="@Margin.Dense"
                                             Immediate="true" Class="filter-input" Culture="@filter.FilterColumn?.Culture" AutoFocus="true" OnKeyDown="@(args => OnColumnFilterInputKeyDownAsync(args, column))"/>
                        }
                        else if (fieldType.IsEnum)
                        {
                            <ProSelect T="Enum" Value="@filter._valueEnum" ValueChanged="@filter.EnumValueChanged" FullWidth="true" Placeholder="@Localizer[LanguageResource.ProDataGrid_FilterValue]" Dense="true" Margin="@Margin.Dense"
                                       Class="filter-input">
                                <ProSelectItem T="Enum" Value="@(null)"></ProSelectItem>
                                @foreach (var item in EnumExtensions.GetSafeEnumValues(fieldType.InnerType))
                                {
                                    <ProSelectItem T="Enum" Value="@item">@Localizer[item]</ProSelectItem>
                                }
                            </ProSelect>
                        }
                        else if (fieldType.IsBoolean)
                        {
                            <ProSelect T="bool?" Value="@filter._valueBool" ValueChanged="@filter.BoolValueChanged" FullWidth="true" Placeholder="@Localizer[LanguageResource.ProDataGrid_FilterValue]" Dense="true" Margin="@Margin.Dense"
                                       Class="filter-input">
                                <ProSelectItem T="bool?" Value="@(null)"></ProSelectItem>
                                <ProSelectItem T="bool?" Value="@(true)">@Localizer[LanguageResource.ProDataGrid_True]</ProSelectItem>
                                <ProSelectItem T="bool?" Value="@(false)">@Localizer[LanguageResource.ProDataGrid_False]</ProSelectItem>
                            </ProSelect>
                        }
                        else if (fieldType.IsDateOnly && !(filterDefinition.Operator ?? "").EndsWith("empty"))
                        {
                            <ProDatePicker Date="@filter._valueDateOnlyForPicker" DateChanged="@filter.DateOnlyValueChanged" Placeholder="@Localizer[LanguageResource.ProDataGrid_FilterValue]" Margin="@Margin.Dense" Class="filter-input-date"/>
                        }
                        else if (fieldType.IsDateTime && !(filterDefinition.Operator ?? "").EndsWith("empty"))
                        {
                            <ProGrid Spacing="0">
                                <ProItem xs="7">
                                    <ProDatePicker Date="@filter._valueDateTimeForPicker" DateChanged="@filter.DateValueChanged" Placeholder="@Localizer[LanguageResource.ProDataGrid_FilterValue]" Margin="@Margin.Dense" Class="filter-input-date"/>
                                </ProItem>
                                <ProItem xs="5">
                                    <ProTimePicker Time="@filter._valueTime" TimeChanged="@filter.TimeValueChanged" Placeholder="@Localizer[LanguageResource.ProDataGrid_FilterValue]" Margin="@Margin.Dense" Class="filter-input-time"/>
                                </ProItem>
                            </ProGrid>
                        }
                        else if (fieldType.IsGuid)
                        {
                            <ProTextField T="Guid?" Value="@filter._valueGuid" ValueChanged="@filter.GuidValueChanged" FullWidth="true" Placeholder="@Localizer[LanguageResource.ProDataGrid_FilterValue]" Margin="@Margin.Dense"
                                          Immediate="true" Class="filter-input" AutoFocus="true" OnKeyDown="@(args => OnColumnFilterInputKeyDownAsync(args, column))"/>
                        }
                    </ProItem>
                </ProGrid>
            }
         </text>;
}
