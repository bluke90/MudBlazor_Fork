<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <EnumGenerator_ForceInternal>true</EnumGenerator_ForceInternal>
  </PropertyGroup>

  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>Nuget.png</PackageIcon>
    <Company>ProtonBlazor</Company>
    <Authors>Garderoben, Henon and Contributors</Authors>
    <Copyright>Copyright 2026 ProtonBlazor</Copyright>
    <PackageTags>Blazor, ProtonBlazor, Material, Material Design, Components, Blazor Components, Blazor Library</PackageTags>
    <Description>Blazor Component Library based on Material Design principles with an emphasis on ease of use and extensibility</Description>
    <PackageProjectUrl>https://protonblazor.com/</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/ProtonBlazor/ProtonBlazor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  
  <PropertyGroup>
    <IsTrimmable>true</IsTrimmable>
    <TrimMode>link</TrimMode>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>

    <!-- https://github.com/dotnet/runtime/issues/95134 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" Visible="false" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" Visible="false" PackagePath="" />
    <None Include="..\..\content\Nuget.png" Pack="true" Visible="false" PackagePath="" />
  </ItemGroup>

  <!--Analyzer Config-->
  <PropertyGroup>
    <ProAllowedAttributePattern>LowerCase</ProAllowedAttributePattern>
    <ProDebugAnalyzer>false</ProDebugAnalyzer>
  </PropertyGroup>

  <!--Is this a rebuild - Dont clean generated files as this breaks rebuild behaviour-->
  <Target Name="ShouldCleanGeneratedFiles" BeforeTargets="BeforeRebuild">
    <PropertyGroup>
      <CleanGeneratedFiles>false</CleanGeneratedFiles>
    </PropertyGroup>
  </Target>

  <Target Name="CleanGeneratedFiles" BeforeTargets="Clean" Condition="'$(CleanGeneratedFiles)' != 'false'">
    <ItemGroup>
      <FilesToClean Include="./TScripts/combined/ProtonBlazor.js" />
      <FilesToClean Include="./wwwroot/ProtonBlazor.min.js" />
      <FilesToClean Include="./wwwroot/ProtonBlazor.min.js.map" />
      <FilesToClean Include="./wwwroot/ProtonBlazor.min.css" />
      <FilesToClean Include="./wwwroot/ProtonBlazor.css" />
      <FilesToClean Include="./wwwroot/css/ProtonBlazor.css" />
    </ItemGroup>
    <Delete Files="@(FilesToClean)" />
  </Target>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="8.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.12" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="8.0.12" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net9.0' ">
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="9.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.1" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="9.0.1" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.ResxSourceGenerator" Version="3.11.0-beta1.26075.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NetEscapades.EnumGenerators.Generators" Version="1.0.0-beta21" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="ProtonBlazor.Utilities.StringHelpers" Static="True" />
  </ItemGroup>

  <ItemGroup>
    <JsAssetInputs Include="TScripts/**/*.js" />
    <ScssAssetInputs Include="Styles/**/*.scss" />
    <WebAssetInputs Include="@(JsAssetInputs);@(ScssAssetInputs)" />
    <UpToDateCheckInput Include="@(WebAssetInputs)" />
    <WebAssetOutputs Include="wwwroot/ProtonBlazor.min.js;wwwroot/ProtonBlazor.min.js.map;wwwroot/ProtonBlazor.min.css" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Check if we're the first TFM when building directly (no outer build) -->
    <_IsFirstTfm>false</_IsFirstTfm>
    <_IsFirstTfm Condition="'$(TargetFramework)' == 'net10.0'">true</_IsFirstTfm>
  </PropertyGroup>

  <Target Name="BuildWebAssets"
          BeforeTargets="DispatchToInnerBuilds"
          Condition="'$(IsCrossTargetingBuild)' == 'true' AND '$(SkipBunCompile)' != 'true'"
          Inputs="@(WebAssetInputs)"
          Outputs="@(WebAssetOutputs)">

    <Message Importance="High"
             Text="Building ProtonBlazor web assets (outer build)" />

    <Exec Command="$(BunToolRestore)"
          WorkingDirectory="$(MSBuildProjectDirectory)" />

    <Exec Command="$(BunWrapper) run build.mjs"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="BuildWebAssetsInner"
          BeforeTargets="ResolveProjectStaticWebAssets"
          Condition="'$(IsCrossTargetingBuild)' != 'true'
                AND '$(DesignTimeBuild)' != 'true'
                AND '$(_IsFirstTfm)' == 'true'
                AND '$(SkipBunCompile)' != 'true'"
          Inputs="@(WebAssetInputs)"
          Outputs="@(WebAssetOutputs)">

    <Message Importance="High"
             Text="Building ProtonBlazor web assets (inner build, TFM: $(TargetFramework))" />

    <Exec Command="$(BunToolRestore)"
          WorkingDirectory="$(MSBuildProjectDirectory)" />

    <Exec Command="$(BunWrapper) run build.mjs"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="RegisterGeneratedAssets"
          BeforeTargets="ResolveProjectStaticWebAssets"
          Condition="'$(IsCrossTargetingBuild)' != 'true'
                AND '$(DesignTimeBuild)' != 'true'
                AND '$(SkipBunCompile)' != 'true'">

    <ItemGroup>
      <_NewAssets Include="@(WebAssetOutputs)"
                  Exclude="@(Content)" />
      <Content Include="@(_NewAssets)" />
    </ItemGroup>

  </Target>



  <ItemGroup>
    <ProjectReference Include="..\ProtonBlazor.Analyzers\ProtonBlazor.Analyzers.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
    <ProjectReference Include="..\ProtonBlazor.Analyzers.CodeFixes\ProtonBlazor.Analyzers.CodeFixes.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
  </ItemGroup>
  
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddAnalyzersToOutput</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  
  <!--Add analyzer to build output so it works transitively -->
  <Target Name="_AddAnalyzersToOutput">
    <!--Limit to one copy (ProtonBlazor is multi targeted) analyzers are .net standard 2.0 -->
    <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
      <TfmSpecificPackageFile Include="..\ProtonBlazor.Analyzers\bin\$(Configuration)\netstandard2.0\$(AssemblyName).Analyzers.dll" PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="..\ProtonBlazor.Analyzers.CodeFixes\bin\$(Configuration)\netstandard2.0\$(AssemblyName).Analyzers.CodeFixes.dll" PackagePath="analyzers/dotnet/cs" />
      <!-- Add compiler visible properties to nuget for analyzers -->
      <TfmSpecificPackageFile Include="..\Directory.Build.targets" Pack="true" PackagePath="build\$(PackageId).targets" />
    </ItemGroup>
  </Target>
  
  <!--Dont Include in build output-->
  <ItemGroup>
    <Content Remove="build.mjs" />
    <Content Remove="wwwroot/DoNotRemove.txt" />
    <Content Remove="wwwroot/css/ProtonBlazor.css" />
    <!--macOS hidden file (causes problems with dotnet pack)-->
    <Content Remove="**/*/.DS_Store" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProtonBlazor.Docs" />
    <InternalsVisibleTo Include="ProtonBlazor.UnitTests.Shared" />
    <InternalsVisibleTo Include="ProtonBlazor.UnitTests" />
    <InternalsVisibleTo Include="ProtonBlazor.UnitTests.Docs" />
    <InternalsVisibleTo Include="ProtonBlazor.UnitTests.Viewer" />
    <InternalsVisibleTo Include="ProtonBlazor.Benchmarks" />
    <!--We need to make internal types to be visible for mocking-->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
  
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\LanguageResource.resx">
      <Public>false</Public>
      <AsConstants>true</AsConstants>
    </EmbeddedResource>
  </ItemGroup>

</Project>
