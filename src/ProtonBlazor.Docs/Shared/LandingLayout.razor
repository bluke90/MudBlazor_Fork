@inherits LayoutComponentBase
@layout MainLayout

<ProLayout Class="protonblazor-landingpage">
    <ProAppBar Class="landing-appbar" Elevation="0">
        <Appbar DrawerToggleCallback="ToggleDrawer" DisplaySearchBar="false" />
    </ProAppBar>
    <ProDrawer @bind-Open="@_drawerOpen" Elevation="25" Variant="@DrawerVariant.Temporary" aria-label="Navigation Drawer">
        <ProToolBar Dense="true" Gutters="false" Class="px-1 docs-gray-bg">
            <ProIconButton Icon="@Icons.Material.Rounded.Close" Color="Color.Inherit" OnClick="@ToggleDrawer" aria-label="Toggle drawer" />
            <ProSpacer/>
            <AppbarButtons/>
        </ProToolBar>
        <ProNavMenu Color="Color.Primary" Margin="Margin.Dense" Rounded="true" Class="pa-2">
            <ProNavLink Href="/getting-started/installation">Get Started</ProNavLink>
            <ProNavLink Href="/docs/overview">Docs</ProNavLink>
            <ProNavLink Href="/mud/introduction" Match="NavLinkMatch.All">Learn More</ProNavLink>
            <ProNavGroup Title="Projects" ExpandIcon="@Icons.Material.Filled.ExpandMore">
                <ProListSubheader Class="mt-4 pl-8 pb-2"><b>Official</b></ProListSubheader>
                <ProNavLink Href="https://protonblazor.com/">ProtonBlazor</ProNavLink>
                <ProNavLink Href="https://try.protonblazor.com/">TryProtonBlazor</ProNavLink>
                <ProNavLink Href="https://github.com/ProtonBlazor/ThemeManager">ThemeManager</ProNavLink>
                <ProNavLink Href="https://github.com/ProtonBlazor/Templates">Templates</ProNavLink>
                <ProListSubheader Class="mt-4 pl-8 pb-2"><b>Community</b></ProListSubheader>
                <ProNavLink Href="/mud/community/extensions">CommunityExtensions</ProNavLink>
            </ProNavGroup>
        </ProNavMenu>
    </ProDrawer>
    <ProMainContent Class="pa-0">
        @Body
        <LandingFooter/>
    </ProMainContent>
</ProLayout>
