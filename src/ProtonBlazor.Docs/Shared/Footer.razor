<ProGrid Class="docs-footer">
    <ProItem xs="6" sm="3">
        <ProtonBlazorLogo Style="width:40px;"/>
        <div class="d-flex flex-column mt-4">
            <div class="d-flex align-center my-2">
                <ProIcon Icon="@Icons.Custom.Brands.ProtonBlazor" Size="Size.Small" Color="Color.Inherit" Class="mr-2" />
                <ProText Typo="Typo.body1">ProtonBlazor</ProText>
            </div>
            <div class="d-flex align-center my-2">
                <ProIcon Icon="@Icons.Material.Rounded.MapsHomeWork" Size="Size.Small" Color="Color.Inherit" Class="mr-2" />
                <ProText Typo="Typo.body1">Gardnet AB</ProText>
            </div>
            <div class="d-flex align-center my-2">
                <ProIcon Icon="@Icons.Material.Rounded.NearMe" Size="Size.Small" Color="Color.Inherit" Class="mr-2" />
                <ProText Typo="Typo.body1">Sweden</ProText>
            </div>
        </div>
        <div class="d-flex mt-4">
            <ProIconButton Href="https://twitter.com/ProtonBlazor" Target="_blank" Edge="Edge.Start" Class="me-2" Color="Color.Inherit" Icon="@Icons.Custom.Brands.Twitter" aria-label="twitter" />
            <ProIconButton Href="https://discord.gg/protonblazor" Target="_blank" Edge="Edge.Start" Class="me-2" Color="Color.Inherit" Icon="@Icons.Custom.Brands.Discord" aria-label="discord"/>
            <ProIconButton Href="https://github.com/ProtonBlazor/ProtonBlazor" Target="_blank" Edge="Edge.Start" Class="me-2" Color="Color.Inherit" Icon="@Icons.Custom.Brands.GitHub" aria-label="github"/>
            <ProIconButton Href="https://stackoverflow.com/tags/protonblazor" Target="_blank" Edge="Edge.Start" Class="me-2" Color="Color.Inherit" Icon="@Icons.Custom.Brands.StackOverflow" aria-label="stack overflow"/>
        </div>
    </ProItem>
    <ProItem xs="6" sm="3" Class="d-flex flex-column">
        <ProText Typo="Typo.subtitle2" Class="mb-3">Community</ProText>
        <ProLink Href="/mud/community/getting-help" Typo="Typo.body1" Color="Color.Inherit" Underline="Underline.None">Getting Help</ProLink>
        <ProLink Href="/mud/community/reporting-bugs" Typo="Typo.body1" Color="Color.Inherit" Underline="Underline.None">Reporting Bugs</ProLink>
        <ProLink Href="/mud/community/contribution" Typo="Typo.body1" Color="Color.Inherit" Underline="Underline.None">Contribute</ProLink>
        <ProLink Href="/mud/community/extensions" Typo="Typo.body1" Color="Color.Inherit" Underline="Underline.None">Community Extensions</ProLink>
    </ProItem>
    <ProItem xs="6" sm="3" Class="d-flex flex-column">
        <ProText Typo="Typo.subtitle2" Class="mb-3">Project</ProText>
        <ProLink Href="/mud/announcements" Typo="Typo.body1" Color="Color.Inherit" Underline="Underline.None">Announcements</ProLink>
        <ProLink Href="/mud/project/releases" Typo="Typo.body1" Color="Color.Inherit" Underline="Underline.None">Releases</ProLink>
        <ProLink Href="/mud/project/roadmap" Typo="Typo.body1" Color="Color.Inherit" Underline="Underline.None">Roadmap</ProLink>
        <ProLink Href="/mud/project/sponsor" Typo="Typo.body1" Color="Color.Inherit" Underline="Underline.None">Sponsors & Backers</ProLink>
        <ProLink Href="/mud/project/team" Typo="Typo.body1" Color="Color.Inherit" Underline="Underline.None">Team & Contributors</ProLink>
        <ProLink Href="/mud/project/how-it-started" Typo="Typo.body1" Color="Color.Inherit" Underline="Underline.None">How it started</ProLink>
    </ProItem>
    <ProItem xs="6" sm="3" Class="d-flex flex-column">
        <ProText Typo="Typo.subtitle2" Class="mb-3">Products & Legal Information</ProText>
        <ProLink Href="https://protonblazor.com/" Target="_blank" Typo="Typo.body1" Color="Color.Inherit" Underline="Underline.None">ProtonBlazor</ProLink>
        <ProLink Href="https://try.protonblazor.com/" Target="_blank" Typo="Typo.body1" Color="Color.Inherit" Underline="Underline.None">TryProtonBlazor</ProLink>
        <ProLink Href="https://github.com/ProtonBlazor/ThemeManager" Target="_blank" Typo="Typo.body1" Color="Color.Inherit" Underline="Underline.None">ThemeManager</ProLink>
        <ProLink Href="https://github.com/ProtonBlazor/Templates" Target="_blank" Typo="Typo.body1" Color="Color.Inherit" Underline="Underline.None">Templates</ProLink>
        <ProLink Href="/mud/cookie-policy" Typo="Typo.body1" Color="Color.Inherit" Underline="Underline.None">Cookie Policy</ProLink>
    </ProItem>
    <ProItem xs="12">
        <ProToolBar Gutters="false" Dense="true">
            <ProText Typo="Typo.body1">@($"Copyright © 2020-{DateTime.Now.Year} ProtonBlazor")</ProText>
        </ProToolBar>
    </ProItem>
</ProGrid>
