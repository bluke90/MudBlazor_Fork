@using System.Linq
@using System.Text.RegularExpressions
@using ProtonBlazor.Docs.Extensions

<ProNavGroup Title="Getting Started" Expanded="@(_section == "getting-started")" ExpandIcon="@Icons.Material.Filled.ExpandMore">
    <ProNavLink Href="/getting-started/installation">Installation</ProNavLink>
    <ProNavLink Href="/getting-started/layouts">Layouts</ProNavLink>
    <ProNavLink Href="/getting-started/usage">Usage</ProNavLink>
    <ProNavLink Href="/getting-started/wireframes">Wireframes</ProNavLink>
</ProNavGroup>

<ProNavLink Href="docs/overview" Class="docs-single-link">Explore</ProNavLink>

<ProNavGroup Title="Components" Expanded="@(_section == "components")" ExpandIcon="@Icons.Material.Filled.ExpandMore">
    @foreach (var item in MenuService.Components)
    {
        if (item.IsNavGroup)
        {
            <ProNavGroup Title="@item.Name" Expanded="true" ExpandIcon="@Icons.Material.Filled.ExpandMore">
                @foreach (var subItem in item.GroupComponents)
                {
                    var href = $"components/{subItem.Link}";
                    <ProNavLink Href="@href">@subItem.Name</ProNavLink>
                }
            </ProNavGroup>
        }
        else
        {
            var href = $"components/{item.Link}";
            <ProNavLink Href="@href">@item.Name</ProNavLink>
        }
    }
</ProNavGroup>

<ProNavGroup Title="Component API" Expanded="@(_section == "api")" ExpandIcon="@Icons.Material.Filled.ExpandMore">
    <ProNavLink Href="/api" Match="NavLinkMatch.All">API Index</ProNavLink>
    @foreach (var item in MenuService.Api.OrderBy(x => x.Name))
    {
        <ProNavLink Href="@ApiLink.GetApiLinkFor(item.Type)">@item.Name</ProNavLink>
    }
</ProNavGroup>

<ProNavGroup Title="Features" Expanded="@(_section == "features")" ExpandIcon="@Icons.Material.Filled.ExpandMore">
    @foreach (var link in MenuService.Features)
    {
        <ProNavLink Href="@link.Href">@link.Title</ProNavLink>
    }
</ProNavGroup>

<ProNavGroup Title="Customization" Expanded="@(_section == "customization")" ExpandIcon="@Icons.Material.Filled.ExpandMore">
    @foreach (var link in MenuService.Customization)
    {
        <ProNavLink Href="@link.Href">@link.Title</ProNavLink>
    }
</ProNavGroup>

<ProNavGroup Title="CSS Utilities" Expanded="@(_section == "utilities")" ExpandIcon="@Icons.Material.Filled.ExpandMore">
    @foreach (var title in MenuService.Utilities.GroupBy(x => x.Group).Select(x => x.Key))
    {
        <div class="docs-css-utility-header">
            @title
        </div>

        @foreach (var link in MenuService.Utilities.Where(x => x.Group == title))
        {
            <ProNavLink Href="@link.Href" Match="NavLinkMatch.All">@link.Title</ProNavLink>
        }
    }
</ProNavGroup>

<ProNavGroup Title="Learn More" Expanded="@(_section == "mud")" ExpandIcon="@Icons.Material.Filled.ExpandMore">
    <ProNavLink Href="/mud/introduction">What is ProtonBlazor?</ProNavLink>
    <ProNavLink Href="/mud/announcements">Announcements</ProNavLink>
    <ProNavLink Href="/mud/community/getting-help">Getting Help</ProNavLink>
    <ProNavLink Href="/mud/community/reporting-bugs">Reporting Bugs</ProNavLink>
    <ProNavLink Href="/mud/community/contribution">Contribution</ProNavLink>
    <ProNavLink Href="/mud/community/extensions">Community Extensions</ProNavLink>
    <ProNavLink Href="/mud/project/releases">Releases</ProNavLink>
    <ProNavLink Href="/mud/project/roadmap">Roadmap</ProNavLink>
    <ProNavLink Href="/mud/project/sponsor">Sponsors & Backers</ProNavLink>
    <ProNavLink Href="/mud/project/team">Team & Contributors</ProNavLink>
    <ProNavLink Href="/mud/project/how-it-started">How it Started</ProNavLink>
</ProNavGroup>