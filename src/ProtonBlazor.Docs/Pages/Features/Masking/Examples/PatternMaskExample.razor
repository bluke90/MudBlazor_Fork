@namespace ProtonBlazor.Docs.Examples

<ProGrid Class="justify-space-between" Style="max-width: 400px;">
    <ProItem xs="12">
        <ProTextField Mask="@(new PatternMask("0000 0000 0000 0000"))" Label="Credit Card Number" 
                      @bind-Value="creditCard"  Variant="@Variant.Text" Clearable />
    </ProItem>
	<ProItem xs="4">
        <ProTextField Mask="@(new DateMask("MM/YY", 'Y', 'M'))" Label="Expires" 
                      @bind-Value="expiration"  Variant="@Variant.Text" />
    </ProItem>
    <ProItem xs="4"/>
	<ProItem xs="4">
        <ProTextField Mask="@(new PatternMask("000"))" Label="CVC" 
                      @bind-Value="cvc"  Variant="@Variant.Text" />
    </ProItem>
    <ProItem xs="12">
		Credit Card Number: <b>@creditCard</b><br/>
		Expiration Date: <b>@expiration</b><br/>
        CVC: <b>@cvc</b>
    </ProItem>
</ProGrid>

@code {
    private string creditCard;
    private string expiration;
    private string cvc;
}