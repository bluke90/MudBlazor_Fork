@namespace ProtonBlazor.Docs.Examples

<ProGrid Class="justify-space-between" Style="max-width: 400px;">
    <ProItem xs="12">
        <ProTextField Mask="@mask" Label="Flight number" 
                      @bind-Value="text"  Variant="@Variant.Outlined" Clearable />
    </ProItem>
    <ProItem xs="12">
		Flight number: <b>@text</b>
    </ProItem>
</ProGrid>

@code {
    public string text { get; set; }

    IMask mask = new BlockMask(delimiters:" ", new Block('a', 1,3), new Block('0', 1,4));
}