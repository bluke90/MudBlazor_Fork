@page "/customization/palette"
<DocsPage>
    <DocsPageHeader Title="Palette" SubTitle="The palette is the colors the theme uses for all the components and main layout.">
    </DocsPageHeader>
    <DocsPageSection>
        <ProText Typo="Typo.h4" Class="py-4">Default Colors</ProText>
        <ProGrid>
            <ProItem xs="12" sm="12" md="4">
                <ProPaper Class="pro-theme-primary">
                    <ProText Align="Align.Center" Class="py-16">Primary</ProText>
                    <div class="d-flex">
                        <ProPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-bl" Style="background-color: var(--pro-palette-primary-lighten); color: #fff;">
                            <ProText Align="Align.Center" Class="py-6">Lighten</ProText>
                        </ProPaper>
                        <ProPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-br" Style="background-color: var(--pro-palette-primary-darken); color: #fff;">
                            <ProText Align="Align.Center" Class="py-6">Darken</ProText>
                        </ProPaper>
                    </div>
                </ProPaper>
            </ProItem>
            <ProItem xs="12" sm="12" md="4">
                <ProPaper Class="pro-theme-secondary">
                    <ProText Align="Align.Center" Class="py-16">Secondary</ProText>
                    <div class="d-flex">
                        <ProPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-bl" Style="background-color: var(--pro-palette-secondary-lighten); color: #fff;">
                            <ProText Align="Align.Center" Class="py-6">Lighten</ProText>
                        </ProPaper>
                        <ProPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-br" Style="background-color: var(--pro-palette-secondary-darken); color: #fff;">
                            <ProText Align="Align.Center" Class="py-6">Darken</ProText>
                        </ProPaper>
                    </div>
                </ProPaper>
            </ProItem>
            <ProItem xs="12" sm="12" md="4">
                <ProPaper Class="pro-theme-tertiary">
                    <ProText Align="Align.Center" Class="py-16">Tertiary</ProText>
                    <div class="d-flex">
                        <ProPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-bl" Style="background-color: var(--pro-palette-tertiary-lighten); color: #fff;">
                            <ProText Align="Align.Center" Class="py-6">Lighten</ProText>
                        </ProPaper>
                        <ProPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-br" Style="background-color: var(--pro-palette-tertiary-darken); color: #fff;">
                            <ProText Align="Align.Center" Class="py-6">Darken</ProText>
                        </ProPaper>
                    </div>
                </ProPaper>
            </ProItem>
            <ProItem xs="12" sm="6" md="3">
                <ProPaper Class="pro-theme-info">
                    <ProText Align="Align.Center" Class="py-16">Info</ProText>
                    <div class="d-flex">
                        <ProPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-bl" Style="background-color: var(--pro-palette-info-lighten); color: #fff;">
                            <ProText Align="Align.Center" Class="py-4">Lighten</ProText>
                        </ProPaper>
                        <ProPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-br" Style="background-color: var(--pro-palette-info-darken); color: #fff;">
                            <ProText Align="Align.Center" Class="py-4">Darken</ProText>
                        </ProPaper>
                    </div>
                </ProPaper>
            </ProItem>
            <ProItem xs="12" sm="6" md="3">
                <ProPaper Class="pro-theme-success">
                    <ProText Align="Align.Center" Class="py-16">Success</ProText>
                    <div class="d-flex">
                        <ProPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-bl" Style="background-color: var(--pro-palette-success-lighten); color: #fff;">
                            <ProText Align="Align.Center" Class="py-4">Lighten</ProText>
                        </ProPaper>
                        <ProPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-br" Style="background-color: var(--pro-palette-success-darken); color: #fff;">
                            <ProText Align="Align.Center" Class="py-4">Darken</ProText>
                        </ProPaper>
                    </div>
                </ProPaper>
            </ProItem>
            <ProItem xs="12" sm="6" md="3">
                <ProPaper Class="pro-theme-warning">
                    <ProText Align="Align.Center" Class="py-16">Warning</ProText>
                    <div class="d-flex">
                        <ProPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-bl" Style="background-color: var(--pro-palette-warning-lighten); color: #fff;">
                            <ProText Align="Align.Center" Class="py-4">Lighten</ProText>
                        </ProPaper>
                        <ProPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-br" Style="background-color: var(--pro-palette-warning-darken); color: #fff;">
                            <ProText Align="Align.Center" Class="py-4">Darken</ProText>
                        </ProPaper>
                    </div>
                </ProPaper>
            </ProItem>
            <ProItem xs="12" sm="6" md="3">
                <ProPaper Class="pro-theme-error">
                    <ProText Align="Align.Center" Class="py-16">Error</ProText>
                    <div class="d-flex">
                        <ProPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-bl" Style="background-color: var(--pro-palette-error-lighten); color: #fff;">
                            <ProText Align="Align.Center" Class="py-4">Lighten</ProText>
                        </ProPaper>
                        <ProPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-br" Style="background-color: var(--pro-palette-error-darken); color: #fff;">
                            <ProText Align="Align.Center" Class="py-4">Darken</ProText>
                        </ProPaper>
                    </div>
                </ProPaper>
            </ProItem>
            <ProItem xs="12" sm="12" md="12">
                <ProPaper Class="pro-theme-dark">
                    <ProText Align="Align.Center" Class="py-6">Dark</ProText>
                    <div class="d-flex">
                        <ProPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-bl" Style="background-color: var(--pro-palette-dark-lighten); color: #fff;">
                            <ProText Align="Align.Center" Class="py-3">Lighten</ProText>
                        </ProPaper>
                        <ProPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-br" Style="background-color: var(--pro-palette-dark-darken); color: #fff;">
                            <ProText Align="Align.Center" Class="py-3">Darken</ProText>
                        </ProPaper>
                    </div>
                </ProPaper>
            </ProItem>
        </ProGrid>
        <ProText Typo="Typo.h4" Class="py-4">Texts</ProText>
        <SectionContent DarkenBackground="true">
            <ProGrid>
                <ProItem xs="12" sm="12" md="4">
                    <ProPaper Class="pa-2">
                        <ProText Align="Align.Center" Class="py-6 pro-text-primary" Style="font-size: 1.5rem;">Text Primary</ProText>
                    </ProPaper>
                </ProItem>
                <ProItem xs="12" sm="12" md="4">
                    <ProPaper Class="pa-2">
                        <ProText Align="Align.Center" Class="py-6 pro-text-secondary" Style="font-size: 1.5rem;">Text Secondary</ProText>
                    </ProPaper>
                </ProItem>
                <ProItem xs="12" sm="12" md="4">
                    <ProPaper Class="pa-2">
                        <ProText Align="Align.Center" Class="py-6 pro-text-disabled" Style="font-size: 1.5rem;">Text Disabled</ProText>
                    </ProPaper>
                </ProItem>
            </ProGrid>
        </SectionContent>
    </DocsPageSection>
</DocsPage>