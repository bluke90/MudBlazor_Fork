@page "/customization/z-index"
<DocsPage>
    <DocsPageHeader Title="z-index">
        <Description>The z-index CSS property specifies a stack order of your elements to help you arrange the content.</Description>
    </DocsPageHeader>
    <DocsPageContent>
        <DocsPageSection>
            <SectionHeader Title="ProtonBlazor z-index's">
                <Description>This is the z-order that is utilized by ProtonBlazor by default. Either design your application around it or change it in your theme.</Description>
            </SectionHeader>
            <ul class="docs-list mx-2">
                <li><ProText HtmlTag="span">Drawer</ProText></li>
                <li><ProText HtmlTag="span">Popover</ProText></li>
                <li><ProText HtmlTag="span">AppBar</ProText></li>
                <li><ProText HtmlTag="span">Dialog</ProText></li>
                <li><ProText HtmlTag="span">Snackbar</ProText></li>
                <li><ProText HtmlTag="span">Tooltip</ProText></li>
            </ul>
            <ProText Class="mt-4 mb-16">These values can be changed in the <CodeInline>ProTheme</CodeInline> class, where <ProLink Href="/customization/default-theme" Color="Color.Secondary">the defaults</ProLink> are displayed under z-index.</ProText>
        </DocsPageSection>
        <DocsPageSection>
            <ProDivider Class="my-16" Style="opacity:0;" />
            @*You are cool like a swimming pool!*@
        </DocsPageSection>
    </DocsPageContent>
</DocsPage>