@namespace ProtonBlazor.Docs.Examples

<ProTabs Outlined="true" Position="@Position" Rounded="true" Border="true"
         ApplyEffectsToContainer="true" Class="mt-8" TabPanelsClass="pa-6">
    <ProTabPanel Text="Item One">
        <ProText>Content One</ProText>
    </ProTabPanel>
    <ProTabPanel Text="Item Two">
        <ProText>Content Two</ProText>
    </ProTabPanel>
    <ProTabPanel Text="Item Three">
        <ProText>Content Three</ProText>
    </ProTabPanel>
</ProTabs>

<ProSelect Label="Tabs Position" @bind-Value="Position" Variant="Variant.Outlined">
    <ProSelectItem T="Position" Value="@Position.Top">Top</ProSelectItem>
    <ProSelectItem T="Position" Value="@Position.Start">Start</ProSelectItem>
    <ProSelectItem T="Position" Value="@Position.Left">Left</ProSelectItem>
    <ProSelectItem T="Position" Value="@Position.Right">Right</ProSelectItem>
    <ProSelectItem T="Position" Value="@Position.End">End</ProSelectItem>
    <ProSelectItem T="Position" Value="@Position.Bottom">Bottom</ProSelectItem>
</ProSelect>

@code {
    public Position Position { get; set; } = Position.Left;

    private void OnSelectedValue(Position value)
    {
        switch (value)
        {
            case Position.Top:
                Position = Position.Top;
                break;
            case Position.Start:
                Position = Position.Start;
                break;
            case Position.Left:
                Position = Position.Left;
                break;
            case Position.Right:
                Position = Position.Right;
                break;
            case Position.End:
                Position = Position.End;
                break;
            case Position.Bottom:
                Position = Position.Bottom;
                break;
        }
    }
} 
