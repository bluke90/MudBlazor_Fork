@namespace ProtonBlazor.Docs.Examples

<div class="d-flex flex-column align-center gap-3">
    <ProTabs>
        <ProTabPanel Text="Item One" />
        <ProTabPanel Text="Item Two" Visible="@_visible" />
        <ProTabPanel Text="Item Three" />
    </ProTabs>

    <ProSwitch @bind-Value="_visible" Label="Tab Two Visible" Color="Color.Primary" />
</div>

@code {
    private bool _visible = true;
}