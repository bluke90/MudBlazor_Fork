@namespace ProtonBlazor.Docs.Examples

@inject ISnackbar Snackbar

<ProButton Variant="Variant.Filled" Color="Color.Primary" @onclick="@(() => Snackbar.Add(new MarkupString($"<ul><li>Item {++count}</li><li>Item {++count}</li></ul>")))">
    Open Snackbar
</ProButton>

@code
{
    private int count = 0;
}