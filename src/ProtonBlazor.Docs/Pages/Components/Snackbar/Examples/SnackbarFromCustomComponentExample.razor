@namespace ProtonBlazor.Docs.Examples

@inject ISnackbar SnackbarService

<ProButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@OnClick">Show a snackbar with a custom component</ProButton>

@code {
    private void OnClick()
    {
        SnackbarService.Add<ProChip<T>>(new Dictionary<string, object>() {
            { "Text", "This is a snackbar with a chip!" },
            { "Color", Color.Primary }
        });
    }
}