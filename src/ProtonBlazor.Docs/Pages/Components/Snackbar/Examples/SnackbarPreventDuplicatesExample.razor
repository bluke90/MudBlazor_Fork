@namespace ProtonBlazor.Docs.Examples
@inject ISnackbar SnackbarService

<ProButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@OnClick">Prevent duplicate snackbars</ProButton>

@code {
    private void OnClick()
    {
        // We'll set all three of these snackbars to prevent duplicates and give them
        // all the same key ("protonblazor")
        var config = (SnackbarOptions options) =>
        {
            options.DuplicatesBehavior = SnackbarDuplicatesBehavior.Prevent;
        };

        // Then we try to show all three in quick succession, but only the first pops!
        SnackbarService.Add("This is the only snackbar that will be shown", configure: config, key: "protonblazor");
        SnackbarService.Add(@<span>This one has the same key</span>, configure: config, key: "protonblazor");
        SnackbarService.Add<ProChip<T>>(new Dictionary<string, object>() {
            { "Text", "This one also has the same key" }
        }, configure: config, key: "protonblazor");
    }
}
