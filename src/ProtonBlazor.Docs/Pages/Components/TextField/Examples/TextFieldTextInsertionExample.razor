@namespace ProtonBlazor.Docs.Examples

<ProTextField @ref="_textField" T="string" Label="Text insertion" Lines="3" Variant="Variant.Outlined" Text="@SampleText" HelperText="@($"Current caret position: {_currentCaretPosition}")"/>
<ProStack Row="true" Justify="Justify.Center">
    <ProButton OnClick="@GetCurrentCaretPositionAsync" Color="Color.Primary">Get caret position</ProButton>
    <ProButton OnClick="@InsertAtCurrentCaretPositionAsync" Color="Color.Primary">Insert at caret position</ProButton>
    <ProButton OnClick="@InsertAtPosition56Async" Color="Color.Primary">Insert at position 56</ProButton>
</ProStack>

@code
{
    private const string SampleText = "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.";
    private ProTextField<string> _textField;
    private int _currentCaretPosition = -1;

    private async Task GetCurrentCaretPositionAsync()
    {
        _currentCaretPosition = await _textField.GetCurrentCaretPositionAsync();
    }

    private async Task InsertAtCurrentCaretPositionAsync()
    {
        await _textField.InsertTextAtCurrentCaretPositionAsync(" [this text was inserted at caret position] ");
    }

    private async Task InsertAtPosition56Async()
    {
        await _textField.InsertTextAsync(" [this text was inserted at position 56] ", 56);
    }
}
