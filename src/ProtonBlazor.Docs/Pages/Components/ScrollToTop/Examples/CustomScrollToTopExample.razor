@namespace ProtonBlazor.Docs.Examples

<div id="another_unique_identifier" class="ma-0" style="height:300px;overflow: auto;">
    <ProPaper Elevation="0" Height="3500px" Class="d-flex flex-column justify-space-between py-6">
        <ProText Typo="Typo.h3" Align="Align.Center">Scroll inside this container</ProText>
        <ProText Typo="Typo.h3" Align="Align.Center">Some initial long text</ProText>
        <ProText Typo="Typo.h3" Align="Align.Center">Middle text</ProText>
        <ProText Typo="Typo.h3" Align="Align.Center">Bottom text</ProText>
        <ProScrollToTop TopOffset="100" 
                        Selector="#another_unique_identifier"
                        VisibleCssClass="visible absolute"
                        HiddenCssClass="hidden absolute">
            <div class="pro-theme-secondary px-3 py-6 pro-elevation-16 rounded-xl" style="bottom:20px;left:20px;">Scroll to top custom button</div>
        </ProScrollToTop>
    </ProPaper>
</div>
