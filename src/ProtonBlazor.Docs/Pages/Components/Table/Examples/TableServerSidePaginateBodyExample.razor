@using System.Net.Http.Json
@using ProtonBlazor.Examples.Data.Models
@using System.Threading
@namespace ProtonBlazor.Docs.Examples
@inject HttpClient httpClient

<ProTable ServerData="ServerReload" Dense="true" Hover="true"
    LoadingContent="@(useLoadingContentBody ? null : loadingContent)"
    LoadingContentBody="@(useLoadingContentBody ? loadingContentBody : null)">
    <ToolBarContent>
        <ProText Typo="Typo.h6">Periodic Elements</ProText>
    </ToolBarContent>
    <HeaderContent>
        <ProTh><ProTableSortLabel SortLabel="nr_field" T="Element">Nr</ProTableSortLabel></ProTh>
        <ProTh><ProTableSortLabel SortLabel="sign_field" T="Element">Sign</ProTableSortLabel></ProTh>
        <ProTh><ProTableSortLabel SortLabel="name_field" T="Element">Name</ProTableSortLabel></ProTh>
        <ProTh><ProTableSortLabel SortLabel="position_field" T="Element">Position</ProTableSortLabel></ProTh>
        <ProTh><ProTableSortLabel SortLabel="mass_field" T="Element">Molar mass</ProTableSortLabel></ProTh>
    </HeaderContent>
    <RowTemplate>
        <ProTd DataLabel="Nr">@context.Number</ProTd>
        <ProTd DataLabel="Sign">@context.Sign</ProTd>
        <ProTd DataLabel="Name">@context.Name</ProTd>
        <ProTd DataLabel="Position">@context.Position</ProTd>
        <ProTd DataLabel="Molar mass">@context.Molar</ProTd>
    </RowTemplate>
    <NoRecordsContent>
        <ProText>No records found</ProText>
    </NoRecordsContent>
    <PagerContent>
        <ProTablePager />
    </PagerContent>
</ProTable>
<ProSwitch @bind-Value="@useLoadingContentBody">Use Loading Content Body</ProSwitch>

@code {
    private bool useLoadingContentBody = true;

    private readonly RenderFragment loadingContent = @<ProSkeleton/>;
    private readonly RenderFragment loadingContentBody = @<text>
        @for (int r = 0; r < 4; r++) // 4 fake rows
        {
            <ProTr>
                @for (int c = 0; c < 5; c++) // 5 columns as above
                {
                    <ProTd><ProSkeleton/></ProTd>
                }
            </ProTr>
        }
    </text>;

    /// <summary>
    /// Here we simulate a perpetual loading for the purpose of the example.
    /// </summary>
    private async Task<TableData<Element>> ServerReload(TableState state, CancellationToken token)
    {
        while (!token.IsCancellationRequested)
        {
            await Task.Delay(1000, token);
        }
        return new TableData<Element>() { TotalItems = 0, Items = Enumerable.Empty<Element>() };
    }
}


