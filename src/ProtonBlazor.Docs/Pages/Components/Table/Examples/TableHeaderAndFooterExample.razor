@using System.Net.Http.Json
@using ProtonBlazor.Examples.Data.Models
@namespace ProtonBlazor.Docs.Examples
@inject HttpClient httpClient

<style type="text/css">
    .pro-table-head .header-centered th {
        text-align: center;
        font-size: 1.2em;
    }

   .pro-table-foot .bold-text .pro-table-cell {
       font-weight: 500;
   }
</style>

<ProTable Items="@Elements.Take(10)" MultiSelection="true" @bind-SelectedItems="selectedItems" Hover="true" Breakpoint="Breakpoint.Sm" Striped="true" Bordered="true"
          CustomHeader="true" CustomFooter="true" HeaderClass="table-head-bordered" FooterClass="table-foot-bordered">
    <HeaderContent>
        <ProTHeadRow IgnoreCheckbox="true" Class="header-centered">
            <ProTh colspan="6">Periodic Elements Info</ProTh>
        </ProTHeadRow>
        <ProTHeadRow Class="header-centered">
            <ProTh colspan="2">Basic</ProTh>
            <ProTh colspan="3">Extended</ProTh>
        </ProTHeadRow>
        <ProTHeadRow Checkable="true">
            <ProTh>Nr</ProTh> 
            <ProTh>Sign</ProTh>
            <ProTh>Name</ProTh>
            <ProTh>Position</ProTh>
            <ProTh>Molar mass</ProTh>
        </ProTHeadRow>
    </HeaderContent>
    <RowTemplate>
        <ProTd DataLabel="Nr">@context.Number</ProTd>
        <ProTd DataLabel="Sign">@context.Sign</ProTd>
        <ProTd DataLabel="Name">@context.Name</ProTd>
        <ProTd DataLabel="Position" HideSmall="_hidePosition">@context.Position</ProTd>
        <ProTd DataLabel="Molar mass">@context.Molar</ProTd>
    </RowTemplate>
    <FooterContent>
        <ProTFootRow Class="bold-text">
            <ProTd>Nr</ProTd>
            <ProTd>Sign</ProTd>
            <ProTd>Name</ProTd>
            <ProTd>Position</ProTd>
            <ProTd>Molar mass</ProTd>
        </ProTFootRow>
        <ProTFootRow Checkable="true">
            <ProTd colspan="5">Selected: @selectedItems.Count</ProTd>
        </ProTFootRow>
    </FooterContent>
</ProTable>
<ProSwitch @bind-Value="_hidePosition" Color="Color.Primary">Hide <b>position</b> when Breakpoint=Xs</ProSwitch>

@code {
    private bool _hidePosition;
    private IEnumerable<Element> Elements = new List<Element>();
    private HashSet<Element> selectedItems = new HashSet<Element>();

    protected override async Task OnInitializedAsync()
    {
        Elements = await httpClient.GetFromJsonAsync<List<Element>>("webapi/periodictable");
    }
}