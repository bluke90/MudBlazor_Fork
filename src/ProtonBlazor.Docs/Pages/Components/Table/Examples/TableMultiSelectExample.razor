@using System.Net.Http.Json
@using ProtonBlazor.Examples.Data.Models
@namespace ProtonBlazor.Docs.Examples
@inject HttpClient httpClient

<ProText HtmlTag="span">Item: @_selectedItemText</ProText>
<ProText>Selected items (@selectedItems?.Count): @(selectedItems == null ? "" : string.Join(", ", selectedItems.OrderBy(x => x.Sign).Select(x => x.Sign)))</ProText>

<ProTable @ref="_table" T="Element" Items="@Elements" MultiSelection="true" SelectionChangeable="_selectionChangeable" Hover="true"
          @bind-SelectedItems="selectedItems" OnRowClick="@OnRowClick" SelectOnRowClick="@_selectOnRowClick">
    <HeaderContent>
        <ProTh>Nr</ProTh>
        <ProTh>Sign</ProTh>
        <ProTh>Name</ProTh>
        <ProTh>Position</ProTh>
        <ProTh>Molar mass</ProTh>
    </HeaderContent>
    <RowTemplate>
        <ProTd DataLabel="Nr">@context.Number</ProTd>
        <ProTd DataLabel="Sign">@context.Sign</ProTd>
        <ProTd DataLabel="Name">@context.Name</ProTd>
        <ProTd DataLabel="Position">@context.Position</ProTd>
        <ProTd DataLabel="Molar mass">@context.Molar</ProTd>
    </RowTemplate>
    <PagerContent>
        <ProTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
    </PagerContent>
    <FooterContent>
        <ProTd colspan="5">Select All</ProTd>
    </FooterContent>
</ProTable>
<ProSwitch @bind-Value="_selectOnRowClick" Color="Color.Primary">Select on row click</ProSwitch>
<ProSwitch @bind-Value="_selectionChangeable" Color="Color.Primary">Selection is changeable</ProSwitch>

@code {
    private HashSet<Element> selectedItems = new HashSet<Element>();
    private IEnumerable<Element> Elements = new List<Element>();
    private bool _selectOnRowClick = true;
    private bool _selectionChangeable = true;
    private ProTable<Element> _table;
    private string _selectedItemText = "No row clicked";

    protected override async Task OnInitializedAsync()
    {
        Elements = await httpClient.GetFromJsonAsync<List<Element>>("webapi/periodictable");
    }

    void OnRowClick(TableRowClickEventArgs<Element> args)
    {
        _selectedItemText = $"{args.Item.Name} ({args.Item.Sign})";
    }
}
