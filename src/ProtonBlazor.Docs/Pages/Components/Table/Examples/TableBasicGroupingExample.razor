@using System.Net.Http.Json
@using ProtonBlazor.Examples.Data.Models
@namespace ProtonBlazor.Docs.Examples
@inject HttpClient httpClient

<style>
    .pro-table-cell-custom-group {
        font-weight: 500;
    }

    .pro-table-cell-custom-group-footer {
        padding-bottom: 50px;
        text-align: right;
    }
</style>

<ProTable Hover="true" Breakpoint="Breakpoint.Sm" Height="500px" FixedHeader="true"
          Items="@Elements"
          Virtualize="@_virtualize"
          GroupBy="@_groupDefinition"
          GroupHeaderStyle="background-color:var(--pro-palette-background-gray)"
          GroupFooterClass="mb-4"
          Dense="_dense"
          MultiSelection="_multiSelect">
    <ColGroup>
        @if (_multiSelect)
        {
            <col style="width: 60px;" />
        }
        @if (_groupDefinition.Expandable)
        {
            <col style="width: 60px;" />
        }
        <col />
        <col />
        <col />
        <col />
        <col />
    </ColGroup>
    <HeaderContent>
        <ProTh>Nr</ProTh>
        <ProTh>Sign</ProTh>
        <ProTh>Name</ProTh>
        <ProTh>Position</ProTh>
        <ProTh>Molar mass</ProTh>
    </HeaderContent>
    <GroupHeaderTemplate>
        <ProTh Class="pro-table-cell-custom-group" colspan="5">@($"{context.GroupName}: {context.Key}")</ProTh>
    </GroupHeaderTemplate>
    <RowTemplate>
        <ProTd DataLabel="Nr">@context.Number</ProTd>
        <ProTd DataLabel="Sign">@context.Sign</ProTd>
        <ProTd DataLabel="Name">@context.Name</ProTd>
        <ProTd DataLabel="Position">@context.Position</ProTd>
        <ProTd Style="text-align: right" DataLabel="Molar mass">@context.Molar"</ProTd>
    </RowTemplate>
    <GroupFooterTemplate>
        <ProTh Class="pro-table-cell-custom-group pro-table-cell-custom-group-footer" colspan="5">Total Mass: @context.Items.Sum((e) => e.Molar)</ProTh>
    </GroupFooterTemplate>
</ProTable>

<ProSwitch @bind-Value="_dense" Color="Color.Primary">Dense</ProSwitch>
<ProSwitch @bind-Value="_multiSelect" Color="Color.Primary">MultiSelect</ProSwitch>
<ProSwitch @bind-Value="_virtualize" Color="Color.Primary">Virtualize</ProSwitch>
<ProSwitch @bind-Value="_groupDefinition.Indentation" Color="Color.Primary">Indentation</ProSwitch>
<ProSwitch @bind-Value="_groupDefinition.Expandable" Color="Color.Primary">Expandable</ProSwitch>

@code { 
    private bool _dense = false;
    private bool _multiSelect = true;
    private bool _virtualize = false;    

    private TableGroupDefinition<Element> _groupDefinition = new()
    {
        GroupName = "Group",
        Indentation = false,
        Expandable = false,
        Selector = (e) => e.Group
    };

    private IEnumerable<Element> Elements = new List<Element>();

    protected override async Task OnInitializedAsync()
    {
        Elements = await httpClient.GetFromJsonAsync<List<Element>>("webapi/periodictable");
    }
}