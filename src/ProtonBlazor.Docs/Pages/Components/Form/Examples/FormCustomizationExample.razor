@using System.Text.RegularExpressions
@using System.ComponentModel.DataAnnotations
@namespace ProtonBlazor.Docs.Examples

<ProGrid>
    <ProItem xs="12" sm="7">
        <ProPaper Class="pa-4">
            <ProForm Spacing="spacing">
                <ProTextField T="string" Label="Username" />
                <ProTextField T="string" Label="Email" />
                <ProTextField T="string" Label="Password" HelperText="Choose a strong password" InputType="InputType.Password" />
                <ProTextField T="string" Label="Password" HelperText="Repeat the password" InputType="InputType.Password" />
                <div class="d-flex">
                    <ProRadioGroup T="string">
                        <ProRadio Value="@("Personal")">Personal</ProRadio>
                        <ProRadio Value="@("Professional")">Professional</ProRadio>
                    </ProRadioGroup>
                </div>
            </ProForm>
        </ProPaper>
    </ProItem>
    <ProItem xs="12" sm="5">
        <ProPaper Class="pa-4 pro-height-full">
            <ProSlider @bind-Value="spacing" Min="0" Max="16" ValueLabel>Spacing between items</ProSlider>
        </ProPaper>
    </ProItem>
</ProGrid>

@code {
    int spacing;
}
