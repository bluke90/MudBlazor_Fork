@namespace ProtonBlazor.Docs.Examples

@inject IDialogService DialogService

<ProButton @onclick="OpenDialogAsync" Variant="Variant.Filled" Color="Color.Primary">
    Open custom styled dialog
</ProButton>

@code {
    private Task OpenDialogAsync()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true };

        return DialogService.ShowAsync<DialogStylingExample_Dialog>("Styling Example Dialog", options);
    }
}
