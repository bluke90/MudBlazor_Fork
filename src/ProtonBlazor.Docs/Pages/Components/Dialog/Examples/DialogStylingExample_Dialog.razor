@namespace ProtonBlazor.Docs.Examples

<ProDialog Class="blur dialog-background" TitleClass="blur dialog-background-title" ContentClass="dialog-background-surface py-10" ActionsClass="dialog-background-surface">
    <DialogContent>
        Dialog Content
    </DialogContent>
    <DialogActions>
        <ProButton Color="Color.Error" OnClick="Cancel">Cancel</ProButton>
        <ProButton Color="Color.Primary" OnClick="Submit">OK</ProButton>
    </DialogActions>
</ProDialog>

<style>
    .blur {
        backdrop-filter: blur(10px);
    }

    .dialog-background {
        background-color: transparent;
    }

    .dialog-background-title {
        background: rgba(var(--pro-palette-info-rgb), 0.5);
        color: var(--pro-palette-white);
    }

    .dialog-background-surface {
        background: rgba(var(--pro-palette-surface-rgb), 0.75);
    }
</style>

@code {
    [CascadingParameter]
    private IMudDialogInstance ProDialog { get; set; }

    private void Submit() => ProDialog.Close(DialogResult.Ok(true));

    private void Cancel() => ProDialog.Cancel();
}
