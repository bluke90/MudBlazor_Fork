@namespace ProtonBlazor.Docs.Examples

<ProTimeline>
    <ProTimelineItem Color="Color.Info" Size="Size.Small">
        <ItemOpposite>
            <ProText Color="Color.Info" Typo="Typo.h5">1970</ProText>
        </ItemOpposite>
        <ItemContent>
            <ProText Color="Color.Info" Typo="Typo.h6" GutterBottom="true">Atom Towns</ProText>
            <ProText>Construction of the town of Pripyat, one of 9 “atom towns” begins, to be inhabited by future employees of the nuclear power plants.</ProText>
        </ItemContent>
    </ProTimelineItem>
    <ProTimelineItem Color="Color.Success" Size="Size.Small">
        <ItemOpposite>
            <ProText Color="Color.Success" Typo="Typo.h5">1977</ProText>
        </ItemOpposite>
        <ItemContent>
            <ProText Color="Color.Success" Typo="Typo.h6" GutterBottom="true">Operational</ProText>
            <ProText>The first of the Chernobyl Nuclear Power Plants four reactors is ready to operate followed by number 2 in 1978.</ProText>
        </ItemContent>
    </ProTimelineItem>
    <ProTimelineItem Color="Color.Error" Size="Size.Small">
        <ItemOpposite>
            <ProText Color="Color.Error" Typo="Typo.h5">1979</ProText>
        </ItemOpposite>
        <ItemContent>
            <ProText Color="Color.Error" Typo="Typo.h6" GutterBottom="true">Pripyat</ProText>
            <ProText>Pripyat officially proclaimed as a city.<br />The Chernobyl Atomic Power Station reaches its first 10 billion kilowatt-hours of electical output.</ProText>
        </ItemContent>
    </ProTimelineItem>
</ProTimeline>