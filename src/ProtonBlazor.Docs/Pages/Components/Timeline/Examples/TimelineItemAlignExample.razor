@namespace ProtonBlazor.Docs.Examples

<ProTimeline>
    <ProTimelineItem Color="Color.Info">
        <ProText Typo="Typo.button">Packaging Process Started</ProText>
        <ProText Typo="Typo.body2" Class="pro-text-secondary">Yesterday: 16:33</ProText>
    </ProTimelineItem>
    <ProTimelineItem TimelineAlign="TimelineAlign.End">
        <ProText Typo="Typo.body2">Packaging complete</ProText>
        <ProText Typo="Typo.body2" Class="pro-text-secondary">Yesterday: 17:10</ProText>
    </ProTimelineItem>
    <ProTimelineItem TimelineAlign="TimelineAlign.End">
        <ProText Typo="Typo.body2">Waiting for pickup</ProText>
        <ProText Typo="Typo.body2" Class="pro-text-secondary">Yesterday: 17:15</ProText>
    </ProTimelineItem>
    <ProTimelineItem Color="Color.Error">
        <ProAlert Severity="Severity.Error">Package missed last pickup time.</ProAlert>
    </ProTimelineItem>
    <ProTimelineItem Color="Color.Success">
        <ProText Typo="Typo.button">Package picked up by driver</ProText>
        <ProText Typo="Typo.body2" Class="pro-text-secondary">Today: 17:00</ProText>
    </ProTimelineItem>
    <ProTimelineItem TimelineAlign="TimelineAlign.End">
        <ProText Typo="Typo.button">Package In Transit</ProText>
    </ProTimelineItem>
</ProTimeline>