@namespace ProtonBlazor.Docs.Examples

<ProGrid>
    <ProItem xs="12" sm="5">
        <ProSelect T="TimelineOrientation" ValueChanged="OnOrientationChange" Label="TimelineOrientation" Dense="true" Variant="Variant.Outlined">
            <ProSelectItem T="TimelineOrientation" Value="TimelineOrientation.Vertical">Vertical</ProSelectItem>
            <ProSelectItem T="TimelineOrientation" Value="TimelineOrientation.Horizontal">Horizontal</ProSelectItem>
        </ProSelect>
    </ProItem>
    <ProItem xs="12" sm="5">
        <ProSelect T="TimelinePosition" @bind-Value="_position" Label="TimelinePosition" Dense="true" Variant="Variant.Outlined">
            @if(_orientation == TimelineOrientation.Vertical)
            {
                <ProSelectItem T="TimelinePosition" Value="TimelinePosition.Start">Start</ProSelectItem>
                <ProSelectItem T="TimelinePosition" Value="TimelinePosition.Left">Left</ProSelectItem>
                <ProSelectItem T="TimelinePosition" Value="TimelinePosition.Alternate">Alternate</ProSelectItem>
                <ProSelectItem T="TimelinePosition" Value="TimelinePosition.Right">Right</ProSelectItem>
                <ProSelectItem T="TimelinePosition" Value="TimelinePosition.End">End</ProSelectItem>
            }
            else if(_orientation == TimelineOrientation.Horizontal)
            {
                <ProSelectItem T="TimelinePosition" Value="TimelinePosition.Top">Top</ProSelectItem>
                <ProSelectItem T="TimelinePosition" Value="TimelinePosition.Alternate">Alternate</ProSelectItem>
                <ProSelectItem T="TimelinePosition" Value="TimelinePosition.Bottom">Bottom</ProSelectItem>
            }
        </ProSelect>
    </ProItem>
    <ProItem xs="12" sm="2">
        <ProSwitch Label="Reverse" @bind-Value="_reverse" Disabled="IsSwitchDisabled()" Color="Color.Primary" />
    </ProItem>
</ProGrid>

<ProTimeline TimelineOrientation="_orientation" TimelinePosition="_position" Reverse="_reverse">
    <ProTimelineItem Color="Color.Success" Variant="Variant.Filled">
        <ItemContent>
            <ProAlert Severity="Severity.Success">The reactor is running at optimum temperature</ProAlert>
        </ItemContent>
        <ItemOpposite>
            <ProText Color="Color.Success">13:37</ProText>
        </ItemOpposite>
    </ProTimelineItem>
    <ProTimelineItem Color="Color.Warning" Variant="Variant.Filled">
        <ItemContent>
            <ProAlert Severity="Severity.Warning">The reactor temperature exceeds the optimal range</ProAlert>
        </ItemContent>
        <ItemOpposite>
            <ProText Color="Color.Warning">14:08</ProText>
        </ItemOpposite>
    </ProTimelineItem>
    <ProTimelineItem Color="Color.Error" Variant="Variant.Filled">
        <ItemContent>
            <ProAlert Severity="Severity.Error">Meltdown is imminent</ProAlert>
        </ItemContent>
        <ItemOpposite>
            <ProText Color="Color.Error">15:00</ProText>
        </ItemOpposite>
    </ProTimelineItem>
</ProTimeline>


@code {
    private TimelinePosition _position { get; set; } = TimelinePosition.Start;
    private TimelineOrientation _orientation { get; set; } = TimelineOrientation.Vertical;
    private bool _reverse { get; set; }

    private void OnOrientationChange(TimelineOrientation value)
    {
        _orientation = value;
        switch (value)
        {
            case TimelineOrientation.Vertical:
                if (_position is TimelinePosition.Top or TimelinePosition.Bottom)
                    _position = TimelinePosition.Start;
                break;
            case TimelineOrientation.Horizontal:
                if (_position is TimelinePosition.Start or TimelinePosition.Left or TimelinePosition.Right or TimelinePosition.End)
                    _position = TimelinePosition.Top;
                break;
        }
    }

    bool IsSwitchDisabled()
    {
        if (_position == TimelinePosition.Alternate)
            return false;
        else
            _reverse = false;
        return true;
    }
}