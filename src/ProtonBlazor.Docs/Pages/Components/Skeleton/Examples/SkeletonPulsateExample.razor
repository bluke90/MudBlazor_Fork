
@namespace ProtonBlazor.Docs.Examples


<ProCard>
    <ProSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px"/>
    <ProCardContent>
        <ProSkeleton Width="30%" Height="42px;" />
        <ProSkeleton Width="80%" />
        <ProSkeleton Width="100%" />
    </ProCardContent>
    <ProCardActions>
        <ProSkeleton Width="64px" Height="40px" Class="ml-2" />
        <ProSkeleton Width="105px" Height="40px" Class="ml-3" />
    </ProCardActions>
</ProCard>

<ProCard>
    <ProCardMedia Image="images/door.jpg" Height="200" />
    <ProCardContent>
        <ProText Typo="Typo.h5">Old Paint</ProText>
        <ProText Typo="Typo.body2">Old paint found on a stone house door.</ProText>
        <ProText Typo="Typo.body2">This photo was taken in a small village in Istra Croatia.</ProText>
    </ProCardContent>
    <ProCardActions>
        <ProButton Variant="Variant.Text" Color="Color.Primary">Share</ProButton>
        <ProButton Variant="Variant.Text" Color="Color.Primary">Learn more</ProButton>
    </ProCardActions>
</ProCard>