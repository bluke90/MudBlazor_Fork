﻿@using System.Net.Http.Json
@using ProtonBlazor.Examples.Data.Models
@using System.Linq
@namespace ProtonBlazor.Docs.Examples
@inject HttpClient httpClient

<ProDataGrid T="Element" Items="@Elements.Take(10)" MultiSelection="true" SelectedItemsChanged="@SelectedItemsChanged">
    <Columns>
        <SelectColumn DisabledFunc="@(item => item.Number % 5 == 0)" AriaLabelFunc="@(item => $"Select {item.Name}")" />
        <PropertyColumn Property="x => x.Number" Title="Nr" />
        <PropertyColumn Property="x => x.Sign" />
        <PropertyColumn Property="x => x.Name" />
        <PropertyColumn Property="x => x.Position" />
        <PropertyColumn Property="x => x.Molar" Title="Molar mass" />
    </Columns>
</ProDataGrid>

@if (_selectedItems != null && _selectedItems.Any())
{
    <ProText Typo="Typo.subtitle1" Class="mt-4">Selected Items:</ProText>
    foreach (var item in _selectedItems)
    {
        <ProText Typo="Typo.body2">@item.Name</ProText>
    }
}
else
{
    <ProText Typo="Typo.body2" Class="mt-4">No items selected.</ProText>
}

@code {
    private IEnumerable<Element> Elements = new List<Element>();
    private HashSet<Element> _selectedItems = new HashSet<Element>();

    protected override async Task OnInitializedAsync()
    {
        Elements = await httpClient.GetFromJsonAsync<List<Element>>("webapi/periodictable");
    }

    private void SelectedItemsChanged(HashSet<Element> items)
    {
        _selectedItems = items;
    }
}
