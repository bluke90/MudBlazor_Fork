@using System.Net.Http.Json
@using ProtonBlazor.Examples.Data.Models
@namespace ProtonBlazor.Docs.Examples
@inject HttpClient httpClient

<ProDataGrid T="Element" Items="@Elements" SortMode="@_sortMode">
    <Columns>
        <PropertyColumn Property="x => x.Number" Title="Nr" Sortable="false" />
        <PropertyColumn Property="x => x.Sign" />
        <PropertyColumn Property="x => x.Name" SortBy="@_sortBy" />
        <PropertyColumn Property="x => x.Position" />
        <PropertyColumn Property="x => x.Molar" Title="Molar mass" />
        <PropertyColumn Property="x => x.Group" Title="Category" />
        <TemplateColumn Title="Custom" SortBy="@(x => $"{x.Sign} - {x.Name}")">
            <CellTemplate>
                @context.Item.Sign - @context.Item.Name
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <ProDataGridPager T="Element" />
    </PagerContent>
</ProDataGrid>

<div class="d-flex flex-wrap mt-4">
    <ProSwitch @bind-Value="_sortNameByLength" Color="Color.Primary">Sort Name Column By Length</ProSwitch>
    <ProRadioGroup T=SortMode @bind-Value="@_sortMode">
        <ProRadio Dense=true Value=@SortMode.Multiple Color="Color.Primary">Multiple</ProRadio>
        <ProRadio Dense=true Value=@SortMode.Single Color="Color.Tertiary">Single</ProRadio>
        <ProRadio Dense=true Value=@SortMode.None>None</ProRadio>
    </ProRadioGroup>
</div>


@code {
    private IEnumerable<Element> Elements = new List<Element>();
    private bool _sortNameByLength;
    private SortMode _sortMode = SortMode.Multiple;

    // custom sort by name length
    private Func<Element, object> _sortBy => x =>
    {
        if (_sortNameByLength)
            return x.Name.Length;
        else
            return x.Name;
    };

    protected override async Task OnInitializedAsync()
    {
        Elements = await httpClient.GetFromJsonAsync<List<Element>>("webapi/periodictable");
    }
}
