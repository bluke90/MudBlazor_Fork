@using System.Net.Http.Json
@using ProtonBlazor.Examples.Data.Models
@namespace ProtonBlazor.Docs.Examples
@inject HttpClient httpClient

<ProDataGrid @ref="_dataGrid" Items="@Elements" ReadOnly="@_isReadOnly" EditMode="@DataGridEditMode.Cell" ExpandSingleRow="_expandSingleRow">
    <Columns>
        <HierarchyColumn T="Element" ButtonDisabledFunc="@(x => x.Sign == "He")" InitiallyExpandedFunc="@(x => x.Sign == "Li")" EnableHeaderToggle="@_enableHeaderToggle" />
        <PropertyColumn Property="x => x.Number" Title="Nr" />
        <PropertyColumn Property="x => x.Sign" />
        <PropertyColumn Property="x => x.Name" />
        <PropertyColumn Property="x => x.Position" />
        <PropertyColumn Property="x => x.Molar" Title="Molar mass" />
    </Columns>
    <ChildRowContent>
        <ProCard>
            <ProCardHeader>
                <CardHeaderContent>
                    <ProText Typo="Typo.h6">@context.Item.Name</ProText>
                </CardHeaderContent>
            </ProCardHeader>
            <ProCardContent>
                <ProText>This element is number @context.Item.Number</ProText>
                <ProText>This element has a molar mass of @context.Item.Molar</ProText>
            </ProCardContent>
        </ProCard>
    </ChildRowContent>
    <PagerContent>
        <ProDataGridPager T="Element" />
    </PagerContent>
</ProDataGrid>

<div class="d-flex flex-wrap mt-4">
    <ProSwitch T="bool" @bind-Value="_isReadOnly" Color="@Color.Primary">Read Only</ProSwitch>
    <ProButton OnClick="@ExpandAll" Color="@Color.Primary">Expand all</ProButton>
    <ProButton OnClick="@CollapseAll" Color="@Color.Primary">Collapse all</ProButton>
    <ProSwitch @bind-Value="@_enableHeaderToggle" Label="Enable header toggle" Color="@Color.Primary" />
    <ProSwitch @bind-Value="@_expandSingleRow" Label="Expand single row" Color="@Color.Primary" />
</div>

@code {

    private bool _isReadOnly = true;
    private bool _expandSingleRow = false;
    private bool _enableHeaderToggle = false;
    private ProDataGrid<Element> _dataGrid = null!;
    private IEnumerable<Element> Elements = new List<Element>();

    protected override async Task OnInitializedAsync()
    {
        Elements = await httpClient.GetFromJsonAsync<List<Element>>("webapi/periodictable");
    }

    private Task ExpandAll()
    {
        return _dataGrid.ExpandAllHierarchy();
    }

    private Task CollapseAll()
    {
        return _dataGrid.CollapseAllHierarchy();
    }
}
