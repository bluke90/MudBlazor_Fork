@namespace ProtonBlazor.Docs.Examples

<ProPaper Height="200px" Class="pro-theme-primary" Style="overflow:hidden; position:relative;">
    <ProDrawerContainer Class="pro-height-full">
        <ProDrawer @bind-Open="@_openStart" Anchor="Anchor.Start" Elevation="0" Variant="@DrawerVariant.Persistent">
            <ProDrawerHeader>
                <ProText Typo="Typo.h6">My App</ProText>
            </ProDrawerHeader>
            <ProNavMenu>
                <ProNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Store">Store</ProNavLink>
                <ProNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.LocalLibrary">Library</ProNavLink>
                <ProNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Forum">Community</ProNavLink>
            </ProNavMenu>
        </ProDrawer>
        <ProDrawer @bind-Open="@_openEnd" Fixed="false" Anchor="Anchor.End" Elevation="0" Variant="@DrawerVariant.Persistent">
            <ProDrawerHeader>
                <ProText Typo="Typo.h6">Settings</ProText>
            </ProDrawerHeader>
            <ProNavMenu>
                <ProNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.AccountBox">Profile</ProNavLink>
                <ProNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ShoppingCart">Orders</ProNavLink>
                <ProNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.History">Order History</ProNavLink>
            </ProNavMenu>
        </ProDrawer>
        <div class="d-flex justify-center align-center pro-height-full">
            <ProButton Color="Color.Inherit" OnClick="@ToggleStartDrawer" StartIcon="@(Rtl ? Icons.Material.Filled.East : Icons.Material.Filled.West)" Class="mx-2">Toggle start</ProButton>
            <ProButton Color="Color.Inherit" OnClick="@ToggleEndDrawer" EndIcon="@(Rtl ? Icons.Material.Filled.West : Icons.Material.Filled.East)" Class="mx-2">Toggle end</ProButton>
        </div>
    </ProDrawerContainer>
</ProPaper>

@code
{
    private bool _openStart = false;
    private bool _openEnd = false;

    [CascadingParameter]
    public bool Rtl { get; set; }

    private void ToggleStartDrawer()
    {
        _openStart = !_openStart;
    }

    private void ToggleEndDrawer()
    {
        _openEnd = !_openEnd;
    }
}
