@namespace ProtonBlazor.Docs.Examples

<ProSelect T="double" Label="Price (Datatype: double)" Clearable="true" Required="true">
    @foreach (var price in prices)
    {
    <ProSelectItem Value="@price" />
    }
</ProSelect>

<ProSelect T="double?" Label="Price (Datatype: double?)" Clearable="true" Required="true">
    @foreach (double? price in prices)
    {
    <ProSelectItem Value="@price" />
    }
</ProSelect>

@code
{
    private double[] prices = { 4.50, 4.99, 3.60, 21.99 };
}
