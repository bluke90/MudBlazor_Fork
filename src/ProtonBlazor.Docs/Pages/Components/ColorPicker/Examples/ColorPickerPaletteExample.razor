@namespace ProtonBlazor.Docs.Examples
@using ProtonBlazor.Utilities

<ProColorPicker PickerVariant="PickerVariant.Static" ColorPickerView="ColorPickerView.Palette" Palette="_customPalette" />

@code {
    private readonly IEnumerable<ProColor> _customPalette = new List<IEnumerable<ProColor>>
    {
        ProColor.GenerateTintShadePalette("#DC143C", shadeStep: 0),
        ProColor.GenerateTintShadePalette("#1E90FF", tintStep: 0),
        // Reverse for illustrative purposes
        ProColor.GenerateTintShadePalette("#8E24AA").Reverse(),
        ProColor.GenerateAnalogousPalette("#40E0D0"),
        ProColor.GenerateGradientPalette("#1E90FF", "#32CD32"),
        ProColor.GenerateMultiGradientPalette(["#FF4500", "#32CD32", "#8A2BE2"])
    }.SelectMany(palette => palette);
}