@namespace ProtonBlazor.Docs.Examples

<ProButton OnClick="@AddMoreContent" Color="Color.Error">Add another line</ProButton>
@foreach (var item in _content)
{
	<ProText Class="pa-2" Align="Align.Center">@item</ProText>
}

@code {

	private List<String> _content = new();

	public void AddMoreContent()
	{
		_content.Add("line of text");
	}
}