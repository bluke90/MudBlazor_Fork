@namespace ProtonBlazor.Docs.Examples


<div Class="d-flex justify-space-around flex-wrap mt-4">
    <ProBadge Content="3" Overlap="true" Class="mx-6 my-4">
        <ProIcon Icon="@Icons.Material.Filled.Email" Color="Color.Default" />
    </ProBadge>
    <ProBadge Content="100" Color="Color.Primary" Overlap="true" Class="mx-6 my-4">
        <ProIcon Icon="@Icons.Material.Filled.Email" Color="Color.Default" />
    </ProBadge>
    <ProBadge Icon="@Icons.Material.Filled.Lock" Color="Color.Error" Overlap="true" Bordered="true" Class="mx-6 my-4">
        <ProButton Color="Color.Error" Variant="Variant.Filled" DropShadow="false">Security Issues</ProButton>
    </ProBadge>
    <ProBadge Dot="true" Color="Color.Info" Class="mx-6 my-4">
        <ProText>Bug Reports</ProText>
    </ProBadge>
</div>
