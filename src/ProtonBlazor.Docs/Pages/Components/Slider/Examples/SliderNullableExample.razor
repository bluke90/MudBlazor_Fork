@namespace ProtonBlazor.Docs.Examples

<ProSlider T="int" @bind-Value="@_value" @bind-NullableValue="@_nullableValue" />
<div class="d-flex flex-column align-center">
    <ProText Class="pb-4">@_value</ProText>
    <ProText Class="pb-4">Nullable Value: @(_nullableValue is null ? "null" : _nullableValue)</ProText>
    <ProButton @onclick="Reset" Variant="Variant.Filled" Color="Color.Primary">Reset to null</ProButton>
</div>

@code {
    private int _value;
    private int? _nullableValue;

    private void Reset() => _nullableValue = null;
}
