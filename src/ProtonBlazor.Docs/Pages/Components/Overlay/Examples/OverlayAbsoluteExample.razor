@namespace ProtonBlazor.Docs.Examples

<ProPaper Class="pa-8" Style="height: 300px; position: relative;">
    <ProButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="@(e => ToggleOverlay(true))">Show overlay</ProButton>

    <ProOverlay Visible="visible" DarkBackground="true" Absolute="true">
        <ProButton Variant="Variant.Filled" Color="Color.Primary"  OnClick="@(e => ToggleOverlay(false))">Hide overlay</ProButton>
    </ProOverlay>
</ProPaper>



@code {
    private bool visible;

    public void ToggleOverlay(bool value)
    {
        visible = value;
    }
} 
