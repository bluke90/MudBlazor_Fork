@namespace ProtonBlazor.Docs.Examples

<ProButton Variant="Variant.Filled" Color="Color.Tertiary" OnClick="OpenOverlay">Show overlay</ProButton>

<ProOverlay @bind-Visible="_visible" DarkBackground="true" ZIndex="@(_setZIndex ? 9999 : 5)" AutoClose="true"/>

<div>
    <ProSwitch @bind-Value="_withPopover" Label="With Popover" />
    @if (_withPopover)
    {
        <ProPopover Open="_visible" AnchorOrigin="Origin.BottomLeft">
            <ProText Typo="Typo.h6">This Is a Popover</ProText>
        </ProPopover>
    }
</div>
<ProSwitch @bind-Value="_setZIndex" Label="Set ZIndex to 9999" />

@code {
    private bool _visible;
    private bool _setZIndex = true;
    private bool _withPopover;

    public void OpenOverlay()
    {
        _visible = true;
    }
} 
