@namespace ProtonBlazor.Docs.Examples

<ProCheckBox @bind-Value="value" Color="@Color.Primary">
    Value: @(value == null ? "null" : value.ToString())
</ProCheckBox>
<ProButton OnClick="@(()=>value=null)">Reset</ProButton>
<ProCheckBox @bind-Value="anotherValue" Color="@Color.Secondary" TriState="true">Checkbox with TriState. Value: @(anotherValue == null ? "null" : anotherValue.ToString())</ProCheckBox>

@code {
    public bool? value { get; set; } = null;
    public bool? anotherValue { get; set;} = null;
}