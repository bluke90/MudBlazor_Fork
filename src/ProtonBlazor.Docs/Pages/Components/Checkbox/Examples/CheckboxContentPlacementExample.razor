@namespace ProtonBlazor.Docs.Examples

<ProGrid>
    <ProItem xs="12" md="1">
        <ProRadioGroup @bind-Value="Placement">
            <ProStack AlignItems="AlignItems.Start" Justify="Justify.FlexStart">
                <ProRadio Color="Color.Primary" Value="@(Placement.Top)">Top</ProRadio>
                <ProRadio Color="Color.Primary" Value="@(Placement.Bottom)">Bottom</ProRadio>
                <ProRadio Color="Color.Primary" Value="@(Placement.Start)">Start</ProRadio>
                <ProRadio Color="Color.Primary" Value="@(Placement.End)">End</ProRadio>
                <ProRadio Color="Color.Primary" Value="@(Placement.Left)">Left</ProRadio>
                <ProRadio Color="Color.Primary" Value="@(Placement.Right)">Right</ProRadio>
            </ProStack>
        </ProRadioGroup>
    </ProItem>
    <ProItem xs="12" md="9" Class="d-flex justify-center align-center my-auto">
        <ProCheckBox T="string" Label="Test" LabelPlacement="@Placement" Color="Color.Secondary" />
    </ProItem>
    <ProItem xs="12" md="2" Style="width:100%"></ProItem>
</ProGrid>

@code {
    public Placement Placement { get; set; } = Placement.Right;
}