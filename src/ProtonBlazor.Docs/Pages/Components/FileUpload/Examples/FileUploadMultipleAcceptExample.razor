@namespace ProtonBlazor.Docs.Examples

<ProGrid>
    <ProItem md="12">
        <ProStack Row Wrap="Wrap.Wrap" Spacing="8" AlignItems="AlignItems.Center">
            <ProText Typo="Typo.h6">Multiple files</ProText>
            <ProFileUpload @ref="@_fileUploadMultiple" 
                           @bind-Files="_filesMultiple" 
                           SelectedTemplate="@(files => builder => { })"
                           AppendMultipleFiles />

            <ProText Typo="Typo.h6">Single .pdf file</ProText>
            <ProFileUpload @ref="@_fileUploadPDF"
                           T="IBrowserFile"
                           Accept=".pdf"
                           @bind-Files="_filesPDF"
                           SelectedTemplate="@(files => builder => { })" />

            <ProText Typo="Typo.h6">Images only</ProText>
            <ProFileUpload @ref="@_fileUploadImages" 
                           @bind-Files="_filesImages" 
                           Accept=".png, .jpg, .tiff" 
                           AppendMultipleFiles 
                           MaximumFileCount="100">
                <CustomContent>
                    <ProButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="@context.OpenFilePickerAsync"
                               StartIcon="@Icons.Material.Filled.CloudUpload">
                        Choose images
                    </ProButton>
                </CustomContent>
                <SelectedTemplate />
            </ProFileUpload>
        </ProStack>
    </ProItem>

    <ProItem xs="12">
        <ProPaper Class="pa-4">
            <ProStack Spacing="2">
                <ProExpansionPanels Elevation="0">
                    <ProExpansionPanel Class="bold" Text="@($"({_files.Count}) files")" Expanded="false">
                        @if (_files.Any())
                        {
                            <ProList T="IBrowserFile" Dense="true">
                                @foreach (var file in _files)
                                {
                                    <ProListItem T="IBrowserFile" Value="file" @key="@file">
                                        <ProStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="1" Class="w-100">
                                            <ProText>@file.Name (@($"{file.Size / 1024d:N1} kB"))</ProText>
                                            <ProIconButton Icon="@Icons.Material.Filled.Close"
                                                           Color="Color.Default"
                                                           Size="Size.Small"
                                                           Disabled="_uploading"
                                                           aria-label="Remove file"
                                                           OnClick="@(() => RemoveFileFromUploadsAsync(file))" />
                                        </ProStack>
                                    </ProListItem>
                                }
                            </ProList>
                        }
                        else
                        {
                            <ProText Typo="Typo.body2">No files selected.</ProText>
                        }
                    </ProExpansionPanel>
                </ProExpansionPanels>

                <ProButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="!_files.Any() || _uploading"
                           OnClick="UploadFilesAsync"
                           StartIcon="@Icons.Material.Filled.CloudUpload">
                    Upload
                </ProButton>

                @if (_uploading || _progress > 0)
                {
                    <ProProgressLinear Color="Color.Primary"
                                       Value="_progress"
                                       Indeterminate="_uploading && _files.Count == 0" />
                    <ProText Typo="Typo.caption">@_statusText</ProText>
                }
            </ProStack>
        </ProPaper>
    </ProItem>
</ProGrid>

@code
{
#nullable enable
    private IReadOnlyList<IBrowserFile> _filesMultiple = [];
    private IBrowserFile? _filesPDF; 
    private IReadOnlyList<IBrowserFile> _filesImages = [];
    private IList<IBrowserFile> _files => (_filesMultiple ?? Enumerable.Empty<IBrowserFile>())
        .Concat(_filesPDF != null ? new[] { _filesPDF } : Enumerable.Empty<IBrowserFile>()) 
        .Concat(_filesImages ?? Enumerable.Empty<IBrowserFile>())
        .ToList();

    private ProFileUpload<IReadOnlyList<IBrowserFile>> _fileUploadMultiple = default!;
    private ProFileUpload<IBrowserFile> _fileUploadPDF = default!;
    private ProFileUpload<IReadOnlyList<IBrowserFile>> _fileUploadImages = default!;

    private bool _uploading;
    private int _progress;
    private string _statusText = "Waiting for files.";

    private async Task UploadFilesAsync()
    {
        if (!_files.Any())
        {
            _statusText = "No files to upload.";
            return;
        }

        // Create a snapshot of the files to avoid altering the collection during iteration
        var filesSnapshot = _files.ToList();

        _uploading = true;
        _progress = 0;
        _statusText = "Uploading...";

        var total = filesSnapshot.Count;
        for (var index = 0; index < total; index++)
        {
            var file = filesSnapshot[index];
            await Task.Delay(1000); // Simulate file upload
            _progress = (int)Math.Round((index + 1d) / total * 100);
            _statusText = index + 1 == total ? "Upload complete." : $"Uploading {index + 1} of {total}...";
            await RemoveFileFromUploadsAsync(file);
            await InvokeAsync(StateHasChanged);
        }

        _uploading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveFileFromUploadsAsync(IBrowserFile file)
    {
        var fileUploads = new object[] { _fileUploadMultiple, _fileUploadPDF, _fileUploadImages };

        foreach (var fileUpload in fileUploads)
        {
            if (fileUpload is ProFileUpload<IReadOnlyList<IBrowserFile>> multipleUpload && await multipleUpload.RemoveFileAsync(file))
            {
                return; // File removed from multiple files upload
            }

            if (fileUpload is ProFileUpload<IBrowserFile> singleUpload && await singleUpload.RemoveFileAsync(file))
            {
                return; // File removed from single file upload
            }
        }
    }
}
