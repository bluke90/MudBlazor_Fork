@namespace ProtonBlazor.Docs.Examples

<ProStack Row Justify="Justify.SpaceAround" AlignItems="AlignItems.Start" Class="pro-width-full">
    <ProFileUpload @bind-Files=@_file>
        <CustomContent>
            <ProButton Variant="Variant.Filled"
                       OnClick="@context.OpenFilePickerAsync"
                       Color="Color.Primary">
                Default template
            </ProButton>
        </CustomContent>
    </ProFileUpload>

    <ProFileUpload T="IBrowserFile">
        <CustomContent>
            <ProButton Variant="Variant.Filled"
                       OnClick="@context.OpenFilePickerAsync"
                       Color="Color.Primary">
                Single file
            </ProButton>
        </CustomContent>
        <SelectedTemplate>
            @if (context != null)
            {
                <ProText>@context.Name</ProText>
            }
            else
            {
                <ProText>No file selected</ProText>
            }
        </SelectedTemplate>
    </ProFileUpload>

    <ProFileUpload @bind-Files=@_files>
        <CustomContent>
            <ProButton Variant="Variant.Filled"
                       OnClick="@context.OpenFilePickerAsync"
                       Color="Color.Secondary">
                Multiple files
            </ProButton>
        </CustomContent>
        <SelectedTemplate>
            @if (context != null)
            {
                @foreach (var file in context)
                {
                    <ProText>@file.Name</ProText>
                }
            }
            else
            {
                <ProText>No files selected</ProText>
            }
        </SelectedTemplate>
    </ProFileUpload>

    <ProFileUpload @bind-Files=@_file>
        <CustomContent>
            <ProFab Color="Color.Warning"
                    StartIcon="@Icons.Material.Filled.Image"
                    OnClick="@context.OpenFilePickerAsync"
                    Label="No template" />
        </CustomContent>
        <SelectedTemplate />
    </ProFileUpload>
</ProStack>

@code
{
    private IBrowserFile _file = new DummyBrowserFile("test.jpg", DateTimeOffset.Now, 1024, "image/jpeg", new byte[1024]);
    private IReadOnlyList<IBrowserFile> _files =
    [
        new DummyBrowserFile("test1.jpg", DateTimeOffset.Now, 1024, "image/jpeg", []),
        new DummyBrowserFile("test2.jpg", DateTimeOffset.Now, 1024, "image/jpeg", []),
    ];

    public class DummyBrowserFile : IBrowserFile
    {
        public string Name { get; }
        public DateTimeOffset LastModified { get; }
        public long Size { get; }
        public string ContentType { get; }
        public byte[] Content { get; }

        public DummyBrowserFile(string name, DateTimeOffset lastModified, long size, string contentType, byte[] content)
        {
            Name = name;
            LastModified = lastModified;
            Size = size;
            ContentType = contentType;
            Content = content;
        }

        public Stream OpenReadStream(long maxAllowedSize = 512000, CancellationToken cancellationToken = default) => new MemoryStream(Content);
    }
}
