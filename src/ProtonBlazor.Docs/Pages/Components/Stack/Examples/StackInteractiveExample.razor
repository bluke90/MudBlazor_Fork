@namespace ProtonBlazor.Docs.Examples

<ProPaper Outlined="true" Class="border-dashed">
    <ProStack Justify="@justify" AlignItems="@align" StretchItems="@stretch" Row="@row" Reverse="@reverse" Spacing="@spacing" Style="height:300px;">
        <ProPaper Class="py-1 px-3 pro-theme-primary">Item 1</ProPaper>
        <ProPaper Class="py-3 px-3 pro-theme-primary">Item 2</ProPaper>
        <ProPaper Class="py-5 px-3 pro-theme-primary">Item 3</ProPaper>
    </ProStack>
</ProPaper>

<ProStack Row="true" AlignItems="AlignItems.Center">
    <ProSwitch @bind-Value="row" Label="Row" Color="Color.Primary" />
    <ProSwitch @bind-Value="reverse" Label="Reverse" Color="Color.Primary" />
    <ProText>Spacing:</ProText>
    <ProSlider @bind-Value="spacing" Min="0" Max="16"/>
</ProStack>

<ProStack>
    <ProChipSet @bind-SelectedValue="@justify" CheckMark>
        <ProChip Value="Justify.FlexStart" Text="Justify Start" SelectedColor="Color.Primary" Variant="Variant.Text" />
        <ProChip Value="Justify.Center" Text="Justify Center" SelectedColor="Color.Primary" Variant="Variant.Text" Default="true" />
        <ProChip Value="Justify.FlexEnd" Text="Justify End" SelectedColor="Color.Primary" Variant="Variant.Text" />
        <ProChip Value="Justify.SpaceAround" Text="Justify Space Around" SelectedColor="Color.Primary" Variant="Variant.Text" />
        <ProChip Value="Justify.SpaceBetween" Text="Justify Space Between" SelectedColor="Color.Primary" Variant="Variant.Text" />
        <ProChip Value="Justify.SpaceEvenly" Text="Justify Space Evenly" SelectedColor="Color.Primary" Variant="Variant.Text" />
    </ProChipSet>

    <ProChipSet @bind-SelectedValue="@align" CheckMark>
        <ProChip Value="AlignItems.Start" Text="Align Start" SelectedColor="Color.Secondary" Variant="Variant.Text" />
        <ProChip Value="AlignItems.Center" Text="Align Center" SelectedColor="Color.Secondary" Variant="Variant.Text" Default="true" />
        <ProChip Value="AlignItems.End" Text="Align End" SelectedColor="Color.Secondary" Variant="Variant.Text" />
        <ProChip Value="AlignItems.Stretch" Text="Align Stretch" SelectedColor="Color.Secondary" Variant="Variant.Text" />
        <ProChip Value="AlignItems.Baseline" Text="Align Baseline" SelectedColor="Color.Secondary" Variant="Variant.Text" />
    </ProChipSet>

    <ProChipSet @bind-SelectedValue="@stretch" CheckMark>
        <ProChip Value="StretchItems.None" Text="Do Not Stretch" SelectedColor="Color.Tertiary" Variant="Variant.Text" Default="true" />
        <ProChip Value="StretchItems.Start" Text="Stretch First" SelectedColor="Color.Tertiary" Variant="Variant.Text" />
        <ProChip Value="StretchItems.End" Text="Stretch Last" SelectedColor="Color.Tertiary" Variant="Variant.Text" />
        <ProChip Value="StretchItems.StartAndEnd" Text="Stretch First and Last" SelectedColor="Color.Tertiary" Variant="Variant.Text" />
        <ProChip Value="StretchItems.Middle" Text="Stretch Middle" SelectedColor="Color.Tertiary" Variant="Variant.Text" />
        <ProChip Value="StretchItems.All" Text="Stretch All" SelectedColor="Color.Tertiary" Variant="Variant.Text" />
    </ProChipSet>
</ProStack>

@code {
    Justify justify = Justify.Center;
    AlignItems align = AlignItems.Center;
    StretchItems stretch = StretchItems.None;
    bool row = false;
    bool reverse = false;
    int spacing = 3;
}