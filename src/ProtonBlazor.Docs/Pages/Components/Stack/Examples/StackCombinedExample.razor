@namespace ProtonBlazor.Docs.Examples

<ProPaper Outlined="true" Class="border-dashed">
    <ProStack Justify="_justify" AlignItems="_align" Row="_row" Style="height:200px;">
        <ProPaper Class="py-1 px-3 pro-theme-primary">Item 1</ProPaper>
        <ProPaper Class="py-3 px-3 pro-theme-primary">Item 2</ProPaper>
        <ProPaper Class="py-5 px-3 pro-theme-primary">Item 3</ProPaper>
    </ProStack>
</ProPaper>

<ProStack Row="true" Justify="Justify.Center">
    <ProRadioGroup T="bool" @bind-Value="@_row">
        <ProRadio Value="false" Dense="true">Column</ProRadio>
        <ProRadio Value="true" Dense="true">Row</ProRadio>
    </ProRadioGroup>
</ProStack>

<ProStack Row="true">
    <ProChipSet T="string" CheckMark Class="d-flex justify-center">
        <ProChip Text="Justify Start" OnClick="@(() => _justify = Justify.FlexStart)" SelectedColor="Color.Primary" Variant="Variant.Text" Default="true" />
        <ProChip Text="Justify End" OnClick="@(() => _justify = Justify.FlexEnd)" SelectedColor="Color.Primary" Variant="Variant.Text" />
    </ProChipSet>
    <ProChipSet T="string" CheckMark Class="d-flex justify-center">
        <ProChip Text="Align Start" OnClick="@(() => _align = AlignItems.Start)" SelectedColor="Color.Secondary" Variant="Variant.Text" Default="true" />
        <ProChip Text="Align End" OnClick="@(() => _align = AlignItems.End)" SelectedColor="Color.Secondary" Variant="Variant.Text" />
    </ProChipSet>
</ProStack>


@code {
    bool _row = true;
    Justify _justify = Justify.FlexStart;
    AlignItems _align = AlignItems.Start;
}