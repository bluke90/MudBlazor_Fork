@namespace ProtonBlazor.Docs.Examples

<ProPaper Outlined="true" Class="border-dashed pa-4">
    <ProStack Wrap="@_wrap" Spacing="4" Row="@_row" Style="@_size" AlignItems="AlignItems.Start">
        <ProButton Variant="Variant.Filled" Color="Color.Primary" Style="" >Button 1</ProButton>
        <ProButton Variant="Variant.Filled" Color="Color.Primary" Style="" >Button 2</ProButton>
        <ProButton Variant="Variant.Filled" Color="Color.Primary" Style="" >Button 3</ProButton>
        <ProButton Variant="Variant.Filled" Color="Color.Primary" Style="" >Button 4</ProButton>
        <ProButton Variant="Variant.Filled" Color="Color.Primary" Style="" >Button 5</ProButton>
    </ProStack>
</ProPaper>

<ProSlider @bind-Value="_width" Min="100" Max="800">Width: @_width.ToString()px</ProSlider>
<ProSlider @bind-Value="_height" Min="100" Max="800">Height: @_height.ToString()px</ProSlider>

<ProStack Row AlignItems="AlignItems.Center">
    <ProSwitch @bind-Value="_row" Color="Color.Primary">Row</ProSwitch>
    <ProChipSet T="Wrap" CheckMark @bind-SelectedValue="_wrap">
        <ProChip T="Wrap" Text="No Wrap" Value="@(Wrap.NoWrap)" SelectedColor="Color.Primary" Variant="Variant.Text" Default="true"/>
        <ProChip T="Wrap" Text="Wrap" Value="@(Wrap.Wrap)" SelectedColor="Color.Primary" Variant="Variant.Text" />
        <ProChip T="Wrap" Text="Wrap Reverse" Value="@(Wrap.WrapReverse)" SelectedColor="Color.Primary" Variant="Variant.Text" />
    </ProChipSet>
</ProStack>

@code {
    private Wrap _wrap = Wrap.NoWrap;

    private int _width { get; set; } = 200;
    private int _height { get; set; } = 200;
    private bool _row { get; set; } = true;

    private string _size => $"width: {_width}px; height: {_height}px;";
}