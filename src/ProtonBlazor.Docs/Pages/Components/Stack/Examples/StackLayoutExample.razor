@namespace ProtonBlazor.Docs.Examples

<ProStack AlignItems="AlignItems.Center">

    <ProStack Spacing="0" StretchItems="StretchItems.Middle" Class="stack-main pro-elevation-25 stack-adorner">

        @* Title Bar *@
        <ProStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="pro-paper pro-paper-square stack-adorner">
            <ProIcon Icon="@Icons.Custom.Brands.ProtonBlazor" Color="Color.Primary" Class="ml-3 my-1 hideable" />
            <ProText Class="hideable">ProtonBlazor</ProText>
            <ProButton Color="Color.Error" Variant="Variant.Filled" Class="rounded-0 hideable" Style="min-width: 0;" DropShadow="false" OnClick="()=>counter=0">✕</ProButton>
        </ProStack>

        @* Middle Section *@
        <ProStack Row StretchItems="StretchItems.End" AlignItems="AlignItems.Stretch" Spacing="0" Style="height: 0px;" Class="stack-adorner">
            @* Side Menu *@
            <ProStack Justify="Justify.SpaceBetween" Spacing="0" Class="pro-theme-dark stack-adorner">
                <ProStack Spacing="0" Class="stack-adorner">
                    <ProButton Color="Color.Inherit" Class="pa-3 rounded-0 hideable" Style="min-width: 0;" OnClick="Count"><ProIcon Icon="@Icons.Material.Outlined.FileCopy" /></ProButton>
                    <ProButton Color="Color.Inherit" Class="pa-3 rounded-0 hideable" Style="min-width: 0;" OnClick="Count"><ProIcon Icon="@Icons.Material.Filled.Search" /></ProButton>
                    <ProButton Color="Color.Inherit" Class="pa-3 rounded-0 hideable" Style="min-width: 0;" OnClick="Count"><ProIcon Icon="@Icons.Material.Outlined.AltRoute" /></ProButton>
                </ProStack>
                <ProStack Spacing="0" Class="stack-adorner">
                    <ProButton Color="Color.Inherit" Class="pa-3 rounded-0 hideable" Style="min-width: 0;" OnClick="Count"><ProIcon Icon="@Icons.Material.Outlined.AccountCircle" /></ProButton>
                    <ProButton Color="Color.Inherit" Class="pa-3 rounded-0 hideable" Style="min-width: 0;" OnClick="Count"><ProIcon Icon="@Icons.Material.Outlined.Settings" /></ProButton>
                </ProStack>
            </ProStack>
            @* Main *@
            <ProStack Class="pro-background-gray stack-adorner" Style="overflow-x: auto;">
                <ProText Class="ma-6 hideable">
                    The ProStack provides flexibility in layout management, enabling the creation of elegant and responsive designs with minimal effort. Despite its simple design, it is powerful, making it perfect for both - simple and complex layouts. ProStack can perfectly complement and enhance your application's UI.
                </ProText>
            </ProStack>
        </ProStack>

        @* Status Bar *@
        <ProStack Row Spacing="0" Justify="Justify.SpaceBetween" Class="pro-theme-info stack-adorner">
            <ProButton Size="Size.Small" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.MarkChatRead" Class="hideable" OnClick="Count">Ready</ProButton>
            <ProStack Row Spacing="0" AlignItems="AlignItems.Center" Class="stack-adorner">
                <ProButton Size="Size.Small" Color="Color.Inherit" Class="hideable" OnClick="Count">ProtonBlazor</ProButton>
                <ProBadge Content="@counter" Overlap Class="mr-3 hideable">
                    <ProIconButton Size="Size.Small" Color="Color.Inherit" Icon="@Icons.Material.Outlined.Notifications" OnClick="Count" />
                </ProBadge>
            </ProStack>
        </ProStack>

    </ProStack>

    <ProStack Row>
        <ProSwitch @bind-Value="showAdorners" Color="Color.Primary">Inspect ProStacks</ProSwitch>
        <ProSwitch @bind-Value="hideContent" Color="Color.Primary">Hide content</ProSwitch>
    </ProStack>

</ProStack>

<style>
    .stack-main {
        width: 380px;
        height: 320px;
        min-height: 310px;
        min-width: 300px;
        max-height: 420px;
        max-width: 520px;
        resize: both;
        overflow: hidden;
    }

    .pro-badge {
        font-size: 10px;
        height: 11px;
        min-width: 11px;
        padding: 1px 4px;
    }
</style>
@if (showAdorners)
{
    <style>
        .stack-adorner:hover {
            outline: 2px dashed var(--pro-palette-secondary);
            z-index: 100;
        }
    </style>
}
@if (hideContent)
{
    <style>
        .hideable {
            opacity: 0;
        }
    </style>
}
@code {
    bool showAdorners;
    bool hideContent;
    int counter = 2;
    void Count()
    {
        counter++;
    }
}
