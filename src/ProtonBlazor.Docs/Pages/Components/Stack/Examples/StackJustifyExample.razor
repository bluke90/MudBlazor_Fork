@namespace ProtonBlazor.Docs.Examples

<ProPaper Outlined="true" Class="border-dashed">
    <ProStack Justify="@_justify" Row="true">
        <ProPaper Class="pa-3 pro-theme-primary">Item 1</ProPaper>
        <ProPaper Class="pa-3 pro-theme-primary">Item 2</ProPaper>
        <ProPaper Class="pa-3 pro-theme-primary">Item 3</ProPaper>
    </ProStack>
</ProPaper>

<ProChipSet T="string" CheckMark Class="d-flex justify-center mt-12">
    <ProChip Text="Start" OnClick="@(() => _justify = Justify.FlexStart)" SelectedColor="Color.Primary" />
    <ProChip Text="Center" OnClick="@(() => _justify = Justify.Center)" SelectedColor="Color.Primary" Default="true" />
    <ProChip Text="End" OnClick="@(() => _justify = Justify.FlexEnd)" SelectedColor="Color.Primary" />
    <ProChip Text="Space Around" OnClick="@(() => _justify = Justify.SpaceAround)" SelectedColor="Color.Primary" />
    <ProChip Text="Space Between" OnClick="@(() => _justify = Justify.SpaceBetween)" SelectedColor="Color.Primary" />
    <ProChip Text="Space Evenly" OnClick="@(() => _justify = Justify.SpaceEvenly)" SelectedColor="Color.Primary" />
</ProChipSet>


@code {
    Justify _justify = Justify.Center;
}