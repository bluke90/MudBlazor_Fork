@namespace ProtonBlazor.Docs.Examples

<ProDatePicker Label="Basic example" @bind-Date="_date"/>
<ProDatePicker Label="Editable with Placeholder" Editable="true" @bind-Date="_date" Placeholder="Select Date" />
<ProDatePicker Label="Only Calendar" @bind-Date="_date" ShowToolbar="false" />
<ProDatePicker Label="Date Format" @bind-Date="_date" DateFormat="dd.MM.yyyy" />
<ProDatePicker Label="Show week number" ShowWeekNumbers="true" @bind-Date="_date" />
<ProDatePicker Label="Display two months" DisplayMonths="2" TitleDateFormat="dddd, dd MMMM" @bind-Date="_date" />

@code {
    private DateTime? _date = DateTime.Today;
}
