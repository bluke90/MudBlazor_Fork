@namespace ProtonBlazor.Docs.Examples

<ProStack>
    <ProDateRangePicker Label="Basic range picker" @bind-DateRange="_dateRange" />
    <ProDateRangePicker Label="Basic range picker (editable)" Editable="true" @bind-DateRange="_dateRange" />
    <ProDateRangePicker Label="Placeholder" @bind-DateRange="_dateRange" PlaceholderStart="Start Date" PlaceholderEnd="End Date" />
    <ProDateRangePicker Label="Clearable" @bind-DateRange="_dateRange" Clearable="true" />
    <ProDateRangePicker Label="Range picker format" HelperText="For custom cultures" DateFormat="dd/MM/yyyy" TitleDateFormat="dddd, dd. MMMM" @bind-DateRange="_dateRange" />
    <ProDateRangePicker Label="Custom start month" StartMonth="@DateTime.Now.AddMonths(-1)" @bind-DateRange="_dateRange" />
    <ProDateRangePicker @ref="_picker" Label="With action buttons" @bind-DateRange="_dateRange" AutoClose="@_autoClose">
        <PickerActions>
            <ProButton Class="mr-auto align-self-start" OnClick="@(() => _picker.ClearAsync())">Clear</ProButton>
            <ProButton OnClick="@(() => _picker.CloseAsync(false))">Cancel</ProButton>
            <ProButton Color="Color.Primary" OnClick="@(() => _picker.CloseAsync())">OK</ProButton>
        </PickerActions>
    </ProDateRangePicker>
    <ProSwitch @bind-Value="_autoClose" Color="Color.Secondary">AutoClose</ProSwitch>
</ProStack>

@code { 
    private ProDateRangePicker _picker;
    private DateRange _dateRange = new DateRange(DateTime.Now.Date, DateTime.Now.AddDays(5).Date);
    private bool _autoClose;
}