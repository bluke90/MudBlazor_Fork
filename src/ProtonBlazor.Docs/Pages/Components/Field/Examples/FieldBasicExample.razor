@namespace ProtonBlazor.Docs.Examples


<ProGrid>
    <ProItem xs="12" sm="6" md="4">
        <ProField Label="Standard" Variant="Variant.Text">Some Content <ProIcon Icon="@Icons.Material.Filled.Favorite" Color="@Color.Warning" /> follows here</ProField>
    </ProItem>
    <ProItem xs="12" sm="6" md="4">
        <ProField Label="Filled" Variant="Variant.Filled">Some Content <ProIcon Icon="@Icons.Material.Filled.Favorite" Color="@Color.Warning" /> follows here</ProField>
    </ProItem>
    <ProItem xs="12" sm="6" md="4">
        <ProField Label="Outlined" Variant="Variant.Outlined">Some Content <ProIcon Icon="@Icons.Material.Filled.Favorite" Color="@Color.Warning" /> follows here</ProField>
    </ProItem>
</ProGrid>
<ProGrid>
    <ProItem xs="12" sm="6" md="4">
        <ProField Label="Standard" Variant="Variant.Text"></ProField>
    </ProItem>
    <ProItem xs="12" sm="6" md="4">
        <ProField Label="Filled" Variant="Variant.Filled"></ProField>
    </ProItem>
    <ProItem xs="12" sm="6" md="4">
        <ProField Label="Outlined" Variant="Variant.Outlined"></ProField>
    </ProItem>
</ProGrid>
<ProGrid>
    <ProItem xs="12" sm="6" md="4">
        <ProField Label="Standard" Variant="Variant.Text" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.CheckCircle" AdornmentColor="Color.Success"></ProField>
    </ProItem>
    <ProItem xs="12" sm="6" md="4">
        <ProField Label="Filled" Variant="Variant.Filled" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Money"></ProField>
    </ProItem>
    <ProItem xs="12" sm="6" md="4">
        <ProField Label="Outlined" Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Warning" AdornmentColor="Color.Warning"></ProField>
    </ProItem>
</ProGrid>