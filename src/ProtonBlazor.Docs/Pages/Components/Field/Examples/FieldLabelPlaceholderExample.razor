@using ProtonBlazor.Resources
@using ProtonBlazor.Utilities
@inject InternalMudLocalizer Localizer
@namespace ProtonBlazor.Docs.Examples

<style>
    .pro-input-control.pro-field .pro-input>input.pro-input-root-outlined {
        padding: 0px 14px;
    }
</style>

<ProGrid>
    <ProItem xs="12" md="6" lg="4">
        <ProStack>
            <ProField Label="What am I?" ChildContent="@content"
                      Variant="Variant.Outlined">
            </ProField>
            <ProText Typo="Typo.button">ChildContent</ProText>
            <ProStack Row AlignItems="AlignItems.Center">
                <ProSwitch T="bool" Label="Label" LabelPlacement="Placement.Start" Color="Color.Primary" ValueChanged="@((b) => content = b ? null : rf1)" />
                Placeholder
            </ProStack>
        </ProStack>
    </ProItem>
    <ProItem xs="12" md="6" lg="4">
        <ProField Label="Pick a color" Variant="Variant.Outlined">
            <input type="color" @bind-value="color" /><span class="ml-3">@color</span>
        </ProField>
    </ProItem>
    <ProItem xs="12" md="6" lg="4">
        <ProStack>
            <ProField Label="ShrinkLabel Override" Variant="Variant.Outlined" AdornmentAriaLabel="info icon"
                      AdornmentIcon="@Icons.Material.Filled.Info" AdornmentColor="Color.Info"
                      ShrinkLabel="@_shrinkLabel" Adornment="Adornment.End">
                <ProStack Row Class="pro-input"
                          Spacing="2" AlignItems="AlignItems.Center" tabindex="-1">
                    <input class="@InputClassname" />
                    <ProIconButton Color="@Color.Default"
                                   Icon="@Icons.Material.Filled.Clear"
                                   Size="@Size.Small"
                                   aria-label="@Localizer[LanguageResource.ProInput_Clear]"
                                   tabindex="-1"
                                   @onmousedown:stopPropagation />
                </ProStack>
            </ProField>
            <ProText Typo="Typo.button">ShrinkLabel</ProText>
            <ProStack Row AlignItems="AlignItems.Center">
                <ProSwitch @bind-Value="@_shrinkLabel" Label="Label" LabelPlacement="Placement.Start" Color="Color.Primary" />
                Placeholder
            </ProStack>
        </ProStack>
    </ProItem>
</ProGrid>

@code {
    RenderFragment content = null;
    RenderFragment rf1 = @<ProText Typo="@Typo.h6">I Am Field</ProText>;
    string color = "#6cf014";
    private bool _shrinkLabel = false;

    protected string InputClassname =>
        new CssBuilder("pro-input-slot")
            .AddClass("pro-input-root")
            .AddClass($"pro-input-root-{Variant.Outlined.ToStringFast(true)}")
            .AddClass($"pro-input-root-adorned-{Adornment.End.ToStringFast(true)}")
            .AddClass($"pro-input-root-margin-{Margin.Normal.ToStringFast(true)}")
            .Build();
}
