@namespace ProtonBlazor.Docs.Examples

<ProChart ChartType="ChartType.Donut" Width="100%" Height="300px" ChartSeries="@Data.AsChartDataSet()" ChartLabels="@Labels">
	<CustomGraphics>
		<text class="pro-donut-text pro-typography-h3" x="50%" y="50%">@Data.Sum()</text>
	</CustomGraphics>
</ProChart>

@code {
    private static readonly int[] Data = [25, 77, 28, 5];
    private static readonly string[] Labels = ["Oil", "Coal", "Gas", "Biomass"];
}
