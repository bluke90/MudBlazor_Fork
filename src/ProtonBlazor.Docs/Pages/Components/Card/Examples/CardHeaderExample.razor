@namespace ProtonBlazor.Docs.Examples

<ProCard>
    <ProCardHeader>
        <CardHeaderContent>
            <ProText Typo="Typo.h6">The Story Book</ProText>
        </CardHeaderContent>
        <CardHeaderActions>
            <ProIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Default" />
        </CardHeaderActions>
    </ProCardHeader>
    <ProCardContent>
        <ProText>This day everything happened.</ProText>
        <ProText Typo="Typo.body2">The quick, brown fox jumps over a lazy dog.</ProText>
    </ProCardContent>
    <ProCardActions>
        <ProButton Variant="Variant.Text" Color="Color.Primary">Read more</ProButton>
    </ProCardActions>
</ProCard>
