@namespace ProtonBlazor.Docs.Examples

<ProStack>
    <ProDateRangePicker @bind-DateRange="@_dateRange" Margin="Margin.Dense" ReadOnly="@(!_editable)" Clearable="@_clearable" 
                        PlaceholderStart="Start Date" PlaceholderEnd="End Date" Label="Range"/>

    <ProStack Row="true">
        <ProSwitch @bind-Value="_editable" Color="Color.Secondary">Editable</ProSwitch>
        <ProSwitch @bind-Value="_clearable" Color="Color.Secondary">Clearable</ProSwitch>
    </ProStack>
</ProStack>

@code {
    private bool _editable = true;
    private bool _clearable = true;
    private DateRange _dateRange { get; set; }
}