@namespace ProtonBlazor.Docs.Examples

<ProGrid>
    <ProItem md="4" xs="12">
        <ProAlert Severity="Severity.Normal" NoIcon="true" Class="mb-2 mt-3">Default No Icon</ProAlert>
        <ProAlert Severity="Severity.Info" NoIcon="true" Class="my-2">Info No Icon</ProAlert>
        <ProAlert Severity="Severity.Success" NoIcon="true" Class="my-2">Success No Icon</ProAlert>
        <ProAlert Severity="Severity.Warning" NoIcon="true" Class="my-2">Warning No Icon</ProAlert>
        <ProAlert Severity="Severity.Error" NoIcon="true" Class="my-2">Error No Icon</ProAlert>
    </ProItem>
    <ProItem md="4" xs="12">
        <ProAlert Severity="Severity.Normal" Variant="Variant.Outlined" NoIcon="true" Class="my-2">Icon Default No</ProAlert>
        <ProAlert Severity="Severity.Info" Variant="Variant.Outlined" NoIcon="true" Class="my-2">Info No Icon</ProAlert>
        <ProAlert Severity="Severity.Success" Variant="Variant.Outlined" NoIcon="true" Class="my-2">Success No Icon</ProAlert>
        <ProAlert Severity="Severity.Warning" Variant="Variant.Outlined" NoIcon="true" Class="my-2">Warning No Icon</ProAlert>
        <ProAlert Severity="Severity.Error" Variant="Variant.Outlined" NoIcon="true" Class="my-2">Error No Icon</ProAlert>
    </ProItem>
    <ProItem md="4" xs="12">
        <ProAlert Severity="Severity.Normal" Variant="Variant.Filled" NoIcon="true" Class="mb-2 mt-3">Default No Icon</ProAlert>
        <ProAlert Severity="Severity.Info" Variant="Variant.Filled" NoIcon="true" Class="my-2">Info No Icon</ProAlert>
        <ProAlert Severity="Severity.Success" Variant="Variant.Filled" NoIcon="true" Class="my-2">Success No Icon</ProAlert>
        <ProAlert Severity="Severity.Warning" Variant="Variant.Filled" NoIcon="true" Class="my-2">Warning No Icon</ProAlert>
        <ProAlert Severity="Severity.Error" Variant="Variant.Filled" NoIcon="true" Class="my-2">Error No Icon</ProAlert>
    </ProItem>
</ProGrid>