@namespace ProtonBlazor.Docs.Examples

<ProGrid>
    <ProItem md="4" xs="12">
        <ProAlert Severity="Severity.Normal" Dense="true" Class="my-2">Dense Default</ProAlert>
        <ProAlert Severity="Severity.Info" Dense="true" Class="my-2">Dense Info</ProAlert>
        <ProAlert Severity="Severity.Success" Dense="true" Class="my-2">Dense Success</ProAlert>
        <ProAlert Severity="Severity.Warning" Dense="true" Class="my-2">Dense Warning</ProAlert>
        <ProAlert Severity="Severity.Error" Dense="true" Class="my-2">Dense Error</ProAlert>
    </ProItem>
    <ProItem md="4" xs="12">
        <ProAlert Severity="Severity.Normal" Variant="Variant.Outlined" Dense="true" Class="my-2">Dense Default</ProAlert>
        <ProAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="my-2">Dense Info</ProAlert>
        <ProAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="my-2">Dense Success</ProAlert>
        <ProAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="my-2">Dense Warning</ProAlert>
        <ProAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="my-2">Dense Error</ProAlert>
    </ProItem>
    <ProItem md="4" xs="12">
        <ProAlert Severity="Severity.Normal" Variant="Variant.Filled" Dense="true" Class="my-2">Dense Default</ProAlert>
        <ProAlert Severity="Severity.Info" Variant="Variant.Filled" Dense="true" Class="my-2">Dense Info</ProAlert>
        <ProAlert Severity="Severity.Success" Variant="Variant.Filled" Dense="true" Class="my-2">Dense Success</ProAlert>
        <ProAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true" Class="my-2">Dense Warning</ProAlert>
        <ProAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="my-2">Dense Error</ProAlert>
    </ProItem>
</ProGrid>