@namespace ProtonBlazor.Docs.Examples

<ProGrid>
    <ProItem md="4" xs="12">
        <ProAlert Severity="Severity.Normal" Square="true" Class="mb-2 mt-3">Default Square</ProAlert>
        <ProAlert Severity="Severity.Info" Square="true" Class="my-2">Info Square</ProAlert>
        <ProAlert Severity="Severity.Success" Square="true" Class="my-2">Success Square</ProAlert>
        <ProAlert Severity="Severity.Warning" Square="true" Class="my-2">Warning Square</ProAlert>
        <ProAlert Severity="Severity.Error" Square="true" Class="my-2">Error Square</ProAlert>
    </ProItem>
    <ProItem md="4" xs="12">
        <ProAlert Severity="Severity.Normal" Variant="Variant.Outlined" Square="true" Class="my-2">Default Square</ProAlert>
        <ProAlert Severity="Severity.Info" Variant="Variant.Outlined" Square="true" Class="my-2">Info Square</ProAlert>
        <ProAlert Severity="Severity.Success" Variant="Variant.Outlined" Square="true" Class="my-2">Success Square</ProAlert>
        <ProAlert Severity="Severity.Warning" Variant="Variant.Outlined" Square="true" Class="my-2">Warning Square</ProAlert>
        <ProAlert Severity="Severity.Error" Variant="Variant.Outlined" Square="true" Class="my-2">Error Square</ProAlert>
    </ProItem>
    <ProItem md="4" xs="12">
        <ProAlert Severity="Severity.Normal" Variant="Variant.Filled" Square="true" Class="mb-2 mt-3">Default Square</ProAlert>
        <ProAlert Severity="Severity.Info" Variant="Variant.Filled" Square="true" Class="my-2">Info Square</ProAlert>
        <ProAlert Severity="Severity.Success" Variant="Variant.Filled" Square="true" Class="my-2">Success Square</ProAlert>
        <ProAlert Severity="Severity.Warning" Variant="Variant.Filled" Square="true" Class="my-2">Warning Square</ProAlert>
        <ProAlert Severity="Severity.Error" Variant="Variant.Filled" Square="true" Class="my-2">Error Square</ProAlert>
    </ProItem>
</ProGrid>