@using System.Net.Http.Json
@using ProtonBlazor.Examples.Data.Models
@using System.Threading
@namespace ProtonBlazor.Docs.Examples
@inject HttpClient httpClient

<ProGrid>
    <ProItem xs="12" sm="6" md="4">
        <ProAutocomplete T="Element" Label="Strict false with ToString" @bind-Value="value1"
                         SearchFunc="@Search" Strict="false">
        </ProAutocomplete>
    </ProItem>
    <ProItem xs="12" sm="6" md="4">
        <ProAutocomplete T="Element" Label="Strict false with ToStringFunc" @bind-Value="value2"
                         SearchFunc="@Search" ToStringFunc="@(e=> e==null?null : $"{e.Name} ({e.Sign})")" Strict="false">
        </ProAutocomplete>
    </ProItem>
</ProGrid>

@code {
    private Element value1, value2;

    private async Task<IEnumerable<Element>> Search(string value, CancellationToken token)
    {
        return await httpClient.GetFromJsonAsync<List<Element>>($"webapi/periodictable/{value}", token);
    }
}
