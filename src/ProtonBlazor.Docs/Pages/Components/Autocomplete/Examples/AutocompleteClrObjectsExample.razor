@using System.Net.Http.Json
@using ProtonBlazor.Examples.Data.Models
@using System.Threading
@namespace ProtonBlazor.Docs.Examples
@inject HttpClient httpClient

<ProGrid>
    <ProItem xs="12" sm="6" md="4">
        <ProAutocomplete T="Element" Label="Periodic Table Element" @bind-Value="value1" 
                         SearchFunc="@Search" ToStringFunc="@(e=> e==null?null : $"{e.Name} ({e.Sign})")" />
    </ProItem>
    <ProItem xs="12" sm="6" md="4">
        <ProAutocomplete T="Element" Label="Periodic Table Element" @bind-Value="value2" 
                         SearchFunc="@Search" ToStringFunc="@(e=> e==null?null : $"{e.Name} ({e.Sign})")">
            <ItemTemplate Context="e">                          
                <ProText>
                    <ProIcon Icon="@Icons.Material.Filled.CheckBoxOutlineBlank" Class="mb-n1 mr-3"/>@($"{e.Name} ({e.Sign})")
                </ProText>
            </ItemTemplate>
            <ItemSelectedTemplate Context="e">                
                <ProText>
                    <ProIcon Icon="@Icons.Material.Filled.CheckBox" Class="mb-n1 mr-3"/>@($"{e.Name} ({e.Sign})")
                </ProText>
            </ItemSelectedTemplate>
        </ProAutocomplete>
    </ProItem>
    <ProItem xs="12" sm="6" md="4">
        <ProAutocomplete T="Element" Label="Periodic Table Element" @bind-Value="value3"
                   SearchFunc="@Search" ItemDisabledFunc="@((Element e) => (e.Name.Contains("H")))" ToStringFunc="@(e=> e==null?null : $"{e.Name} ({e.Sign})")">
            <ItemDisabledTemplate>
                <ProText>Not available: @context.ToString()</ProText>
            </ItemDisabledTemplate>
        </ProAutocomplete>
    </ProItem>
    <ProItem xs="12" md="12">
        <ProText Class="mb-n3" Typo="Typo.body2">
            Selected values: <ProChip T="string">@(value1?.ToString() ?? "Not selected")</ProChip><ProChip T="string">@(value2?.ToString() ?? "Not selected")</ProChip><ProChip T="string">@(value3?.ToString() ?? "Not selected")</ProChip>
        </ProText>
    </ProItem>
</ProGrid>

@code {
    private Element value1, value2, value3;

    private async Task<IEnumerable<Element>> Search(string value, CancellationToken token)
    {
        return  await httpClient.GetFromJsonAsync<List<Element>>($"webapi/periodictable/{value}", token);
    }
}
