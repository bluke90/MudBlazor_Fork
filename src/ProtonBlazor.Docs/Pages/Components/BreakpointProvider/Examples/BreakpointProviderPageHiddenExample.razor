@using ProtonBlazor.Services
@namespace ProtonBlazor.Docs.Examples

<ProBreakpointProvider>
	@for (int i = 0; i < _amountOfRows; i++)
	{
		<ProHidden Breakpoint="Breakpoint.Xl" Invert="true">
			<ProCard Class="pa-5">
				<ProText>XL</ProText>
			</ProCard>
		</ProHidden>
		<ProHidden Breakpoint="Breakpoint.Lg" Invert="true">
			<ProCard Class="pa-5">
				<ProText>LG</ProText>
			</ProCard>
		</ProHidden>
		<ProHidden Breakpoint="Breakpoint.Md" Invert="true">
			<ProCard Class="pa-5">
				<ProText>MD</ProText>
			</ProCard>
		</ProHidden>
		<ProHidden Breakpoint="Breakpoint.Sm" Invert="true">
			<ProCard Class="pa-5">
				<ProText>SM</ProText>
			</ProCard>
		</ProHidden>
		<ProHidden Breakpoint="Breakpoint.Xs" Invert="true">
			<ProCard Class="pa-5">
				<ProText>XS</ProText>
			</ProCard>
		</ProHidden>
		<ProHidden Breakpoint="Breakpoint.LgAndUp" Invert="true">
			<ProCard Class="pa-5">
				<ProText>LG and Up</ProText>
			</ProCard>
		</ProHidden>
		<ProHidden Breakpoint="Breakpoint.MdAndUp" Invert="true">
			<ProCard Class="pa-5">
				<ProText>MD and Up</ProText>
			</ProCard>
		</ProHidden>
		<ProHidden Breakpoint="Breakpoint.SmAndUp" Invert="true">
			<ProCard Class="pa-5">
				<ProText>SM and Up</ProText>
			</ProCard>
		</ProHidden>
		<ProHidden Breakpoint="Breakpoint.LgAndDown" Invert="true">
			<ProCard Class="pa-5">
				<ProText>LG and Down</ProText>
			</ProCard>
		</ProHidden>
		<ProHidden Breakpoint="Breakpoint.MdAndDown" Invert="true">
			<ProCard Class="pa-5">
				<ProText>MD and Down</ProText>
			</ProCard>
		</ProHidden>
		<ProHidden Breakpoint="Breakpoint.SmAndDown" Invert="true">
			<ProCard Class="pa-5">
				<ProText>SM and Down</ProText>
			</ProCard>
		</ProHidden>
	}
</ProBreakpointProvider>

<ProSlider @bind-Value="_amountOfRows" Min="1" Max="100"></ProSlider>
<ProText>Rows: @_amountOfRows</ProText>

@code {
	private int _amountOfRows = 2;
} 