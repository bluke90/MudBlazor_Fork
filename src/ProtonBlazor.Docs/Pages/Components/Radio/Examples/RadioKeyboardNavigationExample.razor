@namespace ProtonBlazor.Docs.Examples

<ProForm>
    <ProRadioGroup @bind-Value="SelectedOption">
        <ProRadio Value="@("Radio 1")" Color="Color.Primary">Primary</ProRadio>
        <ProRadio Value="@("Radio 2")" Color="Color.Secondary">Secondary</ProRadio>
        <ProRadio Value="@("Radio 3")" Color="Color.Tertiary">Tertiary</ProRadio>
        <ProRadio Value="@("Radio 4")">Default</ProRadio>
        <ProRadio Value="@("Radio 4")" Color="Color.Primary" Disabled="true">Disabled</ProRadio>
    </ProRadioGroup>
</ProForm>

@code {
    public string SelectedOption { get; set; }
}