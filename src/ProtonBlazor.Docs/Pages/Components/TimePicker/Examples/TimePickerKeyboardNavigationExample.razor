@namespace ProtonBlazor.Docs.Examples

<ProTimePicker Label="12 hours" AmPm="true" @bind-Time="_time" />
<ProTimePicker Label="24 hours" @bind-Time="_time" />
<ProTimePicker Label="With action buttons">
    <PickerActions>
        <ProButton Class="mr-auto align-self-start" OnClick="@(() => context.ClearAsync())">Clear</ProButton>
        <ProButton OnClick="@(() => context.CloseAsync(false))">Cancel</ProButton>
        <ProButton Color="Color.Primary" OnClick="@(() => context.CloseAsync())">OK</ProButton>
    </PickerActions>
</ProTimePicker>

@code{
    private TimeSpan? _time = new TimeSpan(00, 45, 00);
}