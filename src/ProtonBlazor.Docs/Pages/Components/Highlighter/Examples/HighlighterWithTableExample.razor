@using System.Net.Http.Json
@using ProtonBlazor.Examples.Data.Models
@namespace ProtonBlazor.Docs.Examples
@inject HttpClient httpClient

<ProTable Items="@GetElements()">
    <ToolBarContent>
        <ProText Typo="Typo.h6">Periodic Elements</ProText>
        <ProSpacer />
        <ProTextField @bind-Value="_searchTerm" Placeholder="Search" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Immediate="true"></ProTextField>
    </ToolBarContent>

    <HeaderContent>
        <ProTh>Name</ProTh>
    </HeaderContent>

    <RowTemplate>
        <ProTd DataLabel="Name">
            <ProHighlighter Text="@context.Name" HighlightedText="@_searchTerm" />
        </ProTd>
    </RowTemplate>
</ProTable>

@code {
    private string _searchTerm = "H";
    private IEnumerable<Element> _elements = new List<Element>();

    protected override async Task OnInitializedAsync()
    {
        _elements = await httpClient.GetFromJsonAsync<List<Element>>("webapi/periodictable");
    }

    private IEnumerable<Element> GetElements() => _elements.Where(e => e.Name.Contains(_searchTerm));
}