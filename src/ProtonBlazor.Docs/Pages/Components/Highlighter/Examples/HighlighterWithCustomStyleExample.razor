@namespace ProtonBlazor.Docs.Examples

<ProPaper Elevation="0">
    <ProList T="string">
        <ProListSubheader>
            <ProTextField @bind-Value="searchTerm" AdornmentIcon="@Icons.Material.Filled.Brush"
                          Adornment="Adornment.End" Immediate="true" Variant="Variant.Outlined" />
        </ProListSubheader>

        @foreach (var sentence in sentences)
        {
            <ProListItem @key="sentence" Icon="@Icons.Material.Filled.Folder">
                <ProHighlighter Class="pro-primary-text"
                             Style="background-color:transparent;font-weight:bold"
                             Text="@sentence"
                             HighlightedText="@searchTerm" />
            </ProListItem>
        }
    </ProList>
</ProPaper>

@code {
    string searchTerm = "it";
    IEnumerable<string> sentences = new List<string>
    {
        "This is the first item", "This is the second item", "This is the third item"
    };
}