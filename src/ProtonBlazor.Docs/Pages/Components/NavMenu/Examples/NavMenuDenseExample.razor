@namespace ProtonBlazor.Docs.Examples

<ProPaper Width="250px" Class="py-3" Elevation="0">
    <ProNavMenu Dense="true" Color="Color.Info">
        <ProNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard">Dashboard</ProNavLink>
            <ProNavLink Href="/components/navmenu" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Storage">Servers</ProNavLink>
            <ProNavLink Href="/billing" Disabled="true">Billing</ProNavLink>
            <ProNavGroup Title="Settings" Expanded="true">
                <ProNavLink Href="/users">Users</ProNavLink>
                <ProNavLink Href="/security">Security</ProNavLink>
            </ProNavGroup>
            <ProNavLink Href="/about">About</ProNavLink>
    </ProNavMenu>
</ProPaper>
<ProPaper Width="250px" Class="py-3" Elevation="0">
    <ProNavMenu Dense="true" Rounded="true" Margin="Margin.Dense" Color="Color.Secondary" Class="pa-2">
        <ProNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard">Dashboard</ProNavLink>
        <ProNavLink Href="/components/navmenu" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Storage">Servers</ProNavLink>
        <ProNavLink Href="/billing" Disabled="true">Billing</ProNavLink>
        <ProNavGroup Title="Settings" Expanded="true">
            <ProNavLink Href="/users">Users</ProNavLink>
            <ProNavLink Href="/security">Security</ProNavLink>
        </ProNavGroup>
        <ProNavLink Href="/about">About</ProNavLink>
    </ProNavMenu>
</ProPaper>
