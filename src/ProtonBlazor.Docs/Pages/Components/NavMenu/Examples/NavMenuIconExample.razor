@namespace ProtonBlazor.Docs.Examples

<link href="https://use.fontawesome.com/releases/v5.14.0/css/all.css" rel="stylesheet">


<ProPaper Width="250px" Class="d-inline-flex py-3" Elevation="0">
    <ProNavMenu Class="pro-width-full">
        <ProText Typo="Typo.h6" Class="px-4">Material</ProText>
        <ProText Typo="Typo.body2" Class="px-4 pro-text-secondary">Icons</ProText>
        <ProDivider Class="my-2" />
        <ProNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard">Dashboard</ProNavLink>
        <ProNavLink Href="/servers" Icon="@Icons.Material.Filled.Storage">Servers</ProNavLink>
        <ProNavLink Href="/billing" Icon="@Icons.Material.Filled.Receipt" Disabled="true">Billing</ProNavLink>
        <ProNavGroup Title="Settings" Icon="@Icons.Material.Filled.Settings" Expanded="true">
            <ProNavLink Href="/users" Icon="@Icons.Material.Filled.People" IconColor="Color.Success">Users</ProNavLink>
            <ProNavLink Href="/security" Icon="@Icons.Material.Filled.Security" IconColor="Color.Info">Security</ProNavLink>
        </ProNavGroup>
    </ProNavMenu>
</ProPaper>
<ProPaper Width="250px" Class="d-inline-flex py-3" Elevation="0">
    <ProNavMenu Class="pro-width-full">
        <ProText Typo="Typo.h6" Class="px-4">Font Awesome</ProText>
        <ProText Typo="Typo.body2" Class="px-4 pro-text-secondary">Icons</ProText>
        <ProDivider Class="my-2" />
        <ProNavLink Href="/dashboard" Icon="fas fa-chart-line">Dashboard</ProNavLink>
        <ProNavLink Href="/servers" Icon="fas fa-server">Servers</ProNavLink>
        <ProNavLink Href="/billing" Icon="fas fa-receipt" Disabled="true">Billing</ProNavLink>
        <ProNavGroup Title="Settings" Icon="fas fa-cogs" Expanded="true">
            <ProNavLink Href="/users" Icon="fas fa-users" IconColor="Color.Success">Users</ProNavLink>
            <ProNavLink Href="/security" Icon="fas fa-user-shield" IconColor="Color.Info">Security</ProNavLink>
        </ProNavGroup>
    </ProNavMenu>
</ProPaper>
