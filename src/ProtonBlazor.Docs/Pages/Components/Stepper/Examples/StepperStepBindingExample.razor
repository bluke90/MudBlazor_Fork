@namespace ProtonBlazor.Docs.Examples
<ProPaper Style="width: 800px">
    <ProStepper @bind-ActiveIndex="_index" ShowResetButton>
        <ProStep Title="Select campaign settings" HasError="_error">Select campaign settings content</ProStep>
        <ProStep Title="Create an ad group" @bind-Completed="_completed">Create an ad group content</ProStep>
        <ProStep Title="Create an ad" Disabled="_disabled">Create an ad content</ProStep>
    </ProStepper>
</ProPaper>

<ProDivider/>

<p>_index: @_index</p>

<ProDivider/>

<ProSwitch @bind-Value="@_error" Color="Color.Primary" Label="Step 1 error"></ProSwitch>
<ProSwitch @bind-Value="@_completed" Color="Color.Primary" Label="Step 2 completed"></ProSwitch>
<ProSwitch @bind-Value="@_disabled" Color="Color.Primary" Label="Step 3 disabled" />

<ProNumericField @bind-Value="_index" Label="Current index" Variant="Variant.Text" Min="0" Max="5" />

@code {
    private bool _error;
    private bool _completed;
    private bool _disabled;

    private int _index;
}