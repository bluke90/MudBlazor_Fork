@namespace ProtonBlazor.Docs.Examples
<ProPaper Style="width: 800px">
    <ProStepper @bind-ActiveIndex="_index" ShowResetButton>
        <ChildContent>
            @foreach (var step in _steps)
            {
                <ProStep Title="@step">Select campaign settings content @step</ProStep>
            }
        </ChildContent>
        <CompletedContent>
            Well done!!!
        </CompletedContent>
    </ProStepper>
</ProPaper>

<ProDivider/>

<ProButton OnClick="Remove" Color="Color.Error">Remove</ProButton>
<ProText>@_steps.Count</ProText>
<ProButton OnClick="Add" Color="Color.Primary">Add</ProButton>

<ProDivider/>

<p>Current step index: @_index</p>


@code {
    List<string> _steps = new() { "First" ,  "Second" };
    int _index;

    private void Add()
    {
        Random rnd = new Random();
        _steps.Add( $"Step {rnd.Next(0, 10000)}" );
    }

    private void Remove()
    {
        _steps.Remove(_steps[^1]);
    }
}