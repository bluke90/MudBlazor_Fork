@namespace ProtonBlazor.Docs.Examples
<ProChipSet T="string" SelectionMode="SelectionMode.MultiSelection" CheckMark="_checkMark">
    <ProChip Text="Brunsås" Variant="Variant.Text" Color="Color.Default" SelectedColor="Color.Primary"></ProChip>
    <ProChip Text="Spotted Dick" Variant="Variant.Text" Color="Color.Primary" SelectedColor="Color.Secondary"></ProChip>
    <ProChip Text="Sushi" Variant="Variant.Text" Color="Color.Dark" SelectedColor="Color.Warning"></ProChip>
    <ProChip Text="Schnitzel" Variant="Variant.Text" Color="Color.Info" SelectedColor="Color.Error"></ProChip>
    <ProChip Text="Hamburger" Variant="Variant.Text" Color="Color.Success" SelectedColor="Color.Error"></ProChip>
</ProChipSet>
<ProChipSet T="string" SelectionMode="SelectionMode.MultiSelection" CheckMark="_checkMark">
    <ProChip Text="Brunsås" Variant="Variant.Outlined" Color="Color.Default" SelectedColor="Color.Primary"></ProChip>
    <ProChip Text="Spotted Dick" Variant="Variant.Outlined" Color="Color.Primary" SelectedColor="Color.Secondary"></ProChip>
    <ProChip Text="Sushi" Variant="Variant.Outlined" Color="Color.Dark" SelectedColor="Color.Warning"></ProChip>
    <ProChip Text="Schnitzel" Variant="Variant.Outlined" Color="Color.Info" SelectedColor="Color.Error"></ProChip>
    <ProChip Text="Hamburger" Variant="Variant.Outlined" Color="Color.Success" SelectedColor="Color.Error"></ProChip>
</ProChipSet>
<ProChipSet T="string" SelectionMode="SelectionMode.MultiSelection" CheckMark="_checkMark">
    <ProChip Text="Brunsås" Variant="Variant.Filled" Color="Color.Default" SelectedColor="Color.Primary"></ProChip>
    <ProChip Text="Spotted Dick" Variant="Variant.Filled" Color="Color.Primary" SelectedColor="Color.Secondary"></ProChip>
    <ProChip Text="Sushi" Variant="Variant.Filled" Color="Color.Dark" SelectedColor="Color.Warning"></ProChip>
    <ProChip Text="Schnitzel" Variant="Variant.Filled" Color="Color.Info" SelectedColor="Color.Error"></ProChip>
    <ProChip Text="Hamburger" Variant="Variant.Filled" Color="Color.Success" SelectedColor="Color.Error"></ProChip>
</ProChipSet>
<ProCheckBox @bind-Value="_checkMark">Check marks</ProCheckBox>

@code
{
    private bool _checkMark = true;
}

