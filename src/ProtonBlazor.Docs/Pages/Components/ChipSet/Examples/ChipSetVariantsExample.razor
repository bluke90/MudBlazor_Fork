@namespace ProtonBlazor.Docs.Examples

<ProChipSet T="string" SelectionMode="SelectionMode.MultiSelection" CheckMark="_checkMark">
    <ProChip Text="gray" Variant="Variant.Text" Color="Color.Default">Default</ProChip>
    <ProChip Text="purple" Variant="Variant.Text" Color="Color.Primary">Primary</ProChip>
    <ProChip Text="pink" Variant="Variant.Text" Color="Color.Secondary">Secondary</ProChip>
    <ProChip Text="blue" Variant="Variant.Text" Color="Color.Info">Info</ProChip>
    <ProChip Text="green" Variant="Variant.Text" Color="Color.Success">Success</ProChip>
    <ProChip Text="orange" Variant="Variant.Text" Color="Color.Warning">Warning</ProChip>
    <ProChip Text="red" Variant="Variant.Text" Color="Color.Error">Error</ProChip>
    <ProChip Text="black" Variant="Variant.Text" Color="Color.Dark">Dark</ProChip>
</ProChipSet>
<ProChipSet T="string" SelectionMode="SelectionMode.MultiSelection" CheckMark="_checkMark">
    <ProChip Text="gray" Variant="Variant.Outlined" Color="Color.Default">Default</ProChip>
    <ProChip Text="purple" Variant="Variant.Outlined" Color="Color.Primary">Primary</ProChip>
    <ProChip Text="pink" Variant="Variant.Outlined" Color="Color.Secondary">Secondary</ProChip>
    <ProChip Text="blue" Variant="Variant.Outlined" Color="Color.Info">Info</ProChip>
    <ProChip Text="green" Variant="Variant.Outlined" Color="Color.Success">Success</ProChip>
    <ProChip Text="orange" Variant="Variant.Outlined" Color="Color.Warning">Warning</ProChip>
    <ProChip Text="red" Variant="Variant.Outlined" Color="Color.Error">Error</ProChip>
    <ProChip Text="black" Variant="Variant.Outlined" Color="Color.Dark">Dark</ProChip>
</ProChipSet>
<ProChipSet T="string" SelectionMode="SelectionMode.MultiSelection" CheckMark="_checkMark">
    <ProChip Text="gray" Variant="Variant.Filled" Color="Color.Default">Default</ProChip>
    <ProChip Text="purple" Variant="Variant.Filled" Color="Color.Primary">Primary</ProChip>
    <ProChip Text="pink" Variant="Variant.Filled" Color="Color.Secondary">Secondary</ProChip>
    <ProChip Text="blue" Variant="Variant.Filled" Color="Color.Info">Info</ProChip>
    <ProChip Text="green" Variant="Variant.Filled" Color="Color.Success">Success</ProChip>
    <ProChip Text="orange" Variant="Variant.Filled" Color="Color.Warning">Warning</ProChip>
    <ProChip Text="red" Variant="Variant.Filled" Color="Color.Error">Error</ProChip>
    <ProChip Text="black" Variant="Variant.Filled" Color="Color.Dark">Dark</ProChip>
</ProChipSet>
<ProCheckBox @bind-Value="_checkMark">Check marks</ProCheckBox>


@code
{
    private bool _checkMark = true;
}

