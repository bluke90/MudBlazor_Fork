<ProAvatarGroup Max="@max" Spacing="@spacing" MaxColor="Color.Primary">
    <ProAvatar>
        <ProImage Src="images/jonny.jpg" />
    </ProAvatar>
    <ProAvatar>
        <ProImage Src="images/mony.jpg" />
    </ProAvatar>
    <ProAvatar>
        <ProImage Src="images/toiletvisit.jpg" />
    </ProAvatar>
    <ProAvatar>
        <ProImage Src="images/jonny.jpg" />
    </ProAvatar>
    <ProAvatar>
        <ProImage Src="images/mony.jpg" />
    </ProAvatar>
    <ProAvatar>
        <ProImage Src="images/toiletvisit.jpg" />
