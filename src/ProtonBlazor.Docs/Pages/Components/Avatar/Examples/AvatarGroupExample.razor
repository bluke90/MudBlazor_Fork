</ProAvatarGroup>

<ProGrid>
    <ProItem xs="12" sm="6">
        <ProSlider Min="0" Max="6" Step="0" @bind-Value="max" Color="Color.Info">Max Avatars</ProSlider>
    </ProItem>
    <ProItem xs="12" sm="6">
        <ProSlider Min="0" Max="16" Step="0" @bind-Value="spacing" Color="Color.Error">Spacing</ProSlider>
    </ProItem>
</ProGrid>

@code {
    int max = 3;
    int spacing = 3;
}