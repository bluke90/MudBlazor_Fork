@namespace ProtonBlazor.Docs.Examples


<ProText Typo="Typo.h6" Class="mb-4">Default Gutters (Gutters="true")</ProText>
<ProExpansionPanels Class="mb-6">
    <ProExpansionPanel Text="Panel with Gutters" Gutters="true">
        <ProText>Both header and content have 24px horizontal padding (gutters).</ProText>
        <ProText>This is the default behavior when Gutters is not specified.</ProText>
    </ProExpansionPanel>
</ProExpansionPanels>

<ProText Typo="Typo.h6" Class="mb-4">No Gutters (Gutters="false")</ProText>
<ProExpansionPanels Class="mb-6">
    <ProExpansionPanel Text="Panel without Gutters" Gutters="false">
        <ProText>Both header and content have no horizontal padding.</ProText>
        <ProText>Notice how the text aligns to the left edge.</ProText>
    </ProExpansionPanel>
</ProExpansionPanels>

<ProText Typo="Typo.h6" Class="mb-4">Dense Panels</ProText>
<ProExpansionPanels Class="mb-6">
    <ProExpansionPanel Text="Dense with Gutters" Dense Gutters>
        Dense removes vertical padding from content while keeping horizontal gutters.
    </ProExpansionPanel>
    <ProExpansionPanel Text="Dense without Gutters" Dense Gutters="false">
        Dense with no gutters - minimal padding on all sides.
    </ProExpansionPanel>
</ProExpansionPanels>

<ProText Typo="Typo.h6" Class="mb-4">Parent Controls Gutters</ProText>
<ProExpansionPanels Dense Gutters="false">
    <ProExpansionPanel Text="Gutters inherited from parent">
        When the parent ProExpansionPanels has Gutters="false", all child panels inherit this setting.
    </ProExpansionPanel>
</ProExpansionPanels>