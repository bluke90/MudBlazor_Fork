@namespace ProtonBlazor.Docs.Examples

<ProButton Disabled="@_processing" OnClick="ProcessSomething" Variant="Variant.Filled" Color="Color.Primary">
    @if (_processing)
    {
        <ProProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
        <ProText Class="ms-2">Processing</ProText>
    }
    else
    {
        <ProText>Click me</ProText>
    }
</ProButton>

@code {
    private bool _processing = false;

    async Task ProcessSomething()
    {
        _processing = true;
        await Task.Delay(2000);
        _processing = false;
    }
}