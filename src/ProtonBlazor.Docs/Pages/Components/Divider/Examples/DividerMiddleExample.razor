@namespace ProtonBlazor.Docs.Examples

<ProCard>
    <ProCardHeader>
        <CardHeaderContent>
            <ProText Typo="Typo.h5">Uranium-235</ProText>
        </CardHeaderContent>
    </ProCardHeader>
    <ProCardContent>
        <ProText>This is the type of uranium used in the RBMK reactors.</ProText>
        <ProDivider DividerType="DividerType.Middle" Class="my-6"/>
        <ProText GutterBottom="true">Select Reactor Type</ProText>
        <ProChip T="string" Color="Color.Secondary">RBMK-1000</ProChip><ProChip T="string">RBMK-1500</ProChip><ProChip T="string">RBMKP-2400</ProChip>
    </ProCardContent>
    <ProCardActions>
        <ProButton Variant="Variant.Text" Color="Color.Primary">Read more</ProButton>
    </ProCardActions>
</ProCard>