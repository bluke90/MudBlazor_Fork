@inherits BytexDigital.Blazor.Components.CookieConsent.Dialogs.Prompt.CookieConsentPromptComponentBase

<div class="pro-cc-container">
    <ProPaper Class="pro-cc-content" Elevation="16">
        <div class="pro-cc-body">
            <ProText Typo="Typo.h6">
                We use cookies
            </ProText>

            <ProText Typo="Typo.body2">
                We use cookies to analyze site traffic and enhance your experience.
                By clicking Accept, you consent to the use of additional cookies.
                <ProLink Href="@Options.Value.PolicyUrl" Target="_blank">Learn more</ProLink>
            </ProText>
        </div>

        <div class="pro-cc-actions">
            <ProButton Variant="Variant.Filled" DropShadow="false" FullWidth Color="Color.Primary" OnClick="async () => await AcceptAsync(true)">
                Accept
            </ProButton>

            <ProButton Variant="Variant.Filled" DropShadow="false" FullWidth Color="Color.Default" OnClick="async () => await AcceptAsync(false)">
                Close
            </ProButton>
        </div>
    </ProPaper>
</div>
