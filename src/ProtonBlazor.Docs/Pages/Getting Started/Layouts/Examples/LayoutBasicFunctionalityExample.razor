@inherits LayoutComponentBase
@namespace ProtonBlazor.Docs.Examples

<ProThemeProvider />
<ProPopoverProvider />
<ProDialogProvider />
<ProSnackbarProvider />

<ProLayout>
    <ProAppBar>
        <ProIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        My Application
    </ProAppBar>
    <ProDrawer @bind-Open="@_drawerOpen">
        <MyNavMenu/>
    </ProDrawer>
    <ProMainContent>
        @Body
    </ProMainContent>
</ProLayout>

@code {
    bool _drawerOpen = true;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}