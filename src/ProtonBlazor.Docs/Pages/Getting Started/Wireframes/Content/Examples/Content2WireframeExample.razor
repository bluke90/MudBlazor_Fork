@namespace ProtonBlazor.Docs.Wireframes
@layout WireframeContentLayout2
@page "/getting-started/wireframes/content2"



<ProContainer Class="mt-16">
    <ProText Typo="Typo.h3" Align="Align.Center" GutterBottom="true">Pricing</ProText>
    <ProText Align="Align.Center">Some long pricing text should go here maybe? who knows what text you would want here, i guess i cant fill it in for you.</ProText>
    <ProGrid Class="mt-8">
        <ProItem xs="12" sm="6" md="4">
            <ProCard Elevation="25" Class="rounded-lg pb-4">
                <ProCardHeader>
                    <CardHeaderContent>
                        <ProText Typo="Typo.h5" Align="Align.Center">Beginner</ProText>
                    </CardHeaderContent>
                </ProCardHeader>
                <ProCardContent>
                    <div class="d-flex justify-center">
                        <ProText Typo="Typo.h3">$5</ProText>
                        <ProText Typo="Typo.h5" Class="ml-1 mt-5" Color="Color.Secondary">/Monthly</ProText>
                    </div>
                    <ProList T="string" Class="mx-auto mt-4" Style="width:300px;">
                        <ProListItem Icon="@Icons.Material.Filled.LiveHelp">
                            Unlimited something
                        </ProListItem>
                        <ProListItem Icon="@Icons.Material.Filled.LiveHelp">
                            10 something
                        </ProListItem>
                        <ProListItem Icon="@Icons.Material.Filled.LiveHelp">
                            No something
                        </ProListItem>
                    </ProList>
                </ProCardContent>
                <ProCardActions Class="d-flex justify-center">
                    <ProButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Style="width:50%;">Start now</ProButton>
                </ProCardActions>
            </ProCard>
        </ProItem>
        <ProItem xs="12" sm="6" md="4">
            <ProCard Elevation="25" Class="rounded-lg pb-4">
                <ProCardHeader>
                    <CardHeaderContent>
                        <ProText Typo="Typo.h5" Align="Align.Center">Starter</ProText>
                    </CardHeaderContent>
                </ProCardHeader>
                <ProCardContent>
                    <div class="d-flex justify-center">
                        <ProText Typo="Typo.h3">$10</ProText>
                        <ProText Typo="Typo.h5" Class="ml-1 mt-5" Color="Color.Secondary">/Monthly</ProText>
                    </div>
                    <ProList T="string" Class="mx-auto mt-4" Style="width:300px;">
                        <ProListItem Icon="@Icons.Material.Filled.LiveHelp">
                            Unlimited something
                        </ProListItem>
                        <ProListItem Icon="@Icons.Material.Filled.LiveHelp">
                            10 something
                        </ProListItem>
                        <ProListItem Icon="@Icons.Material.Filled.LiveHelp">
                            No something
                        </ProListItem>
                    </ProList>
                </ProCardContent>
                <ProCardActions Class="d-flex justify-center">
                    <ProButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Style="width:50%;">Start now</ProButton>
                </ProCardActions>
            </ProCard>
        </ProItem>
        <ProItem xs="12" sm="12" md="4">
            <ProCard Elevation="25" Class="rounded-lg pb-4">
                <ProCardHeader>
                    <CardHeaderContent>
                        <ProText Typo="Typo.h5" Align="Align.Center">Professional</ProText>
                    </CardHeaderContent>
                </ProCardHeader>
                <ProCardContent>
                    <div class="d-flex justify-center">
                        <ProText Typo="Typo.h3">$15</ProText>
                        <ProText Typo="Typo.h5" Class="ml-1 mt-5" Color="Color.Secondary">/Monthly</ProText>
                    </div>
                    <ProList T="string" Class="mx-auto mt-4" Style="width:300px;">
                        <ProListItem Icon="@Icons.Material.Filled.LiveHelp">
                            Unlimited something
                        </ProListItem>
                        <ProListItem Icon="@Icons.Material.Filled.LiveHelp">
                            10 something
                        </ProListItem>
                        <ProListItem Icon="@Icons.Material.Filled.LiveHelp">
                            No something
                        </ProListItem>
                    </ProList>
                </ProCardContent>
                <ProCardActions Class="d-flex justify-center">
                    <ProButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Style="width:50%;">Start now</ProButton>
                </ProCardActions>
            </ProCard>
        </ProItem>
    </ProGrid>
</ProContainer>
