@namespace ProtonBlazor.Docs.Wireframes
@inherits LayoutComponentBase
@layout WireframeLayout

<ProThemeProvider />

<ProLayout>
    <ProAppBar Elevation="1">
        <ProText Typo="Typo.h5" Class="ml-3">Application</ProText>
        <ProSpacer />
        <ProIconButton Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Edge="Edge.End" />
    </ProAppBar>
    <ProMainContent>
        @Body
    </ProMainContent>
</ProLayout>

@code {
    bool _drawerOpen = true;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}