<a href="@GetLink()">
    <ProPaper Outlined="true" Class="pa-2 rounded-lg d-flex flex-column">
        <ProPaper Elevation="0" Class="rounded-lg docs-gray-bg explore-card" role="img" aria-label="Component visualization">
            <div class="d-flex justify-center align-center relative pa-8 pro-height-full pro-width-full">
                @ChildContent
            </div>
        </ProPaper>
        <ProText Typo="Typo.subtitle2" Class="mt-3">@Title</ProText>
    </ProPaper>
</a>

@code {
    [Parameter] public string Title { get; set; }
    [Parameter] public string Link { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; }

    private string GetLink()
    {
        if (String.IsNullOrEmpty(Link))
        {
            return $"/components/{Title.Replace(" ", "").ToLowerInvariant()}";
        }
        else
        {
            return Link;
        }
    }
}