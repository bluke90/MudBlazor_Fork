@namespace ProtonBlazor.Docs.Components.LandingPage

<ProPaper Class="rounded-lg d-flex pa-6" Elevation="@Elevation">
    <div class="d-flex justify-center align-center">
        <ProIcon Icon="@Icon" Style="width:48px;height:48px;"/>
    </div>
    <div class="d-flex flex-column ml-6">
        <div class="d-flex">
            <ProText Typo="Typo.h6" Color="Color.Default">Mud</ProText>
            <ProText Typo="Typo.h6" Color="@Color">@Name</ProText>
        </div>
        <ProText Typo="Typo.body1">@Description</ProText>
    </div>
</ProPaper>
@code {
    [Parameter] public string Icon { get; set; }
    [Parameter] public string Name { get; set; }
    [Parameter] public Color Color { get; set; }
    [Parameter] public int Elevation { get; set; }
    [Parameter] public string Description { get; set; }
}