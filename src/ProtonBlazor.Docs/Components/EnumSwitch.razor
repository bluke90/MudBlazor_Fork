@typeparam T where T: Enum

<div class="pro-width-full d-flex justify-end">
    <ProButtonGroup OverrideStyles="false">
        @foreach (int value in Enum.GetValues(Type))
        {
            <ProButton Color="Color.Primary" Size="Size.Small" DropShadow="false" Variant="@(value == Convert.ToInt32(Value) ? Variant.Filled : Variant.Outlined)" OnClick="@(() => Value = (T)Enum.ToObject(Type, value))">
                @Enum.GetName(Type, value)
            </ProButton>
        }
    </ProButtonGroup>
</div>
