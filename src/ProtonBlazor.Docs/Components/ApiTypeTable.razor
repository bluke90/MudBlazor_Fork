<ProTable T="DocumentedType" @ref="Table" ServerData="@GetData" Elevation="0" Class="ma-0 pro-width-full" RowsPerPage="25" Hover="true" Dense="true" AllowUnsorted="false">
    <ToolBarContent>
        <ProTextField T="string"
                      Value="Keyword"
                      ValueChanged="OnKeywordChanged"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Placeholder="Search"
                      Immediate="true"
                      DebounceInterval="300" />
    </ToolBarContent>
    <HeaderContent>
        <ProTh Style="max-width:34%;"><ProTableSortLabel T="DocumentedType" SortLabel="Name" InitialDirection="SortDirection.Ascending">Name</ProTableSortLabel></ProTh>
        <ProTh Style="max-width:66%;"><ProTableSortLabel T="DocumentedType" SortLabel="Description">Description</ProTableSortLabel></ProTh>
    </HeaderContent>
    <RowTemplate>
        <ProTd Class="docs-content-api-cell" DataLabel="Name">
            <ApiTypeLink Type="@context" TypeName="@context.NameFriendly" ShowTooltip="false" />
        </ProTd>
        <ProTd id="@context.Name" Class="docs-content-api-cell docs-content-api-description" DataLabel="Description">
            <ApiText Text="@(context.Summary + " " + context.Remarks)" />
        </ProTd>
    </RowTemplate>
    <PagerContent>
        <ProTablePager />
    </PagerContent>
    <NoRecordsContent>
        <ProAlert Severity="Severity.Info">No types match the current filters.</ProAlert>
    </NoRecordsContent>
</ProTable>
