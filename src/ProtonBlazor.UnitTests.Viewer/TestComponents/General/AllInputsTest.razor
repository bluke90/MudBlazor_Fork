@* MODE SELECTORS *@

<ProStack Row AlignItems="AlignItems.End">
    <ProSelect T="Margin" Label="Margin size" @bind-Value="Margin" Variant="Variant.Outlined" Margin="Margin.Dense">
        @foreach (Margin margin in Enum.GetValues(typeof(Margin)))
        {
            <ProSelectItem Value="@margin">@margin</ProSelectItem>
        }
    </ProSelect>
    <ProSelect T="AlignItems" Label="Align" @bind-Value="Align" Variant="Variant.Outlined" Margin="Margin.Dense">
        @foreach (AlignItems align in Enum.GetValues(typeof(AlignItems)))
        {
            <ProSelectItem Value="@align">@align</ProSelectItem>
        }
    </ProSelect>
</ProStack>

@* INPUT EXAMPLES FOR EACH VARIANT *@

<ProText Typo="Typo.h6" Class="mt-6 mb-2">ProField</ProText>
<ProStack Row AlignItems="@Align">
    <ProField Variant="Variant.Text" Margin="@Margin">Field value</ProField>
    <ProField Variant="Variant.Filled" Margin="@Margin">Field value</ProField>
    <ProField Variant="Variant.Outlined" Margin="@Margin">Field value</ProField>
</ProStack>
<ProStack Row AlignItems="@Align">
    <ProField Label="With Label" Variant="Variant.Text" Margin="@Margin">Field value</ProField>
    <ProField Label="With Label" Variant="Variant.Filled" Margin="@Margin">Field value</ProField>
    <ProField Label="With Label" Variant="Variant.Outlined" Margin="@Margin">Field value</ProField>
</ProStack>
<ProStack Row AlignItems="@Align">
    <ProField HelperText="With Helper" Variant="Variant.Text" Margin="@Margin">Field value</ProField>
    <ProField HelperText="With Helper" Variant="Variant.Filled" Margin="@Margin">Field value</ProField>
    <ProField HelperText="With Helper" Variant="Variant.Outlined" Margin="@Margin">Field value</ProField>
</ProStack>

