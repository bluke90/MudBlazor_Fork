<ProPopoverProvider />

<ProSelect @bind-Value="_value" PopoverClass="select-popover-class" @onfocus="Focused" OnBlur="Blurred">
    <ProSelectItem Value="@("1")"/>
    <ProSelectItem Value="@("2")"/>
    <ProSelectItem Value="@("3")"/>
    <ProSelectItem Value="@("4")" Disabled="true"/>
</ProSelect>

<ProSwitch id="switch" @bind-Value="@_focused" />

@code {
    public static string __description__ = "Click should open the Menu and selecting a value should update the bindable value.";

    private string? _value = null;
    private bool _focused;

    private void Focused()
    {
	    _focused = true;
    }

    private void Blurred()
    {
	    _focused = false;
    }
}
