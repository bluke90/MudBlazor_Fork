<ProPopoverProvider />

<ProGrid>
    <ProItem xs="12" md="12">
        <ProSelect T="string" Label="Felines" HelperText="Pick your favorite feline"
                   MultiSelection="true" SelectAll="true" SelectAllText="Select all felines"
                   @bind-Value="_value" @bind-SelectedValues="_options" AdornmentIcon="@Icons.Material.Filled.Search"
                   MultiSelectionTextFunc="@(new Func<IReadOnlyList<string>, string>(GetMultiSelectionText))">
            @foreach (var feline in _felines)
            {
                <ProSelectItem T="string" Value="@feline">@feline</ProSelectItem>
            }
        </ProSelect>
    </ProItem>
    <ProItem xs="12" md="6">
        <ProText Typo="Typo.body2">ProSelect.Value: "@_value"</ProText>
    </ProItem>
</ProGrid>

@code {
    private string _value  = "Nothing selected";
    private IReadOnlyCollection<string> _options = [];

    private readonly string[] _felines =
    [
        "Jaguar", "Leopard", "Lion", "Lynx", "Panther", "Puma", "Tiger"
    ];

    private static string GetMultiSelectionText(IReadOnlyList<string> selectedValues)
    {
        return $"{selectedValues.Count} feline{(selectedValues.Count > 1 ? "s have" : " has")} been selected";
    }
}
