<ProGrid>
    <ProItem xs="12" sm="6" md="4">
        <ProSelect T="string" Label="Coffee" Strict="true">
            <ProSelectItem Value="@("Cappuccino")" />
            <ProSelectItem Value="@("Cafe Latte")" />
            <ProSelectItem Value="@("Espresso")" />
            <ProSelectItem Value="@("Irish Coffee")" />
        </ProSelect>
    </ProItem>
    <ProItem xs="12" sm="6" md="4">
        <ProSelect T="double" Label="Price" Strict="true" Variant="Variant.Outlined" Format="F2">
            <ProSelectItem T="double" Value="4.50"/>
            <ProSelectItem T="double" Value="4.99"/>
            <ProSelectItem T="double" Value="3.60"/>
            <ProSelectItem T="double" Value="21.99"/>
        </ProSelect>
    </ProItem>
    <ProItem xs="12" sm="6" md="4">
        <ProSelect T="string" Label="Pies" Variant="Variant.Filled">
            <ProSelectItem Value="@("Apple Pie")" />
            <ProSelectItem Value="@("Blackberry Pie")" />
            <ProSelectItem Value="@("Rhubarb Pie")" />
            <ProSelectItem Value="@("Lemon Pie")" />
        </ProSelect>
    </ProItem>
</ProGrid>

@code {
    public static string __description__ = "The first two selects are Strict and should not crash in WASM on navigating the list with arrows.";
}
