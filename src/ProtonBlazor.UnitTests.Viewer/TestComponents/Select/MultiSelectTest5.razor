<ProSelect Label="Roles" T="string" SelectedValues="_selectedValues" MultiSelection="true">
    @foreach (var role in _posts)
    {
        <ProSelectItem T="string" Value="@role">@role</ProSelectItem>
    }
</ProSelect>

@code {
    private readonly IReadOnlyCollection<string> _selectedValues = ["Programista", "test"];

    private readonly HashSet<string> _posts = ["Programista", "Programista 2", "test", "Technik", "Tester", "Tester tester"];
}
