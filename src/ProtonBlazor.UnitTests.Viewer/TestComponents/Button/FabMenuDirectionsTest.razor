@using ProtonBlazor

<ProGrid>
    <ProItem xs="12">
        <ProText Typo="Typo.h6">Fixed Anchors (Scroll down to see them fixed to viewport or select one)</ProText>
        <ProSelect T="Origin" Label="Anchor" @bind-Value="_anchor" FitContent>
            @foreach (Origin origin in Enum.GetValues(typeof(Origin)))
            {
                <ProSelectItem Value="@origin">@origin</ProSelectItem>
            }
        </ProSelect>
        <ProFabMenu Fixed="true" Anchor="_anchor" Direction="@GetDirection(_anchor)" Color="Color.Error" StartIcon="@Icons.Material.Filled.Settings">
            <ProFabMenuItem Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Edit" />
            <ProFabMenuItem Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.Delete" />
        </ProFabMenu>
    </ProItem>

    <ProItem xs="12">
        <ProText Typo="Typo.h6">Directions</ProText>
    </ProItem>
    @foreach (Direction direction in Enum.GetValues(typeof(Direction)))
    {
        <ProItem xs="4" Class="d-flex flex-column align-center justify-center pa-16" Style="height: 300px;">
            <ProText Typo="Typo.subtitle1">@direction</ProText>
            <ProFabMenu Direction="@direction" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
                <ProFabMenuItem Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Edit" />
                <ProFabMenuItem Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.Delete" />
                <ProFabMenuItem Color="Color.Info" StartIcon="@Icons.Material.Filled.Share" />
            </ProFabMenu>
        </ProItem>
    }
    
    <ProItem xs="12" Class="mt-16">
        <ProText Typo="Typo.h6">Extended FAB Menu</ProText>
    </ProItem>
    <ProItem xs="12" Class="d-flex justify-space-around pa-16">
        <ProFabMenu Direction="Direction.Top" Label="Extended Top" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
            <ProFabMenuItem Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Edit" />
            <ProFabMenuItem Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.Delete" />
        </ProFabMenu>
        
        <ProFabMenu Direction="Direction.Right" Label="Extended Right" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
            <ProFabMenuItem Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Edit" />
            <ProFabMenuItem Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.Delete" />
        </ProFabMenu>
    </ProItem>

</ProGrid>

@code {
    private Origin _anchor = Origin.BottomRight;

    private Direction GetDirection(Origin origin)
    {
        return origin switch
        {
            Origin.TopLeft or Origin.TopRight or Origin.TopCenter => Direction.Bottom,
            Origin.BottomLeft or Origin.BottomRight or Origin.BottomCenter => Direction.Top,
            Origin.CenterLeft => Direction.Right,
            Origin.CenterRight => Direction.Left,
            Origin.CenterCenter => Direction.End,
            _ => Direction.Top
        };
    }
}
