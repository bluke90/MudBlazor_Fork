<ProRTLProvider RightToLeft=@_rightToLeft>
	<div class="d-flex mb-3">
		<ProButtonGroup Color="Color.Dark" Variant="Variant.Filled">
			<ProTooltip Text="Open 1"><ProButton>1</ProButton></ProTooltip>
			<ProTooltip Text="Open 2"><ProButton>2</ProButton></ProTooltip>
			<ProTooltip Text="Open 3"><ProButton>3</ProButton></ProTooltip>
		</ProButtonGroup>
	</div>

	<div class="d-flex mr-3">
		<ProButtonGroup Color="Color.Dark" Variant="Variant.Filled" Vertical="true" Style="margin-right: 4px">
			<ProTooltip Text="Open 1"><ProButton>1</ProButton></ProTooltip>
			<ProTooltip Text="Open 2"><ProButton>2</ProButton></ProTooltip>
			<ProTooltip Text="Open 3"><ProButton>3</ProButton></ProTooltip>
		</ProButtonGroup>
	</div>
</ProRTLProvider>

<ProSwitch @bind-Value="@_rightToLeft" Label="Toggle Right to Left" Color="Color.Primary" />

@code
{
	private bool _rightToLeft;
	public static string __description__ = "The button group rounded corners and dividers should still work when using tooltips.";
}