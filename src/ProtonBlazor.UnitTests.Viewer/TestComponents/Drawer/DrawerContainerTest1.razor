<ProDrawerContainer>
    @if (_isShown)
    {
        <ProDrawer Open="true" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Always" Anchor="Anchor.Right"></ProDrawer>
    }
</ProDrawerContainer>

<button id="hide-drawer-button" @onclick="@HandleButtonClick">hide</button>

@code {
    private bool _isShown = true;

    private void HandleButtonClick()
    {
        _isShown = false;
    }
}