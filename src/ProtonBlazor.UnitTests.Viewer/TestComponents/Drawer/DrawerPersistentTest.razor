<ProPaper Height="500px" Style="overflow:hidden; position:relative;">
    <ProDrawerContainer Class="pro-width-full">
        <ProDrawer @bind-Open="@_open" Variant="@DrawerVariant.Persistent" Anchor="@Anchor" Height="@DrawerHeight">
            <ProDrawerHeader>
                <ProText Typo="Typo.h6">My App</ProText>
            </ProDrawerHeader>
            <ProNavMenu>
                <ProNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard" IconColor="Color.Error">Dashboard</ProNavLink>
                <ProNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.LocalLibrary" IconColor="Color.Error">Library</ProNavLink>
                <ProNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.People" IconColor="Color.Error">Community</ProNavLink>
            </ProNavMenu>
        </ProDrawer>
        <div class="d-flex justify-center align-center pro-width-full pro-height-full" id="toggle-button-container">
            <ProButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="@ToggleDrawer" id="toggle-drawer-button">Toggle Drawer</ProButton>
        </div>
    </ProDrawerContainer>
</ProPaper>

@code {
    private bool _open = false;
    [Parameter]
    public ProDrawer Drawer { get; set; } = null!;

    [Parameter]
    public Anchor Anchor { get; set; } = Anchor.Top;

    [Parameter]
    public string DrawerHeight { get; set; } = "300px";

    private void ToggleDrawer() => _open = !_open;
}
