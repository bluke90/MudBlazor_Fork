<ProLayout>
    <ProAppBar Elevation="1">
        <ProIconButton id="toggle-drawer-button" Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
    </ProAppBar>
    <ProDrawer @ref="@Drawer" @bind-Open="@_open" Variant="@DrawerVariant.Temporary" Elevation="1">
    </ProDrawer>
    <ProMainContent Class="pt-16 px-16">
        <ProContainer Class="mt-6">
        </ProContainer>
    </ProMainContent>
</ProLayout>

@code{
    private bool _open;

    public ProDrawer Drawer { get; private set; } = null!;
    
    [Parameter]
    public bool InitialOpenState { get; set; }

    protected override void OnInitialized()
    {
        _open = InitialOpenState;
        base.OnInitialized();
    }

    private void ToggleDrawer() => _open = !_open;
}