<ProCheckBox @bind-Value="_labelCheckBox1" Label="Default"></ProCheckBox>
<ProCheckBox @bind-Value="_labelCheckBox2" Label="Primary" Color="Color.Primary"></ProCheckBox>
<ProCheckBox @bind-Value="_labelCheckBox3" Label="Secondary" LabelPlacement="Placement.Start" Color="Color.Secondary"></ProCheckBox>
<ProCheckBox @bind-Value="_labelCheckBox1" Disabled="true" Label="Disabled" LabelPlacement="Placement.Start"></ProCheckBox>

@code {
    private bool _labelCheckBox1  = true;
    private bool _labelCheckBox2 = false;
    private bool _labelCheckBox3 = false;
}