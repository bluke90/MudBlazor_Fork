<ProFileUpload T="IBrowserFile" Disabled="Disabled">
    <CustomContent>
        <ProButton OnClick="@context.OpenFilePickerAsync">
            Upload
        </ProButton>
    </CustomContent>
</ProFileUpload>

@code {
    public static string __description__ = "Tests that file upload respects the disabled state with custom activator content.";

    [Parameter]
    public bool Disabled { get; set; }
}
