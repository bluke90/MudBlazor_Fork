<style>
    .pro-button-root:disabled {
        pointer-events: auto;
    }
</style>

<ProStack Spacing="4">
    <ProPaper Outlined="true" Class="pa-4">
        <ProText>Blank FileUpload Drag False</ProText>
        <ProFileUpload T="IReadOnlyList<IBrowserFile>"
                       AppendMultipleFiles="true" />
    </ProPaper>

    <ProPaper Outlined="true" Class="pa-4">
        <ProText>Blank FileUpload with empty SelectedTemplate</ProText>
        <ProFileUpload T="IReadOnlyList<IBrowserFile>" AppendMultipleFiles="true">
            <SelectedTemplate />
        </ProFileUpload>
    </ProPaper>

    <ProPaper Outlined="true" Class="pa-4">
        <ProText>Blank FileUpload Drag True</ProText>
        <ProFileUpload T="IReadOnlyList<IBrowserFile>"
                       Style="height: 300px;width: 300px;"
                       AppendMultipleFiles="true"
                       DragAndDrop="true" />
    </ProPaper>

    <ProPaper Outlined="true" Class="pa-4">
        <ProText>File Upload with Activator Content</ProText>
        <ProFileUpload T="IReadOnlyList<IBrowserFile>"
                       AppendMultipleFiles="true"
                       DragAndDrop="true"
                       tabindex="-1"
                       @bind-Dragging="@_dragging"
                       @bind-Dragging:after="@ClearDragClass">
            <CustomContent>
                <ProPaper Height="300px"
                          Outlined="true"
                          @onclick="@context.OpenFilePickerAsync"
                          @ondragenter="@SetDragClass"
                          Class="@_dragClass">
                    <ProText Typo="Typo.h6">
                        Drag and drop files here or click
                    </ProText>
                    @foreach (var file in context.GetFilenames())
                    {
                        <ProChip T="string"
                                 Color="Color.Dark"
                                 Text="@file"
                                 tabindex="-1" />
                    }
                    <ProToolBar Gutters="@false"
                                Class="relative d-flex justify-end gap-4 z-11">
                        <ProButton Color="Color.Primary"
                                   OnClick="@context.OpenFilePickerAsync"
                                   Variant="Variant.Filled">
                            Open file picker
                        </ProButton>
                        <ProButton Color="Color.Error"
                                   Disabled="@(!context.GetFilenames().Any())"
                                   OnClick="@context.ClearAsync"
                                   Variant="Variant.Filled">
                            Clear
                        </ProButton>
                    </ProToolBar>
                </ProPaper>
            </CustomContent>
            <SelectedTemplate />
        </ProFileUpload>
    </ProPaper>
</ProStack>

@code {
#nullable enable
    public static string __description__ = "A test for using components inside CustomContent that don't activate.";
    private const string DefaultDragClass = "relative rounded-lg border-2 border-dashed pa-4 mt-4 pro-width-full pro-height-full";
    private string _dragClass = DefaultDragClass;
    private bool _dragging = false;

    private void SetDragClass()
    {
        _dragClass = $"{DefaultDragClass} pro-border-primary";
        _dragging = true;
    }

    private void ClearDragClass()
    {
        if (!_dragging)
        {
            _dragClass = DefaultDragClass;
        }
    }
}
