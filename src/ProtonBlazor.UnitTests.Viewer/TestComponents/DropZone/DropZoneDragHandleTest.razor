@namespace ProtonBlazor.UnitTests.TestComponents.DropZone

<ProDropContainer T="SimpleDropItem" Items="_items" ItemsSelector="@((item,dropzone) => item.Selector == dropzone)" ItemDropped="ItemUpdated">
    <ChildContent>
        <ProDropZone T="SimpleDropItem" Identifier="Zone 1" Class="first-drop-zone" Style="min-height: 100px; border: 1px dashed gray;" />
        <ProDropZone T="SimpleDropItem" Identifier="Zone 2" Class="second-drop-zone" Style="min-height: 100px; border: 1px dashed gray;" />
    </ChildContent>
    <ItemRenderer>
        <div class="drop-item">
            <ProDragHandle T="SimpleDropItem">
                <div class="drag-handle">Handle</div>
            </ProDragHandle>
            <div class="content">@context.Name</div>
        </div>
    </ItemRenderer>
</ProDropContainer>

@code {
    private readonly List<SimpleDropItem> _items = [new() { Name = "Item 1", Selector = "Zone 1" }];

    private void ItemUpdated(ProItemDropInfo<SimpleDropItem> dropInfo)
    {
        if (dropInfo.Item is not null)
        {
            dropInfo.Item.Selector = dropInfo.DropzoneIdentifier;
        }
    }

    public class SimpleDropItem
    {
        public string? Name { get; set; }
        public string? Selector { get; set; }
    }
}
