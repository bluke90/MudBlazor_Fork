<ProPaper Class="pa-4">
    <ProStack Spacing="2">
        <ProButton id="outside_btn" OnClick="OnExpandCollapseClick">@(_expanded ? "Collapse" : "Expand")</ProButton>
        <ProDivider />
        <ProCollapse @bind-Expanded="_expanded">
            This content is collapsible
        </ProCollapse>
    </ProStack>
</ProPaper>
<ProSwitch T="bool" Label="Expanded" @bind-Value="_expanded" Color="Color.Primary" />
@code {
    private bool _expanded = true;

    private void OnExpandCollapseClick() => _expanded = !_expanded;
}
