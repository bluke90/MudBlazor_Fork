<ProPopoverProvider />

<ProRTLProvider RightToLeft="@RightToLeft">
	<ProTooltip Placement="@Placement">
		<ChildContent>
			<ProButton>My Button</ProButton>
		</ChildContent>
		<TooltipContent>
			<div id="my-tooltip-content">
				<p>Some Text</p>
			</div>
		</TooltipContent>
	</ProTooltip>
</ProRTLProvider>

@code {
	[Parameter]
    public Placement Placement { get; set; } = Placement.Bottom;

	[Parameter]
    public bool RightToLeft { get; set; }
}