<ProPopoverProvider />

<ProTooltip Color="@Color" Arrow="@Arrow">
	<ChildContent>
		<ProButton>My Button</ProButton>
	</ChildContent>
	<TooltipContent>
		<div id="my-tooltip-content">
			<p>Some Text</p>
		</div>
	</TooltipContent>
</ProTooltip>

@code {
	[Parameter]
    public Color Color { get; set; } = Color.Default;

	[Parameter]
    public bool Arrow { get; set; }
}