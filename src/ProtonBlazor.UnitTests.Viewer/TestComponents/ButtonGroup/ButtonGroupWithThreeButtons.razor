<ProButtonGroup FullWidth="ButtonGroupFullWidth">
    @if(Button1Displayed)
    {
        <ProButton FullWidth="Button1FullWidth">Button One</ProButton>
    }
    @if(Button2Displayed)
    {
        <ProButton FullWidth="Button2FullWidth">Button Two</ProButton>
    }
    @if(Button3Displayed)
    {
        <ProButton FullWidth="Button3FullWidth">Button Third</ProButton>
    }
</ProButtonGroup>

@code {
    [Parameter]
    public bool ButtonGroupFullWidth { get; set; } = true;

    [Parameter]
    public bool Button1Displayed { get; set; } = true;

    [Parameter]
    public bool Button1FullWidth { get; set; }

    [Parameter]
    public bool Button2Displayed { get; set; } = true;

    [Parameter]
    public bool Button2FullWidth { get; set; }

    [Parameter]
    public bool Button3Displayed { get; set; } = true;

    [Parameter]
    public bool Button3FullWidth { get; set; }
}