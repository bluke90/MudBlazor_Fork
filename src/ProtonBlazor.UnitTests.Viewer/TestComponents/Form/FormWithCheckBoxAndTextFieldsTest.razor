<div style="max-width: 400px;">
    <ProCard>
        <ProCardContent>
            <ProForm>

                <ProTextField T="string" Variant="Variant.Outlined" @bind-Value="@_catName" Label="Cat Name"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Info" />

                <ProTextField T="string" Variant="Variant.Outlined" @bind-Value="@_ownerName" Label="Owner Name"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Info" />


                <ProTextField T="int" Variant="Variant.Outlined" @bind-Value="@_catWeight" Label="Weight"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Info" />

                <ProCheckBox @bind-Value="@_evilCheckBox" Label="Evil"></ProCheckBox>

            </ProForm>
        </ProCardContent>
        <ProCardActions>
            <ProButton Variant="Variant.Filled" Color="Color.Primary"  Class="ml-auto">Buy Cat</ProButton>
        </ProCardActions>
    </ProCard>
</div>
@code {

    public static string __description__ = "Based on error report. Clicking the checkbox should not influence the other form fields.";

    private string? _catName;
    private string? _ownerName;
    private int _catWeight;
    private bool _evilCheckBox  = true;
}
