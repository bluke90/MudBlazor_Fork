<ProForm ReadOnly="ReadOnly" Disabled="Disabled">
    <ProForm ReadOnly="NestedReadOnly" Disabled="NestedDisabled">
        <ProCheckBox T="bool"></ProCheckBox>
    </ProForm>
</ProForm>

@code {
    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public bool NestedReadOnly { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool NestedDisabled { get; set; }
}
