<ProForm Model="@_model" Validation=@("v")>
    <ProTextField @bind-Value="_model.Name" For=@(() => _model.Name)/> @*Should set validation*@
    <ProNumericField T="int" @bind-Value="_model.Age" For="() => _model.Age"/> @*Should override validation*@
    
    <ProForm Model="@_model" Validation=@("v") OverrideFieldValidation="false">
        <ProTextField @bind-Value="_model.Name" For="() => _model.Name"/> @*Should set validation*@
        <ProNumericField @bind-Value="_model.Age" For="() => _model.Age"/> @*Should keep default validation*@
    </ProForm>
    
    <ProForm Model="@_model" Validation=@("v") OverrideFieldValidation="true">
        <ProTextField @bind-Value="_model.Name" Validation=@("a") For="() => _model.Name"/> @*Should override validation*@
        <ProNumericField @bind-Value="_model.Age" Validation=@("b") For="() => _model.Age"/> @*Should override validation*@
    </ProForm>
    
    <ProForm Model="@_model">
        <ProTextField @bind-Value="_model.Name" Validation=@("a") For="() => _model.Name"/> @*Should keep validation*@
        <ProNumericField @bind-Value="_model.Age" Validation=@("b") For="() => _model.Age"/> @*Should keep validation*@
    </ProForm>
</ProForm>

Name: @_model.Name
Age: @_model.Age.ToString()

@code {
    private readonly VM _model = new();

    private class VM
    {
        public string? Name { get; set; }

        public int Age { get; set; }
    }
}