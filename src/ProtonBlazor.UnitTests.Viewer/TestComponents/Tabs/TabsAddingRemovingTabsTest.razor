<ProButton OnClick="AddTab">Add Tab</ProButton>
<ProButton OnClick="RemoveLast">Remove Last</ProButton>

<ProTabs Elevation="1" @ref="Tabs">
    @foreach (var tab in _tabs)
    {
        <ProTabPanel @key="tab" Text="@tab">
            <ProText>@tab</ProText>
        </ProTabPanel>
    }    
</ProTabs>

@code
{
    public static string __description__ = "Adding and removing tabs should work";

    private List<string> _tabs = new List<string>();
    private int i = 0;

    public ProTabs Tabs { get; set; } = null!;

    private async Task AddTab()
    {
        _tabs.Add($"Tab {i++}");
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveLast()
    {
        if(_tabs.Any())
        {
            _tabs.RemoveAt(_tabs.Count - 1);
            await InvokeAsync(StateHasChanged);
        }
    }
}
