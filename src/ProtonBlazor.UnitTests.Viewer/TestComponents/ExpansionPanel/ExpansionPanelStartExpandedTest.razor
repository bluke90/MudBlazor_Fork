        Panel One Content
    </ProExpansionPanel>
    <ProExpansionPanel @bind-Expanded="Panel2Expanded" Class="panel-two" Text="Panel Two">
        Panel Two Content
    </ProExpansionPanel>
    <ProExpansionPanel @bind-Expanded="Panel3Expanded" Class="panel-three" Text="Panel Three">
