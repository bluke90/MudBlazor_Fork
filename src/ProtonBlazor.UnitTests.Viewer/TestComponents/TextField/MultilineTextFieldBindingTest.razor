@*based on a bugreport*@
<ProContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-16 mb-16">

    <ProTextField T="string" @bind-Value="text" Label="First edit here"
                  Variant="Variant.Outlined" Immediate="true"></ProTextField>

    <ProTextField T="string" Lines="2" @bind-Value="text" Label="Then edit here"
                  Variant="Variant.Outlined" Immediate="true"></ProTextField>

    <p>Then edit the first TF again to see how the binding breaks down for the second</p>
</ProContainer>

@code
{
    private string? text;
}