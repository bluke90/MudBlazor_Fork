        <ProTextField T="string" Variant="Variant.Outlined" Label="Shrink Normal" ShrinkLabel="true"></ProTextField>
        <ProTextField T="string" Variant="Variant.Outlined" Label="Normal"></ProTextField>
    </ProStack>
</ProRTLProvider>

