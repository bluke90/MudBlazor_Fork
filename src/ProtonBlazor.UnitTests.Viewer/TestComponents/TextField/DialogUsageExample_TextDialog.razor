<ProDialog>
    <TitleContent>
        <ProText Typo="Typo.h6">
            <ProIcon Icon="@Icons.Material.Filled.Edit" Class="mr-3" />
            Dialog Title
        </ProText>
    </TitleContent>
    <DialogContent>
        <ProExpansionPanels MultiExpansion="true">
            <ProExpansionPanel Text="Panel One">
                <ProTextField T="string" Variant="Variant.Outlined" Label="Editable Field" Disabled="false" Class="mt-3" HelperText="This field is enabled" />
                <ProTextField T="string" Variant="Variant.Outlined" Label="Disabled Field" Disabled="true" Class="mt-3" HelperText="This field is disabled" />
                <ProTextField T="string" Variant="Variant.Outlined" Label="Disabled Field with Character Counter" Disabled="true" Class="mt-3" HelperText="Max 100 characters" MaxLength="100" Counter="100" />
                <ProTextField T="string" Variant="Variant.Outlined" Label="Disabled Field with Auto-Grow" Disabled="true" Class="mt-3" HelperText="Expands with content" MaxLength="100" Counter="100" AutoGrow="true" />
                <ProTextField T="string" Variant="Variant.Outlined" Label="Minimal Disabled Auto-Grow" Disabled="true" Class="mt-3" AutoGrow="true" />
            </ProExpansionPanel>
        </ProExpansionPanels>
    </DialogContent>
    <DialogActions>
        <ProButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Cancel">Close</ProButton>
    </DialogActions>
</ProDialog>

@code {
    [CascadingParameter]
    private IProDialogInstance ProDialog { get; set; } = default!;

    private void Submit() => ProDialog.Close(DialogResult.Ok(true));
    private void Cancel() => ProDialog.Cancel();
}
