@namespace ProtonBlazor.UnitTests.TestComponents.Dialog
@using ProtonBlazor

<ProDialog>
    <DialogContent>
        <ProTextField T="string" @ref="_textField" Label="Test Field" />
    </DialogContent>
    <DialogActions>
        <ProButton OnClick="Close">Close</ProButton>
    </DialogActions>
</ProDialog>

@code {
    private ProTextField<string> _textField = null!;

    [CascadingParameter]
    IMudDialogInstance ProDialog { get; set; } = null!;

    void Close() => ProDialog.Close();
}
