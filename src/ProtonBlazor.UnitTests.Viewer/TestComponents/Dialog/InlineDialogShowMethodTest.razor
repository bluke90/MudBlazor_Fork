<ProButton OnClick="OpenDialogAsync" Class="open-dialog-button">
    Open Dialog
</ProButton>

<ProDialog @ref="_dialog">
    <DialogContent>
        <p>The dialog's content is displayed.</p>
    </DialogContent>
</ProDialog>

@code {
    private ProDialog _dialog = null!;

    private async Task OpenDialogAsync()
    {
        await _dialog.ShowAsync();
    }
}
