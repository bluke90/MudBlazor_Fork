<ProDialog>
    <TitleContent>
     Title: @_textTest
    </TitleContent>
    <DialogContent>
      Body: @_textTest
    </DialogContent>
    <DialogActions>
        <ProButton OnClick="Cancel">Cancel</ProButton>
        <ProButton Color="Color.Primary" OnClick="Submit">OK</ProButton>
    </DialogActions>
</ProDialog>


@code {
    private string? _textTest;

    [CascadingParameter]
    private IProDialogInstance ProDialog { get; set; } = null!;

    private void Submit()
    {
        _textTest = "Test123";
        ProDialog.StateHasChanged();
    }

    private static void Cancel()
    {
    }
}
