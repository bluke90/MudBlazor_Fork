<ProCarousel @bind-SelectedIndex="SelectedIndex" Style="height:200px;" ShowArrows ArrowsPosition="Position.Top" BulletsPosition="Position.Start" ShowBullets AutoCycle="false" AutoCycleTime="TimeSpan.FromMilliseconds(500)" TData="object">
    <ProCarouselItem Class="fake-class-item1" Transition="Transition.Slide">
        <div class="d-flex" style="background-color:#594AE2; height:100%">
            <ProIcon Class="mx-auto my-auto" Icon="@Icons.Custom.Brands.ProtonBlazor" Size="@Size.Large" />
        </div>
    </ProCarouselItem>
    <ProCarouselItem Class="fake-class-item2" Transition="Transition.Slide">
        <div class="d-flex" style="background-color:#FF4081; height:100%">
            <ProIcon Class="mx-auto my-auto" Icon="@Icons.Custom.Brands.ProtonBlazor" Size="@Size.Large" />
        </div>
    </ProCarouselItem>
    <ProCarouselItem Class="fake-class-item3" Transition="Transition.Slide">
        <div class="d-flex" style="background-color:lightgray; height:100%">
            <ProIcon Class="mx-auto my-auto" Icon="@Icons.Custom.Brands.ProtonBlazor" Color="@Color.Primary" Size="@Size.Large" />
        </div>
    </ProCarouselItem>
</ProCarousel>

@code {
    public int SelectedIndex { get; set; }
}