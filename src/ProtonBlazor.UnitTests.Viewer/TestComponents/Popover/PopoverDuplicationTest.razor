<ProPopoverProvider />
<ProPopoverProvider />

<div class="popoverparent">
    <p>Some Text</p>
    <ProPopover Open="_open">
        <ProText>Popover content</ProText>
    </ProPopover>
</div>

@code {
    public static string __description__ = "Duplicate ProPopoverProviders should throw";

    private bool _open;

    public Task Open()
    {
        _open = true;
        return InvokeAsync(StateHasChanged);
    }

    public Task Close()
    {
        _open = false;
        return InvokeAsync(StateHasChanged);
    }
}