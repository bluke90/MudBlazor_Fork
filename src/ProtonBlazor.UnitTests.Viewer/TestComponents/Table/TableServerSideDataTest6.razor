<ProTable ServerData="ServerReload">
    <HeaderContent>
        <ProTh><ProTableSortLabel SortLabel="No." T="int">Nr</ProTableSortLabel></ProTh>
    </HeaderContent>
    <RowTemplate>
        <ProTd DataLabel="Nr">@context</ProTd>
    </RowTemplate>
</ProTable>

@code {
    public static string __description__ = "The table should not crash when the TableData Items are null.";

    /// <summary>
    /// Here we simulate getting the paged, filtered and ordered data from the server
    /// </summary>
    private static Task<TableData<int>> ServerReload(TableState state, CancellationToken token)
    {
        return Task.FromResult(new TableData<int>());
    }
}
