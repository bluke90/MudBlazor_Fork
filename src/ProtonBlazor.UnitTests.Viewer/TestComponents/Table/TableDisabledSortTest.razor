<ProTable Items="@_examples" T="string">
    <HeaderContent>
        <ProTh><ProTableSortLabel SortBy="new Func<string, object>(x=>x)">#</ProTableSortLabel></ProTh>
    </HeaderContent>
    <RowTemplate>
        <ProTd DataLabel="Nr">@context</ProTd>
    </RowTemplate>
</ProTable>

@code {
    private IEnumerable<string> _examples = new List<string>();

    protected override void OnInitialized()
    {
        _examples = new List<string> { "B", "A", "C" };
    }
}