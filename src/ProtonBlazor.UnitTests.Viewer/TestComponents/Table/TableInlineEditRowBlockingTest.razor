<ProTable T="string" Items="_items" @bind-SelectedItem="_selectedItem" IsEditRowSwitchingBlocked="true">
    <HeaderContent>
        <ProTh>#</ProTh>
    </HeaderContent>
    <RowTemplate>
        <ProTd>@context</ProTd>
    </RowTemplate>
    <RowEditingTemplate>
        <ProTd>
            <ProTextField T="string" @bind-Value="@context"></ProTextField>
        </ProTd>
    </RowEditingTemplate>
</ProTable>

@code {
    public static string __description__ = "Inline Edit Table w/ Blocked Row Switching";

    private string? _selectedItem = null;
    private readonly string[] _items = ["A", "B", "C"];
}
