<ProText>SelectedItems { @string.Join(", ", _selectedItems) }</ProText>
<ProTable T="int" Items="_items" @bind-SelectedItems="_selectedItems" MultiSelection="true" SelectOnRowClick="false" OnRowClick="@OnRowClick">
    <RowTemplate>
        <ProTd>@context</ProTd>
    </RowTemplate>
</ProTable>
<ProText>Clicked: @_count</ProText>

@code {
    public static string __description__ = "A row-click should not toggle the checkbox.";

    private int _count;
    private readonly int[] _items = [0, 1, 2];
    private HashSet<int> _selectedItems = [];

    private Task OnRowClick()
    {
        ++_count;
        return Task.CompletedTask;
    }
}
