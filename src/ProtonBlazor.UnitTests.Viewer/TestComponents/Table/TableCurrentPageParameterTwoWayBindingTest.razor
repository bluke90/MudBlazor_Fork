<ProTable Items="_items" @bind-CurrentPage="_currentPage">
    <HeaderContent>
        <ProTh>Item</ProTh>
    </HeaderContent>
    <RowTemplate>
        <ProTd DataLabel="Item">@context</ProTd>
    </RowTemplate>
    <PagerContent>
        <ProTablePager PageSizeOptions="[1]"/>
    </PagerContent>
</ProTable>

@code {
    public static string __description__ = "CurrentPage parameter should be two-way bindable.";
    
    private readonly int[] _items = [1, 2, 3];
    private int _currentPage;
}