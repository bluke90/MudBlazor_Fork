<ProText>SelectedItems { @string.Join(", ", _selectedItems) }</ProText>
<ProTable Items="_items" @bind-SelectedItems="_selectedItems" MultiSelection="true">
    <RowTemplate>
        <ProTd>@context</ProTd>
    </RowTemplate>
</ProTable>

@code {
    public static string __description__ = "A checkbox- or row-click should toggle the checkbox state.";

    private readonly int[] _items = [0, 1, 2];
    private HashSet<int> _selectedItems = [];
}
