<ProTable Items="_items" CanCancelEdit="true">
    <HeaderContent>
        <ProTh>Id</ProTh>
        <ProTh>Value</ProTh>
    </HeaderContent>
    <RowTemplate>
        <ProTd>@context.Id</ProTd>
        <ProTd>@context.Value</ProTd>
    </RowTemplate>
    <RowEditingTemplate>
        <ProTd>
            <ProTextField @bind-Value="@context.Id"></ProTextField>
        </ProTd>
        <ProTd>
            <ProTextField @bind-Value="@context.Value"></ProTextField>
        </ProTd>
    </RowEditingTemplate>
</ProTable>

@code {
    private readonly List<Element> _items =
    [
        new() { Value = "A", Id = "Id1" },
        new() { Value = "B", Id = "Id2" },
        new() { Value = "C", Id = "Id3" }
    ];

    public class Element
    {
        public required string Id { get; set; }

        public required string Value { get; set; }
    }
}