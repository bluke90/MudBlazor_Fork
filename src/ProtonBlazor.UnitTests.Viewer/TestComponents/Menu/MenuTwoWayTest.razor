<ProPopoverProvider />

<ProMenu @bind-Open="@Open" Label="Full Menu Width" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" PopoverClass="menu-popover-class">
    <ProMenuItem Class="test-class">1</ProMenuItem>
    <ProMenuItem Href="https://www.test.com">2</ProMenuItem>
    <ProMenuItem Href="https://www.test.com" Target="_blank">3</ProMenuItem>
    <ProMenuItem AutoClose="false">4 (AutoClose is false)</ProMenuItem>
</ProMenu>

<ProSwitch id="switch" Color="Color.Primary" @bind-Value="Open" Label="Open Menu Switch" />
@code {
    public bool Open { get; private set; }
}