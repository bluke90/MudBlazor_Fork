<ProPaper Width="300px" Elevation="0">
    <ProTreeView T="string" Hover SelectionMode="@SelectionMode.ToggleSelection" Color="Color.Tertiary">
        <ProTreeViewItem Class="item-config" Text="config" @bind-Expanded="_configExpanded" Icon="@Icons.Custom.Uncategorized.Folder" IconExpanded="@Icons.Custom.Uncategorized.FolderOpen">
            <ProTreeViewItem Class="item-launch" Text="launch.json" @bind-Selected="_launchSelected" Icon="@Icons.Custom.FileFormats.FileCode" />
            <ProTreeViewItem Class="item-tasks" Text="tasks.json" @bind-Selected="_tasksSelected" Icon="@Icons.Custom.FileFormats.FileCode" />
        </ProTreeViewItem>
        <ProTreeViewItem Class="item-images" Text="images" @bind-Expanded="_imagesExpanded" Icon="@Icons.Custom.Uncategorized.Folder" IconExpanded="@Icons.Custom.Uncategorized.FolderOpen">
            <ProTreeViewItem Class="item-logo" Text="logo.png" @bind-Selected="_logoSelected" Icon="@Icons.Custom.FileFormats.FileImage" />
        </ProTreeViewItem>
    </ProTreeView>
</ProPaper>

<ProStack Row Justify="Justify.Center" Style="width: 100%" Wrap="Wrap.Wrap">
    <ProSwitch Class="switch-config" @bind-Value="_configExpanded" Color="Color.Tertiary">config</ProSwitch>
    <ProSwitch Class="switch-images" @bind-Value="_imagesExpanded" Color="Color.Tertiary">images</ProSwitch>
    <ProCheckBox Class="checkbox-launch" @bind-Value="_launchSelected" Color="Color.Tertiary">launch.json</ProCheckBox>
    <ProCheckBox Class="checkbox-tasks" @bind-Value="_tasksSelected" Color="Color.Tertiary">tasks.json</ProCheckBox>
    <ProCheckBox Class="checkbox-logo" @bind-Value="_logoSelected" Color="Color.Tertiary">logo.png</ProCheckBox>
</ProStack>

@code {
    private bool _configExpanded;
    private bool _imagesExpanded;
    private bool _launchSelected = true;
    private bool _tasksSelected;
    private bool _logoSelected;
}