@if (FormatFirst)
{
    <ProDateRangePicker DateFormat="yyyy MMMM dd" DateRange="@(DateRange)"/>
}
else
{
    <ProDateRangePicker DateRange="@(DateRange)" DateFormat="yyyy MMMM dd"/>
}

@code {
    [Parameter, EditorRequired]
    public required DateRange DateRange { get; set; }

    [Parameter]
    public bool FormatFirst { get; set; }
}