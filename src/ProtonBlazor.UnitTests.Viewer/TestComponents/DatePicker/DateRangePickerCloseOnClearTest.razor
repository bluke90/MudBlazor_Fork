<ProPopoverProvider/>

<ProDateRangePicker id="picker" @ref="_picker" Label="With action buttons" @bind-DateRange="DateRange">
    <PickerActions>
        <ProButton Class="mr-auto align-self-start" OnClick="@(() => _picker.ClearAsync(CloseOnClear))">Clear</ProButton>
    </PickerActions>
</ProDateRangePicker>

@code {
    private ProDateRangePicker _picker = null!;

    [Parameter]
    public DateRange? DateRange { get; set; }

    [Parameter]
    public bool CloseOnClear { get; set; }
}