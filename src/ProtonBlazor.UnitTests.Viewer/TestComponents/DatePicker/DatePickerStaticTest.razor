<ProPopoverProvider />

<ProDatePicker id="picker" @ref="PickerReference" Label="With action buttons" PickerVariant="PickerVariant.Static" @bind-Date="Date">
    <PickerActions>
        <ProButton Class="mr-auto align-self-start" OnClick="@(() => PickerReference.ClearAsync())">Clear</ProButton>
        <ProButton OnClick="@(() => PickerReference.CloseAsync(false))">Cancel</ProButton>
        <ProButton Color="Color.Primary" OnClick="@(() => PickerReference.CloseAsync())">OK</ProButton>
    </PickerActions>
</ProDatePicker>

@code {
    [Parameter]
    public DateTime? Date { get; set; } = DateTime.Today.Subtract(TimeSpan.FromDays(60));

    public ProDatePicker PickerReference { get; set; } = null!;
}