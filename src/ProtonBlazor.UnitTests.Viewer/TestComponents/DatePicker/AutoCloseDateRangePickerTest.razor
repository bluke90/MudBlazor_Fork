<ProPopoverProvider />

<ProDateRangePicker id="picker" @ref="_picker" Label="With action buttons" @bind-DateRange="DateRange" AutoClose="@AutoClose">
    <PickerActions>
        <ProButton Class="mr-auto align-self-start" OnClick="@(() => _picker.ClearAsync())">Clear</ProButton>
        <ProButton OnClick="@(() => _picker.CloseAsync(false))">Cancel</ProButton>
        <ProButton Color="Color.Primary" OnClick="@(() => _picker.CloseAsync())">OK</ProButton>
    </PickerActions>
</ProDateRangePicker>

@code {
    private ProDateRangePicker _picker = null!;

    [Parameter]
    public DateRange? DateRange { get; set; }

    [Parameter]
    public bool AutoClose { get; set; }
}