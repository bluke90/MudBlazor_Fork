<ProList T="string" Dense="Dense">
    <ProListSubheader>
        Drinks
    </ProListSubheader>
    <ProListItem Text="Sparkling Water" />
    <ProListItem Text="Teas" Expanded="true">
        <NestedList>
            <ProListItem Text="Earl Grey" />
            <ProListItem Text="Matcha" />
            <ProListItem Text="Pu'er" />
        </NestedList>
    </ProListItem>
    <ProListItem Text="Coffees" Dense="InnerListDense">
        <NestedList>
            <ProListItem Text="Irish Coffee" />
            <ProListItem Text="Double Espresso" />
            <ProListItem Text="Cafe Latte" />
        </NestedList>
    </ProListItem>
</ProList>

@code {
    public static string __description__ = "The child lists are dense when the parent list is dense.";

    [Parameter] 
    public bool Dense { get; set; }

    [Parameter] 
    public bool? InnerListDense { get; set; }
}