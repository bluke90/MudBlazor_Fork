<ProVirtualize Items="_list" Enabled="true">
    <div class="d-flex pro-width-full">
        @foreach (var s in _list)
        {
            <ProText>@s</ProText>
        }
    </div>
</ProVirtualize>

@code {
    private readonly List<string> _list = [];

    protected override void OnInitialized()
    {
        _list.Add("a");
        base.OnInitialized();
    }
}
