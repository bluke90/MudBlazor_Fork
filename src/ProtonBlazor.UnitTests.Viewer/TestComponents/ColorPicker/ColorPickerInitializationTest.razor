@using ProtonBlazor.Utilities

<div data-testid="broken">
    <ProColorPicker PickerVariant="PickerVariant.Static" @bind-Value="_broken" />
</div>

<div data-testid="alpha">
    <ProColorPicker PickerVariant="PickerVariant.Static" @bind-Value="_alpha" />
</div>

<div data-testid="lightness">
    <ProColorPicker PickerVariant="PickerVariant.Static" @bind-Value="_lightness" />
</div>

<div data-testid="pseudo">
    <ProColorPicker PickerVariant="PickerVariant.Static" @bind-Value="_pseudo" />
</div>

<div data-testid="async">
    <ProColorPicker PickerVariant="PickerVariant.Static" @bind-Value="_async" />
</div>

@code {
    private const string __description__ = "Regression coverage for https://github.com/ProtonBlazor/ProtonBlazor/issues/13037 after the null-value startup path introduced by https://github.com/ProtonBlazor/ProtonBlazor/pull/12567 became reachable.";
    private ProColor _broken = "#00000088";
    private ProColor _alpha = "#00000188";
    private ProColor _lightness = "#ff0000ff";
    private ProColor _pseudo = "#ff000088";
    private ProColor _async = "#ff000088";

    protected override async Task OnInitializedAsync()
    {
        _pseudo = new ProColor("#0f0f");
        await Task.Yield();
        _async = new ProColor("#00ff");
    }
}
