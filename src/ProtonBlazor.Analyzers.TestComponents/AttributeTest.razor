@*bind- case2*@
<ProChip T="string" @bind="@bindx" Text="Href set" @bind:after="Test" />

@*valid bind*@
<ProTextField @bind-Value="@bindx" @bind-Value:after="Test" Label="Standard" Variant="Variant.Text"></ProTextField>

