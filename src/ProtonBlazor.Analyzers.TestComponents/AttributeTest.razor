@for (int i = 0; i < 5; i++)
{
    <ProToggleGroup T="string" Dense="true"  />
}

@*bind-RequiredError will create RequiredErrorChanged event which is invalid*@
<ProCheckBox Value="@bindx" @bind-RequiredError=@bindx />

@*bind-Value will mean a TypeInference class in source generator*@
